{
  "$schema": "https://raw.githubusercontent.com/guanghechen/config/kit/schema/preset.schema.json",
  "version": 1,
  "profiles": {
    "auth": {
      "envFile": "../.env.local",
      "envs": {},
      "opts": {
        "force": true
      }
    },
    "start": {
      "envFile": "../.env.local",
      "envs": {},
      "opts": {
        "port": 4747
      },
      "defaultVariant": "default",
      "variants": {
        "default": {},
        "dev": {
          "opts": {
            "port": 4848
          }
        },
        "dev-details": {
          "opts": {
            "devmode": true,
            "port": 4848
          }
        }
      }
    }
  }
}
