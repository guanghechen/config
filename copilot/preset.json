{
  "$schema": "https://cdn.jsdelivr.net/npm/@guanghechen/commander@latest/lib/schema/preset.schema.json",
  "version": 1,
  "defaults": { "profile": "start" },
  "profiles": {
    "start": {
      "envFile": "../.env.local",
      "envs": {},
      "opts": {
        "port": 4747
      },
      "defaultVariant": "default",
      "variants": {
        "default": {},
        "dev": {
          "opts": {
            "port": 4848
          }
        },
        "dev-details": {
          "opts": {
            "devmode": true,
            "port": 4848
          }
        }
      }
    }
  }
}
