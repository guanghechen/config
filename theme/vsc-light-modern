# vsc-light-modern

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color237        default
color listnormal_unread   color29      default
color listfocus           color16        color252
color listfocus_unread    color29      color252

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color29       color252
color info                color18       color252
color hint-key            color168       color252          bold
color hint-keys-delimiter color243        color252
color hint-separator      default                           color252
color hint-description    default                           color252

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color103        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color18       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color30       default bold

# URLs
highlight article "https?://[^ ]+"                     color18       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color30       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color103        default
