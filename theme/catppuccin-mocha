# catppuccin-mocha

# =============================================================================
# Newsboat Color Theme (Catppuccin)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color146      default
# Preserve Latte's ink foreground; dark flavors need bright text after ANSI 256 quantization.
color listnormal_unread   color189 default bold
color listfocus           color189 color59
color listfocus_unread    color189 color59 bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color183        color16     bold
color info                color111        color16
color hint-key            color183        color16     bold
color hint-keys-delimiter color146       color16
color hint-separator      default                             color16
color hint-description    default                             color16

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color146       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color111        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color183        default bold

# URLs
highlight article "https?://[^ ]+"                     color111        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color183        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color146       default
