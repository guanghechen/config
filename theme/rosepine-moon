# rosepine-moon

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color189        default
color listnormal_unread   color67      default
color listfocus           color189        color59
color listfocus_unread    color67      color59

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color67       color59
color info                color152       color59
color hint-key            color204       color59          bold
color hint-keys-delimiter color60        color59
color hint-separator      default                           color59
color hint-description    default                           color59

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color60        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color152       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color174       default bold

# URLs
highlight article "https?://[^ ]+"                     color152       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color174       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color60        default
