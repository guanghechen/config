# onehalf-dark

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color188        default
color listnormal_unread   color115      default
color listfocus           color189        color59
color listfocus_unread    color115      color59

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color115       color59
color info                color75       color59
color hint-key            color174       color59          bold
color hint-keys-delimiter color146        color59
color hint-separator      default                           color59
color hint-description    default                           color59

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color145        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color75       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color73       default bold

# URLs
highlight article "https?://[^ ]+"                     color75       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color73       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color145        default
