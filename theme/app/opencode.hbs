{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "{{vsc?.textLink_foreground || unified.blue}}",
    "secondary": "{{unified.purple}}",
    "accent": "{{unified.pink}}",
    "text": "{{catppuccin?.text || unified.fg0}}",
    "textMuted": "{{catppuccin?.overlay1 || unified.fg4}}",
    "background": "{{unified.bg0}}",

    "error": "{{unified.red}}",
    "warning": "{{unified.yellow}}",
    "success": "{{unified.green}}",
    "info": "{{unified.aqua}}",

    "backgroundPanel": "{{catppuccin?.mantle || unified.bg1}}",
    "backgroundElement": "{{catppuccin?.surface0 || unified.bg2}}",
    "border": "{{catppuccin?.surface0 || unified.bg3}}",
    "borderActive": "{{unified.pink}}",
    "borderSubtle": "{{catppuccin?.surface0 || unified.bg2}}",

    "diffAdded": "{{vsc?.editorGutter_addedBackground || unified.green}}",
    "diffRemoved": "{{vsc?.editorGutter_deletedBackground || unified.red}}",
    "diffContext": "{{unified.fg4}}",
    "diffHunkHeader": "{{unified.purple}}",
    "diffHighlightAdded": "{{unified.brightGreen}}",
    "diffHighlightRemoved": "{{unified.brightRed}}",
    "diffAddedBg": "{{vsc?.diffEditor_insertedTextBackground || unified.bg2}}",
    "diffRemovedBg": "{{vsc?.diffEditor_removedTextBackground || unified.bg2}}",

    "markdownText": "{{catppuccin?.text || unified.fg1}}",
    "markdownHeading": "{{unified.orange}}",
    "markdownLink": "{{vsc?.textLink_foreground || unified.blue}}",
    "markdownCode": "{{unified.aqua}}",
    "markdownBlockQuote": "{{unified.fg4}}",
    "markdownEmph": "{{unified.yellow}}",
    "markdownStrong": "{{unified.orange}}",

    "syntaxComment": "{{unified.grey}}",
    "syntaxKeyword": "{{unified.purple}}",
    "syntaxFunction": "{{vsc?.tokenFunctionDeclarations || unified.orange}}",
    "syntaxVariable": "{{catppuccin?.text || unified.fg1}}",
    "syntaxString": "{{unified.green}}",
    "syntaxNumber": "{{unified.aqua}}",
    "syntaxType": "{{unified.yellow}}",
    "syntaxOperator": "{{unified.pink}}",
    "syntaxPunctuation": "{{unified.fg3}}"
  }
}
