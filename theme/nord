# nord

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color189        default
color listnormal_unread   color144      default
color listfocus           color231        color59
color listfocus_unread    color144      color59

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color144       color59
color info                color109       color59
color hint-key            color217       color59          bold
color hint-keys-delimiter color188        color59
color hint-separator      default                           color59
color hint-description    default                           color59

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color146        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color109       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color110       default bold

# URLs
highlight article "https?://[^ ]+"                     color109       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color110       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color146        default
