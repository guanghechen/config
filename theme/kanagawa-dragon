# kanagawa-dragon

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color180        default
color listnormal_unread   color108      default
color listfocus           color188        color59
color listfocus_unread    color108      color59

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color108       color59
color info                color110       color59
color hint-key            color139       color59          bold
color hint-keys-delimiter color144        color59
color hint-separator      default                           color59
color hint-description    default                           color59

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color102        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color110       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color109       default bold

# URLs
highlight article "https?://[^ ]+"                     color110       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color109       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color102        default
