# kanagawa-dragon

# =============================================================================
# Newsboat Color Theme (Kanagawa)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color145      default
# Keep the terminal foreground for Lotus; dark variants need bright ANSI 256 text.
color listnormal_unread   color188 default bold
# Use a grayscale slot for Dragon; the color cube rounds its selection too bright.
color listfocus           color188 color237
color listfocus_unread    color188 color237 bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color139        default bold
color info                color109        default
color hint-key            color139        default bold
color hint-keys-delimiter color145       default
color hint-separator      default                             default
color hint-description    default                             default

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color145       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color109        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color139        default bold

# URLs
highlight article "https?://[^ ]+"                     color109        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color139        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color145       default
