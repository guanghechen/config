# onehalf-light

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color60        default
color listnormal_unread   color115      default
color listfocus           color102        color252
color listfocus_unread    color115      color252

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color115       color252
color info                color69       color252
color hint-key            color204       color252          bold
color hint-keys-delimiter color59        color252
color hint-separator      default                           color252
color hint-description    default                           color252

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color59        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color69       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color32       default bold

# URLs
highlight article "https?://[^ ]+"                     color69       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color32       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color59        default
