# tokyonight-day

# =============================================================================
# Newsboat Color Theme (Tokyo Night)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color59      default
# Preserve Day's ink foreground; dark variants need bright ANSI 256 text.
color listnormal_unread   default default bold
# Use a grayscale slot for dark selections; color-cube rounding makes them too bright.
color listfocus           default color188
color listfocus_unread    default color188 bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
# Preserve Day's background instead of quantizing it to a darker surface.
color title               color60        default bold
color info                color24        default
color hint-key            color60        default bold
color hint-keys-delimiter color59       default
color hint-separator      default                             default
color hint-description    default                             default

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color59       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color24        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color60        default bold

# URLs
highlight article "https?://[^ ]+"                     color24        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color60        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color59       default
