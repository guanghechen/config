# catppuccin-latte

# =============================================================================
# Newsboat Color Theme (Catppuccin)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color59      default
# Preserve Latte's ink foreground; dark flavors need bright text after ANSI 256 quantization.
color listnormal_unread   default default bold
color listfocus           default color188
color listfocus_unread    default color188 bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color55        color189     bold
color info                color25        color189
color hint-key            color55        color189     bold
color hint-keys-delimiter color59       color189
color hint-separator      default                             color189
color hint-description    default                             color189

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color59       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color25        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color55        default bold

# URLs
highlight article "https?://[^ ]+"                     color25        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color55        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color59       default
