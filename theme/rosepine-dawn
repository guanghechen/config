# rosepine-dawn

# =============================================================================
# Newsboat Color Theme (Rosé Pine)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color59      default
color listnormal_unread   color17        default                           bold
color listfocus           color17        color188
color listfocus_unread    color17         color188 bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color95        color231     bold
color info                color23        color231
color hint-key            color60        color231     bold
color hint-keys-delimiter color59       color231
color hint-separator      default                             color231
color hint-description    default                             color231

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color59       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color23        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color95        default bold

# URLs
highlight article "https?://[^ ]+"                     color23        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color95        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color59       default
