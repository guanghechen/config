# tokyonight-moon

# =============================================================================
# Newsboat Color Theme (Tokyo Night)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color146      default
# Preserve Day's ink foreground; dark variants need bright ANSI 256 text.
color listnormal_unread   color189 default bold
# Use a grayscale slot for dark selections; color-cube rounding makes them too bright.
color listfocus           color189 color237
color listfocus_unread    color189 color237 bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color141        default bold
color info                color111        default
color hint-key            color141        default bold
color hint-keys-delimiter color146       default
color hint-separator      default                             default
color hint-description    default                             default

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color146       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color111        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color141        default bold

# URLs
highlight article "https?://[^ ]+"                     color111        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color141        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color146       default
