# Window/split management
# swap_split is not available in Ghostty, so leave these unbound
# keybind = cmd+ctrl+shift+left=swap_split:left
# keybind = cmd+ctrl+shift+down=swap_split:down
# keybind = cmd+ctrl+shift+up=swap_split:up
# keybind = cmd+ctrl+shift+right=swap_split:right
keybind = cmd+ctrl+left=resize_split:left,10
keybind = cmd+ctrl+down=resize_split:down,10
keybind = cmd+ctrl+up=resize_split:up,10
keybind = cmd+ctrl+right=resize_split:right,10
keybind = cmd+ctrl+shift+j=new_split:down
keybind = cmd+ctrl+shift+l=new_split:right
keybind = cmd+ctrl+h=goto_split:left
keybind = cmd+ctrl+j=goto_split:bottom
keybind = cmd+ctrl+k=goto_split:top
