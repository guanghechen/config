{
  "name": "csv-parser",
  "split": "/\\n/",
  "transformers": [
    {
      "id": "filter-empty",
      "type": "filter",
      "function": "(element, index, elements) => element.trim().length > 0"
    },
    {
      "id": "map-csv",
      "type": "map",
      "function": "(element, index, elements) => element.split(',').map(field => field.trim())"
    }
  ],
  "uuidFunction": "(item, index) => 'csv-row-' + index",
  "parentUuidFunction": "() => null"
}
