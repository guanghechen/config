{
  "name": "json-lines",
  "split": "/\\n/",
  "transformers": [
    {
      "id": "filter-json",
      "type": "filter",
      "function": "(element, index, elements) => element.trim().length > 0"
    },
    {
      "id": "map-parse",
      "type": "map",
      "function": "(element, index, elements) => { try { return JSON.parse(element.trim()); } catch { return null; } }"
    },
    {
      "id": "filter-valid",
      "type": "filter",
      "function": "(element, index, elements) => element !== null"
    }
  ],
  "uuidFunction": "(item, index) => 'json-' + index",
  "parentUuidFunction": "() => null"
}
