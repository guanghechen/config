{
  "name": "claude-jsonl",
  "desc": "(element, index) => `JSON list item ${index + 1}: ${element.type || 'unknown'}`",
  "split": "text => text.trim().split(/\\n/g)",
  "uuid": "(item, index) => item.uuid || String(index)",
  "parents": "(item, index, items) => item.parentUuid",
  "parents_virtual": "(item, index, items) => items[index-1]?.uuid && items[index-1].uuid !== item.parentUuid ? items[index-1].uuid : null",
  "title": "item => `${item.type || 'unknown'}`",
  "chainPaths": [
    ".message.content.0.type",
    ".message.content.0.id",
    ".message.content.0.name",
    ".message.content.0.tool_use_id",
    ".isSidechain"
  ],
  "steps": [
    {
      "type": "map",
      "code": "line => JSON.parse(line)",
      "skip": false
    }
  ]
}
