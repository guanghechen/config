{
  "name": "copilot-api",
  "split": "text => text.split(/\\n/g)",
  "uuid": "(_, index) => `${index}`",
  "parents": "() => []",
  "title": "item => ''",
  "steps": [
    {
      "type": "filter",
      "code": "line => /(payload|event): \\{/.test(line)",
      "skip": false
    },
    {
      "type": "map",
      "code": "line => line.replace(/^[\\s\\S]*(payload|event): \\{/, '{')",
      "skip": false
    },
    {
      "type": "map",
      "code": "line => JSON.parse(line)",
      "skip": false
    }
  ]
}
