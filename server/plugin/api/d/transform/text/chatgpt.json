{
  "name": "chatgpt",
  "split": "text => text.split(/\\n/g)",
  "uuid": "(_, index) => `${index}`",
  "parents": "() => []",
  "chainPaths": [],
  "steps": [
    {
      "type": "filter",
      "code": "line => /^data: /.test(line)",
      "skip": false
    },
    {
      "type": "filter",
      "code": "line => line !== 'data: [DONE]'",
      "skip": false
    },
    {
      "type": "map",
      "code": "line => line.slice(6)",
      "skip": false
    },
    {
      "type": "map",
      "code": "line => JSON.parse(line)",
      "skip": false
    }
  ]
}
