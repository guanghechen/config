{
  "name": "claude",
  "desc": "item => `${item.role || 'assistant'}: ${(item.content || '').slice(0, 50)}...`",
  "split": "text => text.trim().split(/\\n/g)",
  "uuid": "(item, index) => item.uuid || String(index)",
  "parents": "item => item.parentUuid",
  "title": "item => `${item.type || 'unknown'}`",
  "chainPaths": [
    ".message.content.0.name",
    ".message.content.0.type",
    ".message.content.0.id",
    ".message.content.0.tool_use_id",
    ".isSidechain"
  ],
  "steps": [
    {
      "type": "map",
      "code": "line => JSON.parse(line)",
      "skip": false
    }
  ]
}
