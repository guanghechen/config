{
  "name": "eventstream",
  "desc": "(element, index) => `Event stream data chunk ${index + 1}`",
  "split": "text => text.split(/\\n/g)",
  "uuid": "(_, index) => `${index}`",
  "parents": "() => []",
  "title": "item => ''",
  "steps": [
    {
      "type": "filter",
      "code": "line => /^data: /.test(line)",
      "skip": false
    },
    {
      "type": "filter",
      "code": "line => line !== 'data: [DONE]'",
      "skip": false
    },
    {
      "type": "map",
      "code": "line => line.slice(6)",
      "skip": false
    },
    {
      "type": "map",
      "code": "line => JSON.parse(line)",
      "skip": false
    }
  ]
}
