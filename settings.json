{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 20,
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "DO_NOT_TRACK": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)"
    ],
    "deny": [
      "Read(//**/*.http_request)",
      "Read(//**/*.http_response)",
      "Read(//**/.env*)",
      "Read(//**/.git-credentials)",
      "Read(//**/.ssh/**)",
      "Read(//**/local/env.*)",
      "Read(//**/local/config.fish)",
      "Read(//**/local/config.ps1)",
      "Read(//**/.credentials/**)",
      "Edit(//**/*.http_request)",
      "Edit(//**/*.http_response)",
      "Edit(//**/.env*)",
      "Edit(//**/.git-credentials)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/local/env.*)",
      "Edit(//**/local/config.fish)",
      "Edit(//**/local/config.ps1)",
      "Edit(//**/.credentials/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/pre-bash-sensitive.mjs\" || exit 2",
            "timeout": 5,
            "statusMessage": "Checking sensitive path usage"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/pre-bash-git.mjs\" || exit 2",
            "timeout": 5,
            "statusMessage": "Checking git command policy"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/notify.mjs\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/notify.mjs\"",
            "timeout": 5
          }
        ],
        "matcher": "^(?!idle_prompt$).*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ],
        "matcher": "^idle_prompt$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/notify.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ],
        "matcher": "^(startup|resume)$"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_CONFIG_DIR/script/hook/progress.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"$CLAUDE_CONFIG_DIR/script/statusline.mjs\"",
    "padding": 0,
    "refreshInterval": 10
  },
  "skillOverrides": {
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only"
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "includeGitInstructions": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim"
}
