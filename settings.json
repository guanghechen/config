{
  "tools": {
    "enableHooks": true,
    "autoAccept": true
  },
  "useSmartEdit": true,
  "useWriteTodos": true,
  "context": {
    "fileName": [
      "GEMINI.md",
      "AGENTS.md"
    ],
    "fileFiltering": {
      "disableFuzzySearch": false,
      "enableRecursiveFileSearch": true,
      "respectGitIgnore": true,
      "respectGeminiIgnore": true
    }
  },
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "read_file|write_file|edit_file|file_read|file_write|file_edit",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=module -e \"import{pathToFileURL}from'url';import{homedir}from'os';import{join}from'path';import(pathToFileURL(join(homedir(),'.gemini/script/hook/before-tool-file.mjs')))\"",
            "name": "sensitive-file-check",
            "description": "Check for sensitive file access",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "shell|run_shell_command|execute_command|bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --input-type=module -e \"import{pathToFileURL}from'url';import{homedir}from'os';import{join}from'path';import(pathToFileURL(join(homedir(),'.gemini/script/hook/before-tool-shell.mjs')))\"",
            "name": "git-command-check",
            "description": "Intercept git push/commit commands",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "general": {
    "debugKeystrokeLogging": false,
    "disableAutoUpdate": true,
    "disableUpdateNag": false,
    "enablePromptCompletion": true,
    "preferredEditor": "nvim",
    "previewFeatures": true,
    "retryFetchErrors": true,
    "vimMode": true,
    "checkpointing": {
      "enabled": true
    },
    "sessionRetention": {
      "enabled": true,
      "maxAge": "14d",
      "minRetention": "3d"
    }
  },
  "output": {
    "format": "text"
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "security": {
    "blockGitExtensions": false,
    "disableYoloMode": false,
    "enablePermanentToolApproval": false,
    "auth": {
      "selectedType": "gemini-api-key"
    },
    "folderTrust": {
      "enabled": true
    }
  },
  "telemetry": {
    "enabled": false
  },
  "ui": {
    "hideBanner": true,
    "hideContextSummary": false,
    "hideFooter": false,
    "hideTips": false,
    "hideWindowTitle": true,
    "incrementalRendering": false,
    "showCitations": true,
    "showLineNumbers": true,
    "showMemoryUsage": false,
    "showModelInfoInChat": true,
    "showStatusInTitle": true,
    "theme": "$GEMINI_CONFIG_DIR/local/theme.json",
    "useAlternateBuffer": false,
    "useFullWidth": true,
    "footer": {
      "hideContextPercentage": false,
      "hideCWD": false,
      "hideModelInfo": false,
      "hideSandboxStatus": false
    }
  }
}