{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 20,
  "autoCompactWindow": 936000,
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git revert *)"
    ],
    "deny": [
      "Read(//**/*.http_request)",
      "Read(//**/*.http_response)",
      "Read(//**/.env*)",
      "Read(//**/.git-credentials)",
      "Read(//**/.ssh/**)",
      "Read(//**/local/env.*)",
      "Read(//**/local/config.fish)",
      "Read(//**/local/config.ps1)",
      "Read(//**/.credentials/**)",
      "Edit(//**/*.http_request)",
      "Edit(//**/*.http_response)",
      "Edit(//**/.env*)",
      "Edit(//**/.git-credentials)",
      "Edit(//**/.ssh/**)",
      "Edit(//**/local/env.*)",
      "Edit(//**/local/config.fish)",
      "Edit(//**/local/config.ps1)",
      "Edit(//**/.credentials/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/pre-tool-use.mjs').href)\"",
            "timeout": 5,
            "statusMessage": "Checking sensitive file access"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/pre-bash-sensitive.mjs').href)\"",
            "timeout": 5,
            "statusMessage": "Checking sensitive path usage"
          },
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/pre-bash-git.mjs').href)\"",
            "timeout": 5,
            "statusMessage": "Checking git command policy"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/notify.mjs').href)\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/notify.mjs').href)\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/notify.mjs').href)\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/hook/notify.mjs').href)\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node -e \"import url from'url';import(url.pathToFileURL(process.env.XDG_CONFIG_HOME+'/claude/script/statusline.mjs').href)\"",
    "padding": 0,
    "refreshInterval": 2000
  },
  "skillOverrides": {
    "claude-api": "user-invocable-only",
    "dataviz": "user-invocable-only"
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "includeGitInstructions": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim"
}
