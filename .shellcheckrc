# SC1090: Can't follow non-constant source (dynamic paths)
# SC1091: Not following sourced file (file not found or not readable)
# Disabled because dynamic sourcing is intentional for:
# - Platform-specific config: $BASH_CONFIG_DIR/platform/$GHC_ENV_PLATFORM/bashrc.bash
# - Loop-based loading: functions/*.bash, completions/*.bash
disable=SC1090,SC1091
