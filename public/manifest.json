{
  "manifest_version": 3,
  "name": "tsuki",
  "description": "tsuki plugin",
  "version": "0.0.20250330",
  "action": {
    "default_popup": "index.html",
    "default_title": "tsuki",
    "default_icon": {
      "16": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "permissions": ["activeTab", "tabs"],
  "background": {
    "service_worker": "inject/server.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*"],
      "js": ["inject/localhost-yoz.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://search.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": ["inject/bilibili.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": ["inject/reddit.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["http://localhost/*", "https://localhost/*"]
}
