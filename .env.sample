# Copy this template to .env.local for machine-local credentials and configuration.
# .env.local and .env are local files and must remain ignored by Git.
# Precedence: process environment > .env.local > .env. Restart after changes.

# Authentication: generate two independent values with `openssl rand -base64 32`.
# Required for login and authenticated API access; never commit actual credentials.
YOZ_AUTH_TOKEN=
YOZ_JWT_SECRET=

# Server and build output. The server binds to localhost.
YOZ_SERVER_PORT=7071
LOG_LEVEL=info
OUT_DIR=dist

# Filesystem access: JSON array of existing directories on the server.
# Use absolute paths; ~ and ~/ are expanded by the server.
# [] denies all user-file access. Replace it with your authorized directories.
# Example: YOZ_ALLOWED_ROOTS='["/home/user/projects"]'
YOZ_ALLOWED_ROOTS='[]'

# Initial browser workspace entries, each inside an allowed root.
# [] supplies no initial entries; omitting this variable uses the allowed roots.
# The browser saves its own list; changing defaults does not replace that list.
# Example: YOZ_DEFAULT_WORKSPACE_ROOTS='["/home/user/projects/example/docs"]'
YOZ_DEFAULT_WORKSPACE_ROOTS='[]'

# YOZ_WORKSPACE_<TAG> is deprecated. Configure both root lists above instead.
# An explicit YOZ_ALLOWED_ROOTS always overrides legacy access grants.
