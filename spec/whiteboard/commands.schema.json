{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Yoz whiteboard command batch",
  "type": "object",
  "required": ["kind", "schemaVersion", "documentId", "commands"],
  "properties": {
    "kind": {
      "const": "yoz.whiteboard.commands"
    },
    "schemaVersion": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "maxLength": 2000000,
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["op", "title"],
            "properties": {
              "op": {
                "const": "set-title"
              },
              "title": {
                "type": "string",
                "maxLength": 2000000
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "elements"],
            "properties": {
              "op": {
                "const": "add"
              },
              "elements": {
                "type": "array",
                "items": {
                  "$ref": "document.schema.json#/$defs/element"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "id", "patch"],
            "properties": {
              "op": {
                "const": "update"
              },
              "id": {
                "type": "string",
                "maxLength": 2000000,
                "minLength": 1
              },
              "patch": {
                "type": "object",
                "not": {
                  "anyOf": [
                    {
                      "required": ["id"]
                    },
                    {
                      "required": ["type"]
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids"],
            "properties": {
              "op": {
                "const": "remove"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 2000000,
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids", "delta"],
            "properties": {
              "op": {
                "const": "move"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 2000000,
                  "minLength": 1
                }
              },
              "delta": {
                "type": "object",
                "required": ["x", "y"],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -10000000,
                    "maximum": 10000000
                  }
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids", "groupId"],
            "properties": {
              "op": {
                "const": "group"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 2000000,
                  "minLength": 1
                }
              },
              "groupId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids"],
            "properties": {
              "op": {
                "const": "ungroup"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 2000000,
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids", "axis", "mode"],
            "properties": {
              "op": {
                "const": "arrange"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 2000000,
                  "minLength": 1
                }
              },
              "axis": {
                "enum": ["x", "y"]
              },
              "mode": {
                "enum": ["start", "center", "end", "distribute"]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids", "order"],
            "properties": {
              "op": {
                "const": "reorder"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "maxLength": 2000000,
                  "minLength": 1
                }
              },
              "order": {
                "enum": ["back", "backward", "forward", "front"]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids", "degrees"],
            "properties": {
              "op": {
                "const": "rotate"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000000
                }
              },
              "degrees": {
                "type": "number",
                "minimum": -10000000,
                "maximum": 10000000
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids", "axis"],
            "properties": {
              "op": {
                "const": "flip"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000000
                }
              },
              "axis": {
                "enum": ["x", "y"]
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "ids"],
            "properties": {
              "op": {
                "const": "set-flags"
              },
              "ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000000
                }
              },
              "locked": {
                "type": "boolean"
              },
              "hidden": {
                "type": "boolean"
              }
            },
            "anyOf": [
              {
                "required": ["locked"]
              },
              {
                "required": ["hidden"]
              }
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "regions"],
            "properties": {
              "op": {
                "const": "set-regions"
              },
              "regions": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "$ref": "document.schema.json#/$defs/region"
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["op", "steps"],
            "properties": {
              "op": {
                "const": "set-presentation"
              },
              "steps": {
                "type": "array",
                "maxItems": 5000,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
