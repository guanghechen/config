{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "outDir": "dist-test",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "src/app/shared/repository-discovery.ts",
    "src/comparison/model.ts",
    "src/comparison/reference-label.ts",
    "src/comparison/session.ts",
