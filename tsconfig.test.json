    "src/git/**/*.ts",
    "src/history/commit-change-cache.ts",
    "src/history/commit-order.ts",
    "src/history/commit-graph.ts",
    "src/history/commit-history-session.ts",
    "src/history/commit-mark-session.ts",
    "src/history/model.ts",
    "src/platform/extension-ids.ts",
    "src/view/file-change/decoration.ts",
    "src/view/file-change/tree.ts",
    "src/view/history/graph-presentation.ts",
    "src/view/history/subject.ts",
    "src/view/history/tree.ts",
    "test/**/*.ts"
