{
  "$schema": "https://raw.githubusercontent.com/guanghechen/config/kit/stt/schema/config.schema.json",
  "defaultModel": "qwen3-asr-0.6b",
  "language": "zh",
  "device": "default",
  "maxDuration": 300,
  "timeout": 600,
  "copy": false,
  "stream": true,
  "desktop": {
    "autoPaste": true,
    "shortcuts": {
      "pushToTalk": {
        "type": "hold",
        "key": "AltRight"
      },
      "toggle": {
        "type": "doubleTap",
        "key": "AltRight"
      },
      "finish": null,
      "holdThresholdMs": 200,
      "doubleTapIntervalMs": 350
    },
    "app": {
      "directory": "~/.local/share/kit/stt/app"
    },
    "theme": {
      "mode": "device",
      "file": "../.theme/local.json"
    }
  },
  "refine": {
    "enabled": true,
    "copilotUrlEnv": "KIT_COPILOT_URL",
    "model": "gpt-5-mini",
    "timeout": 60
  },
  "models": [
    {
      "name": "qwen3-asr-0.6b",
      "path": "../.asset/model/stt/qwen3-asr-0.6b",
      "computeDevice": "metal"
    }
  ]
}
