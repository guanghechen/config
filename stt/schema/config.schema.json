{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guanghechen/config/kit/stt/schema/config.schema.json",
  "title": "Kit STT Configuration",
  "description": "Named Qwen3-ASR models and shared STT settings. Runtime aggregates models by unique name and rejects repeated shared settings across files.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "$ref": "#/$defs/nonEmptyString" },
    "defaultModel": { "$ref": "#/$defs/nonEmptyString" },
    "models": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/model" },
      "description": "Names must be unique across the complete config set."
    },
    "language": {
      "enum": ["zh", "en", "yue", "ar", "de", "fr", "es", "pt", "id", "it", "ko", "ru", "th", "vi", "ja", "tr", "hi", "ms", "nl", "sv", "da", "fi", "pl", "cs", "fil", "fa", "el", "hu", "mk", "ro"]
    },
    "device": { "$ref": "#/$defs/nonEmptyString" },
    "maxDuration": { "type": "integer", "minimum": 1, "maximum": 300 },
    "timeout": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "copy": { "type": "boolean" },
    "stream": { "type": "boolean" },
    "desktop": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoPaste": { "type": "boolean", "default": true },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "not": { "required": ["directory", "executable"] },
          "properties": {
            "directory": { "$ref": "#/$defs/localPath", "description": "Desktop installation directory containing the platform bundle. Supports ~ or ~/; ordinary relative paths use this config directory. Mutually exclusive with executable." },
            "executable": { "$ref": "#/$defs/localPath", "description": "Explicit desktop executable path for development. Supports ~ or ~/; ordinary relative paths use this config directory. Mutually exclusive with directory." },
            "env": {
              "type": "object",
              "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "additionalProperties": { "type": "string", "not": { "pattern": "\\u0000" } },
              "description": "Literal environment overrides applied by the desktop app launcher."
            }
          }
        },
        "shortcuts": { "$ref": "#/$defs/shortcuts" }
      }
    },
    "refine": { "$ref": "#/$defs/refine" }
  },
  "$defs": {
    "localPath": {
      "allOf": [{ "$ref": "#/$defs/nonEmptyString" }],
      "not": {
        "anyOf": [
          { "pattern": "://" },
          { "pattern": "^~[^/]" }
        ]
      }
    },
    "shortcuts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pushToTalk": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/holdShortcut"
            }
          ]
        },
        "toggle": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/doubleTapShortcut"
            },
            {
              "$ref": "#/$defs/chordShortcut"
            }
          ]
        },
        "finish": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/doubleTapShortcut"
            },
            {
              "$ref": "#/$defs/chordShortcut"
            }
          ]
        },
        "holdThresholdMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 500,
          "default": 200
        },
        "doubleTapIntervalMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 1000,
          "default": 350
        }
      },
      "not": {
        "required": [
          "pushToTalk",
          "toggle"
        ],
        "properties": {
          "pushToTalk": {
            "type": "null"
          },
          "toggle": {
            "type": "null"
          }
        }
      },
      "description": "Omitted bindings use platform defaults; null disables an action. Runtime validates holdThresholdMs <= doubleTapIntervalMs, normalized binding conflicts, and platform support."
    },
    "shortcutKey": {
      "enum": [
        "Space",
        "Escape",
        "KeyA",
        "KeyB",
        "KeyC",
        "KeyD",
        "KeyE",
        "KeyF",
        "KeyG",
        "KeyH",
        "KeyI",
        "KeyJ",
        "KeyK",
        "KeyL",
        "KeyM",
        "KeyN",
        "KeyO",
        "KeyP",
        "KeyQ",
        "KeyR",
        "KeyS",
        "KeyT",
        "KeyU",
        "KeyV",
        "KeyW",
        "KeyX",
        "KeyY",
        "KeyZ",
        "Digit0",
        "Digit1",
        "Digit2",
        "Digit3",
        "Digit4",
        "Digit5",
        "Digit6",
        "Digit7",
        "Digit8",
        "Digit9",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ]
    },
    "shortcutModifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Control",
          "Alt",
          "Shift",
          "Meta"
        ]
      }
    },
    "holdShortcut": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key"
          ],
          "properties": {
            "type": {
              "const": "hold"
            },
            "key": {
              "enum": [
                "Fn"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "key",
            "modifiers"
          ],
          "properties": {
            "type": {
              "const": "hold"
            },
            "key": {
              "$ref": "#/$defs/shortcutKey"
            },
            "modifiers": {
              "$ref": "#/$defs/shortcutModifiers"
            }
          }
        }
      ]
    },
    "doubleTapShortcut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key"
      ],
      "properties": {
        "type": {
          "const": "doubleTap"
        },
        "key": {
          "enum": [
            "Fn",
            "Escape"
          ]
        }
      }
    },
    "chordShortcut": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "key",
        "modifiers"
      ],
      "properties": {
        "type": {
          "const": "chord"
        },
        "key": {
          "$ref": "#/$defs/shortcutKey"
        },
        "modifiers": {
          "$ref": "#/$defs/shortcutModifiers"
        }
      }
    },
    "refine": {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "anyOf": [
          { "required": ["copilotUrl", "copilotUrlEnv"] },
          { "required": ["prompt", "promptFile"] }
        ]
      },
      "properties": {
        "enabled": { "type": "boolean" },
        "copilotUrl": {
          "allOf": [{ "$ref": "#/$defs/nonEmptyString" }],
          "pattern": "^http://",
          "description": "HTTP loopback IP origin with an explicit port; runtime rejects userinfo, paths, queries and fragments."
        },
        "copilotUrlEnv": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Name of the environment variable holding the complete Copilot loopback HTTP origin, mutually exclusive with copilotUrl."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S+$",
          "description": "Exact Copilot model supporting Native Chat Completions; runtime also limits UTF-8 bytes and control characters."
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Optional reasoning_effort sent unchanged to Copilot; the selected model must support this value."
        },
        "prompt": {
          "allOf": [{ "$ref": "#/$defs/nonEmptyString" }],
          "maxLength": 65536,
          "not": { "pattern": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]" },
          "description": "System prompt replacing the built-in instruction, mutually exclusive with promptFile. Runtime limits UTF-8 content to 64 KiB."
        },
        "promptFile": {
          "$ref": "#/$defs/localPath",
          "description": "Local UTF-8 system prompt file, supporting ~ or ~/ and otherwise relative to the declaring config file. Mutually exclusive with prompt; read only when refine is enabled; limited to 64 KiB."
        },
        "tokenEnv": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Name of the environment variable containing the optional downstream bearer, never the token itself."
        },
        "timeout": { "type": "integer", "minimum": 1, "maximum": 600 }
      }
    },
    "model": {
      "type": "object",
      "required": ["name", "path", "computeDevice"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "path": {
          "$ref": "#/$defs/localPath",
          "description": "Local model directory, supporting ~ or ~/ and otherwise relative to the declaring config file."
        },
        "computeDevice": {
          "type": "string",
          "anyOf": [
            { "enum": ["cpu", "metal"] },
            { "pattern": "^cuda:(0|[1-9][0-9]*)$" }
          ],
          "description": "Runtime validates platform support for the selected model and the CUDA device index."
        }
      }
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": { "pattern": "\\u0000" }
    }
  }
}
