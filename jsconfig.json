{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#shared": ["shared/index.mjs"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "cli/**/*"],
  "exclude": ["node_modules"]
}
