{
  "$schema": "https://cdn.jsdelivr.net/npm/@guanghechen/kit-profile@latest/lib/schema/profile.schema.json",
  "name": "agent",
  "envs": {
    "ANTHROPIC_BASE_URL": "http://${host}:${port}/api/claude",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "GOOGLE_GEMINI_BASE_URL": "http://${host}:${port}/api/gemini",
    "OPENAI_BASE_URL": "http://${host}:${port}/api/openai",
    "KIT_COPILOT_OPENAI_VOICE_MODEL": "gpt-4o"
  },
  "vars": {
    "host": "127.0.0.1",
    "port": 4747
  },
  "variants": {
    "github": {
      "envs": {
        "ANTHROPIC_BASE_URL": "https://api.github.com",
        "ANTHROPIC_AUTH_TOKEN": "${env:KIT_COPILOT_GITHUB_TOKEN} This won't work, since we not support inject env yet.",
        "NODE_ENV": "production"
      }
    },
    "dev": {
      "envs": {
        "NODE_ENV": "development"
      },
      "vars": {
        "port": 4848
      }
    },
    "prod": {
      "envs": {
        "NODE_ENV": "production"
      },
      "vars": {
        "port": 4747
      }
    }
  }
}
