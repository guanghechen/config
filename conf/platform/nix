# =============================================================================
# Platform-specific Configuration (Linux / NixOS)
# =============================================================================

# -----------------------------------------------------------------------------
# External Programs
# -----------------------------------------------------------------------------
browser "xdg-open '%u'"
# browser "firefox '%u'"
# browser "chromium '%u'"

# Media player for podcasts
player "mpv '%u'"
# player "vlc '%u'"

# -----------------------------------------------------------------------------
# Macros
# -----------------------------------------------------------------------------
# Open in mpv (for video feeds)
macro y set browser "mpv '%u'" ; open-in-browser ; set browser "xdg-open '%u'"

# Open in VLC
macro m set browser "vlc '%u'" ; open-in-browser ; set browser "xdg-open '%u'"

# Copy link to clipboard (xclip)
macro c set browser "printf '%s' '%u' | xclip -selection clipboard" ; open-in-browser ; set browser "xdg-open '%u'"

# Open in default browser without marking as read
macro b open-in-browser
