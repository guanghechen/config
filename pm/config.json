{
  "apps": [
    {
      "name": "kit-copilot",
      "cmd": "kit",
      "args": ["copilot", "start"],
      "autostart": true,
      "autorestart": true,
      "maxRestarts": 16,
      "killTimeout": 5000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB"
    },
    {
      "name": "kit-shot",
      "platforms": ["osx"],
      "cmd": "${HOME}/.local/share/kit/shot/app/kit-shot",
      "args": ["run"],
      "autostart": false,
      "autorestart": true,
      "maxRestarts": 16,
      "stopExitCodes": [0],
      "killTimeout": 10000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB"
    },
    {
      "name": "kit-stt",
      "platforms": ["osx"],
      "cmd": "${HOME}/.local/share/kit/stt/app/kit-stt",
      "args": ["app", "run"],
      "autostart": false,
      "autorestart": true,
      "stopExitCodes": [0],
      "killTimeout": 15000
    },
    {
      "name": "yoz",
      "cmd": "npm",
      "args": ["run", "start"],
      "cwd": "${KIT_CONFIG_HOME}/yoz",
      "env": {
        "NODE_ENV": "development",
        "PWD": "${KIT_CONFIG_HOME}/yoz"
      },
      "autostart": true,
      "autorestart": true,
      "maxRestarts": 16,
      "killTimeout": 5000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB",
      "platforms": ["osx", "wsl", "nix"]
    },
    {
      "name": "caffeinate",
      "platforms": ["osx"],
      "cmd": "/usr/bin/caffeinate",
      "args": ["-i"],
      "autostart": true
    }
  ]
}
