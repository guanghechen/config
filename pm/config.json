{
  "$schema": "https://raw.githubusercontent.com/guanghechen/config/kit/pm/schema/config.schema.json",
  "apps": [
    {
      "name": "caffeinate",
      "platforms": ["osx"],
      "cmd": "/usr/bin/caffeinate",
      "args": ["-i"],
      "autostart": true
    },
    {
      "name": "kit-copilot",
      "cmd": "kit",
      "args": ["copilot", "start"],
      "autostart": true,
      "autorestart": true,
      "maxRestarts": 16,
      "killTimeout": 5000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB"
    },
    {
      "name": "kit-shot",
      "platforms": ["osx"],
      "cmd": "kit",
      "args": ["shot", "start"],
      "autostart": true,
      "autorestart": false,
      "maxRestarts": 16,
      "stopExitCodes": [0],
      "killTimeout": 10000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB"
    },
    {
      "name": "kit-stt",
      "platforms": ["osx"],
      "cmd": "kit",
      "args": ["stt", "start"],
      "autostart": false,
      "autorestart": false,
      "stopExitCodes": [0],
      "killTimeout": 15000
    },
    {
      "name": "kit-touchpad",
      "platforms": ["osx"],
      "cmd": "kit",
      "args": ["touchpad", "start", "--request-permissions"],
      "autostart": false,
      "autorestart": false,
      "maxRestarts": 16,
      "stopExitCodes": [0],
      "killTimeout": 10000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB"
    },
    {
      "name": "yoz",
      "cmd": "npm",
      "args": ["run", "start"],
      "cwd": "${KIT_CONFIG_HOME}/yoz",
      "env": {
        "NODE_ENV": "development",
        "PWD": "${KIT_CONFIG_HOME}/yoz"
      },
      "autostart": true,
      "autorestart": true,
      "maxRestarts": 16,
      "killTimeout": 5000,
      "logsRotateStrategy": "size",
      "logsRotateSize": "10MB",
      "platforms": ["osx", "wsl", "nix"]
    }
  ]
}
