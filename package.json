{
  "name": "@guanghechen/neovim-markdown-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "yarn format:lintfix && yarn format:prettier",
    "format:prettier": "prettier . --write",
    "format:lintfix": "eslint . --fix",
    "start": "cross-env LOG_LEVEL=verbose vite --force",
    "run:ts": "TS_NODE_PROJECT=tsconfig.node.json node --loader ts-node/esm",
    ":upgrade": "yarn upgrade-interactive && yarn format"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@guanghechen/equal": "1.0.3",
    "@guanghechen/parse-lineno": "2.3.10",
    "@guanghechen/react-hooks": "3.0.14",
    "@guanghechen/react-viewmodel": "0.2.16",
    "@guanghechen/std": "1.0.4",
    "@guanghechen/viewmodel": "1.0.5",
    "@yozora/ast": "2.3.12",
    "@yozora/ast-util": "2.3.12",
    "@yozora/character": "2.3.12",
    "@yozora/core-tokenizer": "2.3.12",
    "@yozora/parser": "2.3.12",
    "@yozora/react-mathjax": "3.0.0-alpha.14",
    "chokidar": "4.0.3",
    "clsx": "2.1.1",
    "copy-to-clipboard": "3.3.3",
    "dayjs": "1.11.13",
    "json5": "2.2.3",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "mermaid": "11.8.0",
    "prismjs": "1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-pdf": "10.0.1",
    "react-router-dom": "7.6.3",
    "sanitize-html": "2.17.0",
    "tailwindcss": "4.1.11"
  },
  "devDependencies": {
    "@guanghechen/chalk": "1.0.4",
    "@guanghechen/eslint-config": "7.0.18",
    "@guanghechen/reporter": "1.0.6",
    "@tailwindcss/language-server": "0.14.24",
    "@tailwindcss/vite": "4.1.11",
    "@types/cross-spawn": "6.0.6",
    "@types/lodash.debounce": "4.0.9",
    "@types/lodash.throttle": "4.1.9",
