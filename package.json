{
  "name": "@guanghechen/neovim-markdown-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "pnpm format:lintfix && pnpm format:prettier",
    "format:prettier": "prettier . --write",
    "format:lintfix": "eslint . --fix",
    "start": "cross-env LOG_LEVEL=debug vite --force",
    "run:ts": "TS_NODE_PROJECT=tsconfig.node.json node --loader ts-node/esm",
    ":upgrade": "pnpm update --interactive && pnpm format"
