{
  "name": "@guanghechen/tsuki-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    ":upgrade": "pnpm update --interactive --latest && pnpm format",
    "agent:check": "pnpm --filter @tsuki/agent-bridge check && pnpm test",
    "agent:skill:link": "node script/agent-skill.mjs link",
    "agent:skill:unlink": "node script/agent-skill.mjs unlink",
    "agent:start": "pnpm --filter @tsuki/agent-bridge start",
    "build": "tsc -b && vite build --emptyOutDir && pnpm extension:build",
    "bundle": "node script/bundle.mjs",
    "format": "biome check --write .",
    "extension:build": "rollup -c rollup.config.extension.mjs",
    "extension:build:production": "rollup -c rollup.config.extension.mjs --environment NODE_ENV:production",
    "extension:watch": "rollup -c rollup.config.extension.mjs -w",
    "lint": "biome check .",
    "start": "vite --force",
    "test": "node --test test/*.test.mjs && pnpm --filter @tsuki/agent-bridge test",
    "watch": "npm-watch"
  },
  "dependencies": {
    "@guanghechen/equal": "2.0.5",
    "@guanghechen/viewmodel": "2.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@rollup/plugin-typescript": "12.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "npm-watch": "0.13.0",
    "rollup": "4.67.4",
    "tailwindcss": "4.3.4",
    "tslib": "2.9.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "watch": {
    "build": {
      "patterns": [
        "src/**",
        "public/**",
        "package.json"
      ],
      "ignore": [
        ".git/",
        "dist/",
        "node_modules/"
      ],
      "extensions": "css,js,mjs,json,lock,tsx,ts"
    }
  }
}
