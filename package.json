{
  "name": "@guanghechen/tsuki-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    ":upgrade": "pnpm update --interactive --latest && pnpm format",
    "build": "tsc -b && vite build --emptyOutDir && pnpm inject:build",
    "format": "pnpm format:lintfix && pnpm format:prettier",
    "format:prettier": "prettier . --write",
    "format:lintfix": "eslint . --fix",
    "inject:build": "rollup -c rollup.config.inject.mjs",
    "inject:build:production": "cross-env NODE_ENV=production rollup -c rollup.config.inject.mjs",
    "inject:watch": "rollup -c rollup.config.inject.mjs -w",
    "start": "vite --force",
    "watch": "npm-watch"
  },
  "dependencies": {
    "@guanghechen/equal": "1.0.3",
    "@guanghechen/react-hooks": "3.0.14",
    "@guanghechen/react-viewmodel": "0.2.18",
    "@guanghechen/viewmodel": "1.0.6",
    "eslint-plugin-tailwindcss": "3.18.2",
    "lodash.debounce": "4.0.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "4.1.18"
  },
  "devDependencies": {
    "@guanghechen/chalk": "1.0.4",
    "@guanghechen/eslint-config": "7.0.20",
    "@guanghechen/reporter": "1.0.7",
    "@guanghechen/rollup-config": "6.0.11",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@tailwindcss/vite": "4.1.18",
    "@types/chrome": "^0.1.32",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "cross-env": "10.1.0",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "npm-watch": "0.13.0",
    "prettier": "3.7.4",
    "rollup": "4.54.0",
    "ts-node": "10.9.2",
    "tslib": "^2.8.1",
    "typescript": "5.9.3",
    "vite": "7.3.0"
  },
  "watch": {
    "build": {
      "patterns": [
        "src/**",
        "public/**",
        "package.json"
      ],
      "ignore": [
        ".git/",
        "dist/",
        "node_modules/"
      ],
      "extensions": "css,js,mjs,json,lock,tsx,ts"
    }
  }
}
