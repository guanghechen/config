    "cross-env": "7.0.3",
    "cross-spawn": "7.0.6",
    "dotenv": "17.0.1",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "open": "10.1.2",
    "prettier": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "vite": "7.0.2",
    "yaml": "2.8.0"
