{
  "name": "@guanghechen/node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Personal Node.js utilities and CLI tools (ESM, zero dependencies)",
  "imports": {
    "#src/env/*": "./src/env/*.mjs",
    "#src/util/*": "./src/util/*.mjs",
    "#cli/*": "./cli/*.mjs"
  },
  "scripts": {
    "test": "node --test **/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage **/*.test.mjs"
  },
  "dependencies": {
    "@guanghechen/stl": "file:src/stl"
  },
  "devDependencies": {}
}
