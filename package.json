{
  "name": "@guanghechen/tsuki-chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    ":upgrade": "pnpm update --interactive --latest && pnpm format",
    "build": "tsc -b && vite build --emptyOutDir && pnpm extension:build",
    "bundle": "node script/bundle.mjs",
    "format": "pnpm format:lintfix && pnpm format:prettier",
    "format:prettier": "prettier . --write",
    "format:lintfix": "eslint . --fix",
    "extension:build": "rollup -c rollup.config.extension.mjs",
    "extension:build:production": "rollup -c rollup.config.extension.mjs --environment NODE_ENV:production",
    "extension:watch": "rollup -c rollup.config.extension.mjs -w",
    "start": "vite --force",
    "watch": "npm-watch"
  },
  "dependencies": {
    "@guanghechen/equal": "2.0.4",
    "@guanghechen/viewmodel": "2.1.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/chrome": "^0.2.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "npm-watch": "0.13.0",
    "prettier": "3.9.5",
    "rollup": "4.62.2",
    "tailwindcss": "4.3.2",
    "tslib": "^2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5"
  },
  "watch": {
    "build": {
      "patterns": [
        "src/**",
        "public/**",
        "package.json"
      ],
      "ignore": [
        ".git/",
        "dist/",
        "node_modules/"
      ],
      "extensions": "css,js,mjs,json,lock,tsx,ts"
    }
  }
}
