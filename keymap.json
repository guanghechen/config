  {
    "bindings": {
      "cmd-,": "zed::OpenSettings",
      "cmd-1": "project_panel::ToggleFocus",
      "cmd-2": "project_search::ToggleFocus",
      "cmd-3": "git_panel::ToggleFocus",
      "cmd-4": "zed::Extensions",
      "cmd-5": "debug_panel::ToggleFocus",
      "cmd-6": "git::FileHistory",
      "cmd-7": "agent::ToggleFocus",
      "cmd-d": "workspace::ToggleAllDocks",
      "cmd-h": "workspace::ActivatePaneLeft",
      "cmd-j": "workspace::ActivatePaneDown",
      "cmd-k": "workspace::ActivatePaneUp",
      "cmd-l": "workspace::ActivatePaneRight",
      "cmd-n": "workspace::NewFile",
      "cmd-p": "file_finder::Toggle",
      "cmd-q": "workspace::ToggleBottomDock",
      "cmd-s": "workspace::Save",
      "cmd-:": "command_palette::Toggle",
      "cmd-t": "terminal_panel::ToggleFocus",
      "cmd-ctrl-`": "terminal_panel::ToggleFocus",
      "cmd-ctrl-f11": "zed::ToggleFullScreen",
      "cmd-ctrl-z": "workspace::ToggleZoom",
      "cmd-ctrl-shift-z": "workspace::ResetPaneSizes"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-a": "editor::SelectAll",
      "cmd-c": "editor::Copy",
      "cmd-v": "editor::Paste",
      "cmd-x": "editor::Cut",
      "cmd-z": "editor::Undo",
      "cmd-u": "editor::UndoSelection",
      "ctrl-p": "editor::ShowCompletions"
    }
  },
  {
    "context": "Editor && mode == full",
    "bindings": {
      "cmd-[": "pane::ActivatePreviousItem",
      "cmd-]": "pane::ActivateNextItem",
      "cmd-i": "pane::GoBack",
      "cmd-o": "pane::GoForward",
      "cmd-r": "pane::RevealInProjectPanel",
      "cmd-f": "buffer_search::Deploy",
      "cmd-enter": "editor::ToggleCodeActions",
      "cmd-m": "editor::ToggleMinimap",
      "cmd-ctrl-f": "editor::Format",
      "cmd-shift-h": "pane::SplitLeft",
      "cmd-shift-j": "pane::SplitDown",
      "cmd-shift-l": "pane::SplitRight",
      "cmd-shift-k": [
        "pane::CloseAllItems",
        {
          "close_pinned": false
        }
      ],
      "cmd-shift-o": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false
        }
      ],
      "ctrl-shift-c": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ],
      "f3": "search::SelectNextMatch",
      "shift-f3": "search::SelectPreviousMatch",
      "f7": "editor::GoToNextDocumentHighlight",
      "shift-f7": "editor::GoToPreviousDocumentHighlight",
      "f8": "editor::GoToDiagnostic",
      "shift-f8": "editor::GoToPreviousDiagnostic",
      "f9": "editor::ToggleBreakpoint",
      "f12": "editor::GoToDefinition",
      "cmd-ctrl-left": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "left",
          "focus": true
        }
      ],
      "cmd-ctrl-right": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "right",
          "focus": true
        }
      ],
      "cmd-ctrl-up": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "up",
          "focus": true
        }
      ],
      "cmd-ctrl-down": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "down",
          "focus": true
        }
      ],
      "cmd-left": "vim::ResizePaneLeft",
      "cmd-right": "vim::ResizePaneRight"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "cmd-ctrl-f": "editor::FormatSelections"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "u": "editor::Undo",
      "ctrl-r": "editor::Redo"
    }
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward"
    }
  },
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "cmd-enter": "menu::Confirm",
      "cmd-.": "menu::Confirm"
    }
  },
  {
    "context": "Editor && edit_prediction",
    "bindings": {
      "cmd-right": "editor::AcceptNextWordEditPrediction"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "cmd-1": "workspace::ToggleLeftDock",
      "cmd-left": "project_panel::CollapseAllEntries"
    }
  },
  {
    "context": "GitPanel",
    "bindings": {
      "cmd-3": "workspace::ToggleLeftDock"
    }
  },
  {
    "context": "ProjectSearchView",
    "bindings": {
      "f4": "search::SelectNextMatch",
      "shift-f4": "search::SelectPreviousMatch"
    }
  },
  {
    "context": "BufferSearchBar || ProjectSearchBar",
    "bindings": {
      "f3": "search::SelectNextMatch",
      "shift-f3": "search::SelectPreviousMatch"
    }
  },
  {
    "context": "!Terminal && !debugger_session",
    "bindings": {
      "f5": "debugger::Start"
    }
  },
  {
    "context": "debugger_stopped > !Terminal",
    "bindings": {
      "f5": "debugger::Continue",
      "f10": "debugger::StepOver",
      "f11": "debugger::StepInto",
      "shift-f11": "debugger::StepOut"
    }
  },
  {
    "context": "debugger_running > !Terminal",
    "bindings": {
      "f6": "debugger::Pause"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "cmd-/": "workspace::NewTerminal",
      "cmd-ctrl-/": "terminal::RenameTerminal",
      "cmd-ctrl-h": "workspace::ActivatePaneLeft",
      "cmd-ctrl-l": "workspace::ActivatePaneRight",
      "cmd-ctrl-w": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false
        }
      ],
      "cmd-ctrl-f12": "zed::ToggleFullScreen",
      "cmd-ctrl-escape": "buffer_search::Dismiss",
      "cmd-v": "terminal::Paste",
      "ctrl-insert": "terminal::Copy",
      "shift-insert": "terminal::Paste"
    }
  },
