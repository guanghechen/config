{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/guanghechen/config/kit/repo/schema/config.schema.json",
  "title": "Kit Repo Configuration",
  "description": "Simple or full repository definitions for kit-repo.",
  "type": "object",
  "required": ["repos"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "repos": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/simpleRepo"
          },
          {
            "$ref": "#/$defs/fullRepo"
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "linkMode": {
      "type": "string",
      "enum": ["soft", "hard", "copy"]
    },
    "relativeWorktreePath": {
      "allOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "not": {
            "pattern": "^(?:[/\\\\]|[A-Za-z]:|~(?:[/\\\\]|$))"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)"
          }
        },
        {
          "not": {
            "pattern": "\\$\\{(?:HOME|XDG_CONFIG_HOME|USERPROFILE)\\}"
          }
        }
      ]
    },
    "branchName": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "edition": {
      "type": "string",
      "enum": ["nix", "nix-remote", "osx", "win"]
    },
    "editions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/edition"
      }
    },
    "nonEmptyEditions": {
      "allOf": [
        {
          "$ref": "#/$defs/editions"
        },
        {
          "minItems": 1
        }
      ]
    },
    "linkTarget": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "type": "object",
          "required": ["to"],
          "properties": {
            "to": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "mode": {
              "$ref": "#/$defs/linkMode"
            },
            "winMode": {
              "$ref": "#/$defs/linkMode"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "linkGroup": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "editions": {
          "$ref": "#/$defs/nonEmptyEditions"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linkTarget"
          }
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/$defs/linkMode"
            }
          ],
          "default": "soft"
        },
        "winMode": {
          "$ref": "#/$defs/linkMode"
        }
      },
      "additionalProperties": false
    },
    "linkGroupValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/linkGroup"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/linkGroup"
          }
        }
      ]
    },
    "links": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/relativeWorktreePath"
      },
      "additionalProperties": {
        "$ref": "#/$defs/linkGroupValue"
      }
    },
    "relativeStepCwd": {
      "allOf": [
        {
          "$ref": "#/$defs/relativeWorktreePath"
        },
        {
          "not": {
            "pattern": "\\$\\{"
          }
        },
        {
          "not": {
            "pattern": "(^\\s|\\s$|\\u0000)"
          }
        }
      ]
    },
    "stepRun": {
      "allOf": [
        {
          "$ref": "#/$defs/nonEmptyString"
        },
        {
          "not": {
            "pattern": "(^\\s|\\s$|\\u0000)"
          }
        }
      ]
    },
    "environmentName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "stepEnvironment": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/environmentName"
      },
      "additionalProperties": {
        "type": "string",
        "not": {
          "pattern": "\\u0000"
        }
      }
    },
    "stepObject": {
      "type": "object",
      "required": ["run"],
      "properties": {
        "run": {
          "$ref": "#/$defs/stepRun"
        },
        "cwd": {
          "$ref": "#/$defs/relativeStepCwd"
        },
        "env": {
          "$ref": "#/$defs/stepEnvironment"
        }
      },
      "additionalProperties": false
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/stepRun"
        },
        {
          "$ref": "#/$defs/stepObject"
        }
      ]
    },
    "steps": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "steps": {
          "$ref": "#/$defs/steps"
        },
        "link": {
          "$ref": "#/$defs/links"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "changed": {
          "$ref": "#/$defs/event"
        },
        "synced": {
          "$ref": "#/$defs/event"
        },
        "failed": {
          "$ref": "#/$defs/event"
        }
      },
      "additionalProperties": false
    },
    "eventsOverlay": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "changed": {
          "oneOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "type": "null"
            }
          ]
        },
        "synced": {
          "oneOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "type": "null"
            }
          ]
        },
        "failed": {
          "oneOf": [
            {
              "$ref": "#/$defs/event"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "simpleOverlay": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "remote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "on": {
          "$ref": "#/$defs/eventsOverlay"
        }
      },
      "additionalProperties": false
    },
    "simplePlatforms": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "nix": {
          "$ref": "#/$defs/simpleOverlay"
        },
        "osx": {
          "$ref": "#/$defs/simpleOverlay"
        },
        "win": {
          "$ref": "#/$defs/simpleOverlay"
        },
        "wsl": {
          "$ref": "#/$defs/simpleOverlay"
        }
      },
      "additionalProperties": false
    },
    "simpleRepo": {
      "type": "object",
      "required": ["name", "remote", "main", "location", "editions"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "remote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "main": {
          "$ref": "#/$defs/branchName"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "editions": {
          "$ref": "#/$defs/nonEmptyEditions"
        },
        "on": {
          "$ref": "#/$defs/events"
        },
        "platforms": {
          "$ref": "#/$defs/simplePlatforms"
        }
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "required": ["remote", "template", "main"],
      "properties": {
        "remote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "main": {
          "$ref": "#/$defs/branchName"
        }
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["branch", "editions"],
      "properties": {
        "branch": {
          "$ref": "#/$defs/branchName"
        },
        "location": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "editions": {
          "$ref": "#/$defs/editions"
        },
        "on": {
          "$ref": "#/$defs/events"
        }
      },
      "additionalProperties": false
    },
    "worktreeOverlay": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "remote": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "template": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "branchOverlay": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "location": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "on": {
          "$ref": "#/$defs/eventsOverlay"
        }
      },
      "additionalProperties": false
    },
    "branchOverlays": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/branchOverlay"
      }
    },
    "fullOverlay": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "worktree": {
          "$ref": "#/$defs/worktreeOverlay"
        },
        "branches": {
          "$ref": "#/$defs/branchOverlays"
        }
      },
      "additionalProperties": false
    },
    "fullPlatforms": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "nix": {
          "$ref": "#/$defs/fullOverlay"
        },
        "osx": {
          "$ref": "#/$defs/fullOverlay"
        },
        "win": {
          "$ref": "#/$defs/fullOverlay"
        },
        "wsl": {
          "$ref": "#/$defs/fullOverlay"
        }
      },
      "additionalProperties": false
    },
    "fullRepo": {
      "type": "object",
      "required": ["name", "worktree", "branches"],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "worktree": {
          "$ref": "#/$defs/worktree"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "platforms": {
          "$ref": "#/$defs/fullPlatforms"
        }
      },
      "additionalProperties": false
    }
  }
}
