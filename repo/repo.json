{
  "$schema": "https://raw.githubusercontent.com/guanghechen/config/kit/repo/schema/config.schema.json",
  "repos": [
    {
      "name": "config",
      "worktree": {
        "remote": "https://github.com/guanghechen/config.git",
        "template": "${XDG_CONFIG_HOME}/${BRANCH}",
        "main": "guanghechen"
      },
      "branches": [
        {
          "branch": "guanghechen",
          "editions": ["nix", "nix-remote", "osx", "win"],
          "on": {
            "synced": {
              "steps": "node cli/sync-config-vscode.mjs"
            }
          }
        },
        {
          "branch": "alacritty",
          "editions": ["nix", "osx"]
        },
        {
          "branch": "alacritty-windows",
          "editions": ["win"]
        },
        {
          "branch": "bash",
          "editions": ["nix", "nix-remote", "osx"]
        },
        {
          "branch": "bat",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "btop",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "claude",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "codex",
          "editions": ["nix", "osx", "win"],
          "on": {
            "synced": {
              "steps": "node script/cli/sync.mjs"
            }
          }
        },
        {
          "branch": "conda",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "cspell",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "fish",
          "editions": ["nix", "nix-remote", "osx"]
        },
        {
          "branch": "fzf",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "gemini",
          "location": "${HOME}/.gemini",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "gh",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "ghostty",
          "editions": ["nix", "osx"]
        },
        {
          "branch": "git",
          "editions": ["nix-remote"]
        },
        {
          "branch": "git-delta",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "helix",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "herdr",
          "editions": ["nix", "nix-remote", "osx"],
          "on": {
            "synced": {
              "steps": "node script/sync.mjs"
            }
          }
        },
        {
          "branch": "karabiner",
          "editions": ["osx"]
        },
        {
          "branch": "kit",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "kitty",
          "editions": ["nix", "osx"]
        },
        {
          "branch": "komorebi",
          "editions": ["win"]
        },
        {
          "branch": "lazygit",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "lsd",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "neovide",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "newsboat",
          "editions": ["nix", "nix-remote", "osx"]
        },
        {
          "branch": "nvim",
          "editions": ["nix", "nix-remote", "osx", "win"],
          "on": {
            "changed": {
              "steps": "node script/build.mjs --force"
            },
            "synced": {
              "steps": "node script/build.mjs"
            }
          }
        },
        {
          "branch": "nvim-nvchad",
          "editions": ["nix", "osx"],
          "on": {
            "changed": {
              "steps": "node script/build.mjs --force"
            },
            "synced": {
              "steps": "node script/build.mjs"
            }
          }
        },
        {
          "branch": "opencode",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "ora",
          "editions": ["nix", "nix-remote", "osx", "win"],
          "on": {
            "changed": {
              "steps": "pnpm install -y"
            }
          }
        },
        {
          "branch": "pm2",
          "editions": []
        },
        {
          "branch": "pi",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "pwsh",
          "editions": ["win"]
        },
        {
          "branch": "ripgrep",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "skhd",
          "editions": ["osx"]
        },
        {
          "branch": "starship",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "tmux",
          "editions": ["nix", "nix-remote", "osx"],
          "on": {
            "changed": {
              "steps": [
                {
                  "cwd": "rust/ghc-tmux-status",
                  "run": "cargo build --release"
                }
              ]
            }
          }
        },
        {
          "branch": "tsuki",
          "editions": ["nix", "osx", "win"],
          "on": {
            "changed": {
              "steps": ["pnpm install -y", "pnpm build"]
            }
          }
        },
        {
          "branch": "vsgit",
          "editions": ["nix", "osx", "win"],
          "on": {
            "changed": {
              "steps": ["pnpm install -y", "pnpm build", "pnpm package"]
            }
          }
        },
        {
          "branch": "wezterm",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "wiki",
          "editions": ["nix", "osx", "win"]
        },
        {
          "branch": "yabai",
          "editions": ["osx"]
        },
        {
          "branch": "yasb",
          "editions": ["win"]
        },
        {
          "branch": "yazi",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "yoz",
          "editions": ["nix", "osx"],
          "on": {
            "changed": {
              "steps": "pnpm install -y"
            }
          }
        },
        {
          "branch": "yui",
          "editions": ["nix", "osx"]
        }
      ]
    }
  ]
}
