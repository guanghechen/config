        },
        {
          "branch": "gh",
          "editions": ["nix", "nix-remote", "osx", "win"]
        },
        {
          "branch": "ghostty",
          "editions": ["nix", "osx"]
        },
        {
          "branch": "git",
          "editions": ["nix-remote"]
