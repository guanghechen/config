# tokyonight-storm

# Text and neutral surfaces
theme[main_bg]="#24283b"
theme[main_fg]="#c0caf5"
theme[title]="#c0caf5"
theme[hi_fg]="#bb9af7"
theme[selected_bg]="#30374e"
theme[selected_fg]="#c0caf5"
theme[inactive_fg]="#8994b5"
theme[proc_misc]="#7aa2f7"
theme[graph_text]="#a9b1d6"
theme[meter_bg]="#292e42"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#48536f"
theme[mem_box]="#48536f"
theme[net_box]="#48536f"
theme[proc_box]="#bb9af7"
theme[div_line]="#30374e"

# Temperature and CPU load
theme[temp_start]="#9ece6a"
theme[temp_mid]="#e0af68"
theme[temp_end]="#f78498"
theme[cpu_start]="#7aa2f7"
theme[cpu_mid]="#bb9af7"
theme[cpu_end]="#f78498"

# Give each memory meter a stable color.
theme[free_start]="#9ece6a"
theme[free_mid]="#9ece6a"
theme[free_end]="#9ece6a"
theme[cached_start]="#7dcfff"
theme[cached_mid]="#7dcfff"
theme[cached_end]="#7dcfff"
theme[available_start]="#7aa2f7"
theme[available_mid]="#7aa2f7"
theme[available_end]="#7aa2f7"
theme[used_start]="#bb9af7"
theme[used_mid]="#bb9af7"
theme[used_end]="#bb9af7"

# Network directions and process load
theme[download_start]="#9ece6a"
theme[download_mid]="#7dcfff"
theme[download_end]="#7aa2f7"
theme[upload_start]="#ff9e64"
theme[upload_mid]="#e68fca"
theme[upload_end]="#bb9af7"
theme[process_start]="#a9b1d6"
theme[process_mid]="#7aa2f7"
theme[process_end]="#bb9af7"
theme[proc_pause_bg]="#30374e"
