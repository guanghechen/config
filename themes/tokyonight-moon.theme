# tokyonight-moon

# Text and neutral surfaces
theme[main_bg]="#222436"
theme[main_fg]="#c8d3f5"
theme[title]="#c8d3f5"
theme[hi_fg]="#c099ff"
theme[selected_bg]="#343b54"
theme[selected_fg]="#c8d3f5"
theme[inactive_fg]="#8e9bc1"
theme[proc_misc]="#82aaff"
theme[graph_text]="#aab6df"
theme[meter_bg]="#2f334d"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#4c5878"
theme[mem_box]="#4c5878"
theme[net_box]="#4c5878"
theme[proc_box]="#c099ff"
theme[div_line]="#343b54"

# Temperature and CPU load
theme[temp_start]="#c3e88d"
theme[temp_mid]="#ffc777"
theme[temp_end]="#ff8590"
theme[cpu_start]="#82aaff"
theme[cpu_mid]="#c099ff"
theme[cpu_end]="#ff8590"

# Give each memory meter a stable color.
theme[free_start]="#c3e88d"
theme[free_mid]="#c3e88d"
theme[free_end]="#c3e88d"
theme[cached_start]="#86e1fc"
theme[cached_mid]="#86e1fc"
theme[cached_end]="#86e1fc"
theme[available_start]="#82aaff"
theme[available_mid]="#82aaff"
theme[available_end]="#82aaff"
theme[used_start]="#c099ff"
theme[used_mid]="#c099ff"
theme[used_end]="#c099ff"

# Network directions and process load
theme[download_start]="#c3e88d"
theme[download_mid]="#86e1fc"
theme[download_end]="#82aaff"
theme[upload_start]="#ff966c"
theme[upload_mid]="#fca7ea"
theme[upload_end]="#c099ff"
theme[process_start]="#aab6df"
theme[process_mid]="#82aaff"
theme[process_end]="#c099ff"
theme[proc_pause_bg]="#343b54"
