# onehalf-light

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#696D75,bg+:#EAEAEA,hl+:#F07178"
--color="fg:#4F525A,bg:#FAFAFA,hl:#DEA95F"
--color="gutter:#FAFAFA,pointer:#F07178,spinner:#4078F2"
--color="info:#4078F2,prompt:#7ECA9C,marker:#F07178,query:#696D75"
--preview='bat --line-range=:500 --style=snip --theme=onehalf-light --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+})'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


