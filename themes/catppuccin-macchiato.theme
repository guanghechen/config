# catppuccin-macchiato

# Text and neutral surfaces
theme[main_bg]="#24273A"
theme[main_fg]="#CAD3F5"
theme[title]="#CAD3F5"
theme[hi_fg]="#C6A0F6"
theme[selected_bg]="#494D64"
theme[selected_fg]="#CAD3F5"
theme[inactive_fg]="#6E738D"
theme[proc_misc]="#8AADF4"
theme[graph_text]="#B8C0E0"
theme[meter_bg]="#363A4F"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#5B6078"
theme[mem_box]="#5B6078"
theme[net_box]="#5B6078"
theme[proc_box]="#C6A0F6"
theme[div_line]="#494D64"

# Temperature and CPU load
theme[temp_start]="#A6DA95"
theme[temp_mid]="#EED49F"
theme[temp_end]="#ED8796"
theme[cpu_start]="#8AADF4"
theme[cpu_mid]="#C6A0F6"
theme[cpu_end]="#ED8796"

# Give each memory meter a stable color.
theme[free_start]="#A6DA95"
theme[free_mid]="#A6DA95"
theme[free_end]="#A6DA95"
theme[cached_start]="#8BD5CA"
theme[cached_mid]="#8BD5CA"
theme[cached_end]="#8BD5CA"
theme[available_start]="#8AADF4"
theme[available_mid]="#8AADF4"
theme[available_end]="#8AADF4"
theme[used_start]="#C6A0F6"
theme[used_mid]="#C6A0F6"
theme[used_end]="#C6A0F6"

# Network directions and process load
theme[download_start]="#A6DA95"
theme[download_mid]="#8BD5CA"
theme[download_end]="#8AADF4"
theme[upload_start]="#F5A97F"
theme[upload_mid]="#F5BDE6"
theme[upload_end]="#C6A0F6"
theme[process_start]="#B8C0E0"
theme[process_mid]="#8AADF4"
theme[process_end]="#C6A0F6"
theme[proc_pause_bg]="#494D64"
