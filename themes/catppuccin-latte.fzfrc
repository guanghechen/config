# catppuccin-latte

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#5C5F77,bg+:#CCD0DA,hl+:#EA76CB"
--color="fg:#7C7F93,bg:#EFF1F5,hl:#DF8E1D"
--color="gutter:#EFF1F5,pointer:#EA76CB,spinner:#1E66F5"
--color="info:#1E66F5,prompt:#40A02B,marker:#EA76CB,query:#5C5F77"
--preview='bat --line-range=:500 --style=snip --theme=catppuccin-latte --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


