# gruvbox-dark

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#EBDBB2,bg+:#504945,hl+:#D3869B"
--color="fg:#BDAE93,bg:#32302F,hl:#D79921"
--color="gutter:#32302F,pointer:#D3869B,spinner:#458588"
--color="info:#83A598,prompt:#B8BB26,marker:#D3869B,query:#EBDBB2"
--preview='bat --line-range=:500 --style=snip --theme=gruvbox-dark --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


