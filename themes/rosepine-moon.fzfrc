# rosepine-moon

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#E0DEF4,bg+:#393552,hl+:#EB6F92"
--color="fg:#6E6A86,bg:#232136,hl:#F6C177"
--color="gutter:#232136,pointer:#EB6F92,spinner:#3E8FB0"
--color="info:#3E8FB0,prompt:#95B1AC,marker:#EB6F92,query:#E0DEF4"
--preview='bat --line-range=:500 --style=snip --theme=rosepine-moon --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:become(nvim {+} < /dev/tty)'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


