# tokyonight-day

# Text and neutral surfaces
theme[main_bg]="#e1e2e7"
theme[main_fg]="#293552"
theme[title]="#293552"
theme[hi_fg]="#663999"
theme[selected_bg]="#ccd1df"
theme[selected_fg]="#293552"
theme[inactive_fg]="#56627e"
theme[proc_misc]="#254e96"
theme[graph_text]="#445270"
theme[meter_bg]="#d5d9e4"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#9ca6be"
theme[mem_box]="#9ca6be"
theme[net_box]="#9ca6be"
theme[proc_box]="#663999"
theme[div_line]="#ccd1df"

# Temperature and CPU load
theme[temp_start]="#3e5d2c"
theme[temp_mid]="#6b4d25"
theme[temp_end]="#a21d49"
theme[cpu_start]="#254e96"
theme[cpu_mid]="#663999"
theme[cpu_end]="#a21d49"

# Give each memory meter a stable color.
theme[free_start]="#3e5d2c"
theme[free_mid]="#3e5d2c"
theme[free_end]="#3e5d2c"
theme[cached_start]="#0f586f"
theme[cached_mid]="#0f586f"
theme[cached_end]="#0f586f"
theme[available_start]="#254e96"
theme[available_mid]="#254e96"
theme[available_end]="#254e96"
theme[used_start]="#663999"
theme[used_mid]="#663999"
theme[used_end]="#663999"

# Network directions and process load
theme[download_start]="#3e5d2c"
theme[download_mid]="#0f586f"
theme[download_end]="#254e96"
theme[upload_start]="#7d4005"
theme[upload_mid]="#943468"
theme[upload_end]="#663999"
theme[process_start]="#445270"
theme[process_mid]="#254e96"
theme[process_end]="#663999"
theme[proc_pause_bg]="#ccd1df"
