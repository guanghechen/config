# catppuccin-mocha

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#BAC2DE,bg+:#313244,hl+:#F5C2E7"
--color="fg:#9399B2,bg:#1E1E2E,hl:#F9E2AF"
--color="gutter:#1E1E2E,pointer:#F5C2E7,spinner:#89B4FA"
--color="info:#89B4FA,prompt:#A6E3A1,marker:#F5C2E7,query:#BAC2DE"
--preview='bat --line-range=:500 --style=snip --theme=catppuccin-mocha --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


