# kanagawa-wave

# Text and neutral surfaces
theme[main_bg]="#1F1F28"
theme[main_fg]="#DCD7BA"
theme[title]="#DCD7BA"
theme[hi_fg]="#7E9CD8"
theme[selected_bg]="#223249"
theme[selected_fg]="#DCD7BA"
theme[inactive_fg]="#9B9A8C"
theme[proc_misc]="#7E9CD8"
theme[graph_text]="#C8C093"
theme[meter_bg]="#2A2A37"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#54546D"
theme[mem_box]="#54546D"
theme[net_box]="#54546D"
theme[proc_box]="#7E9CD8"
theme[div_line]="#223249"

# Temperature and CPU load
theme[temp_start]="#98BB6C"
theme[temp_mid]="#E6C384"
theme[temp_end]="#ED7D86"
theme[cpu_start]="#7E9CD8"
theme[cpu_mid]="#AC96CC"
theme[cpu_end]="#ED7D86"

# Give each memory meter a stable color.
theme[free_start]="#98BB6C"
theme[free_mid]="#98BB6C"
theme[free_end]="#98BB6C"
theme[cached_start]="#7AA89F"
theme[cached_mid]="#7AA89F"
theme[cached_end]="#7AA89F"
theme[available_start]="#7E9CD8"
theme[available_mid]="#7E9CD8"
theme[available_end]="#7E9CD8"
theme[used_start]="#AC96CC"
theme[used_mid]="#AC96CC"
theme[used_end]="#AC96CC"

# Network directions and process load
theme[download_start]="#98BB6C"
theme[download_mid]="#7AA89F"
theme[download_end]="#7E9CD8"
theme[upload_start]="#FFA066"
theme[upload_mid]="#D98BA3"
theme[upload_end]="#AC96CC"
theme[process_start]="#C8C093"
theme[process_mid]="#7E9CD8"
theme[process_end]="#AC96CC"
theme[proc_pause_bg]="#223249"
