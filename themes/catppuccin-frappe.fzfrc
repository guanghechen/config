# catppuccin-frappe

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#B5BFE2,bg+:#414559,hl+:#F4B8E4"
--color="fg:#949CBB,bg:#303446,hl:#E5C890"
--color="gutter:#303446,pointer:#F4B8E4,spinner:#8CAAEE"
--color="info:#8CAAEE,prompt:#A6D189,marker:#F4B8E4,query:#B5BFE2"
--preview='bat --line-range=:500 --style=snip --theme=catppuccin-frappe --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+})'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'
