# catppuccin-mocha

# Main bg
theme[main_bg]="#1E1E2E"

# Main text color
theme[main_fg]="#CDD6F4"

# Title color for boxes
theme[title]="#CDD6F4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89B4FA"

# Background color of selected item in processes box
theme[selected_bg]="#313244"

# Foreground color of selected item in processes box
theme[selected_fg]="#CDD6F4"

# Color of inactive/disabled text
theme[inactive_fg]="#6C7086"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#89B4FA"

# Color of text in graphs
theme[graph_text]="#A6ADC8"

# Background color of meters
theme[meter_bg]="#313244"

# Cpu box outline color
theme[cpu_box]="#45475A"

# Memory/disks box outline color
theme[mem_box]="#45475A"

# Net up/down box outline color
theme[net_box]="#45475A"

# Processes box outline color
theme[proc_box]="#45475A"

# Box divider line and small boxes line color
theme[div_line]="#45475A"

# Temperature graph colors (green -> yellow -> red)
theme[temp_start]="#A6E3A1"
theme[temp_mid]="#F9E2AF"
theme[temp_end]="#F38BA8"

# CPU graph colors
theme[cpu_start]="#A6E3A1"
theme[cpu_mid]="#F9E2AF"
theme[cpu_end]="#F38BA8"

# Mem/Disk free meter
theme[free_start]="#A6E3A1"
theme[free_mid]="#F9E2AF"
theme[free_end]="#F38BA8"

# Mem/Disk cached meter
theme[cached_start]="#94E2D5"
theme[cached_mid]="#89B4FA"
theme[cached_end]="#F5C2E7"

# Mem/Disk available meter
theme[available_start]="#A6E3A1"
theme[available_mid]="#F9E2AF"
theme[available_end]="#FAB387"

# Mem/Disk used meter
theme[used_start]="#A6E3A1"
theme[used_mid]="#F9E2AF"
theme[used_end]="#F38BA8"

# Download graph colors
theme[download_start]="#A6E3A1"
theme[download_mid]="#94E2D5"
theme[download_end]="#89B4FA"

# Upload graph colors
theme[upload_start]="#F5C2E7"
theme[upload_mid]="#F5C2E7"
theme[upload_end]="#F38BA8"

# Process box gradient
theme[process_start]="#94E2D5"
theme[process_mid]="#B4BEFE"
theme[process_end]="#CBA6F7"

# Background color when process is paused (e.g. after pressing 'p')
theme[proc_pause_bg]="#F38BA8"
