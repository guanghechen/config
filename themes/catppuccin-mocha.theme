# catppuccin-mocha

# Text and neutral surfaces
theme[main_bg]="#1E1E2E"
theme[main_fg]="#CDD6F4"
theme[title]="#CDD6F4"
theme[hi_fg]="#CBA6F7"
theme[selected_bg]="#45475A"
theme[selected_fg]="#CDD6F4"
theme[inactive_fg]="#6C7086"
theme[proc_misc]="#89B4FA"
theme[graph_text]="#BAC2DE"
theme[meter_bg]="#313244"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#585B70"
theme[mem_box]="#585B70"
theme[net_box]="#585B70"
theme[proc_box]="#CBA6F7"
theme[div_line]="#45475A"

# Temperature and CPU load
theme[temp_start]="#A6E3A1"
theme[temp_mid]="#F9E2AF"
theme[temp_end]="#F38BA8"
theme[cpu_start]="#89B4FA"
theme[cpu_mid]="#CBA6F7"
theme[cpu_end]="#F38BA8"

# Give each memory meter a stable color.
theme[free_start]="#A6E3A1"
theme[free_mid]="#A6E3A1"
theme[free_end]="#A6E3A1"
theme[cached_start]="#94E2D5"
theme[cached_mid]="#94E2D5"
theme[cached_end]="#94E2D5"
theme[available_start]="#89B4FA"
theme[available_mid]="#89B4FA"
theme[available_end]="#89B4FA"
theme[used_start]="#CBA6F7"
theme[used_mid]="#CBA6F7"
theme[used_end]="#CBA6F7"

# Network directions and process load
theme[download_start]="#A6E3A1"
theme[download_mid]="#94E2D5"
theme[download_end]="#89B4FA"
theme[upload_start]="#FAB387"
theme[upload_mid]="#F5C2E7"
theme[upload_end]="#CBA6F7"
theme[process_start]="#BAC2DE"
theme[process_mid]="#89B4FA"
theme[process_end]="#CBA6F7"
theme[proc_pause_bg]="#45475A"
