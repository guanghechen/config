# catppuccin-latte

# Text and neutral surfaces
theme[main_bg]="#EFF1F5"
theme[main_fg]="#303446"
theme[title]="#303446"
theme[hi_fg]="#722FBC"
theme[selected_bg]="#CCD0DA"
theme[selected_fg]="#303446"
theme[inactive_fg]="#9CA0B0"
theme[proc_misc]="#2451B5"
theme[graph_text]="#4C4F69"
theme[meter_bg]="#DCE0E8"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#BCC0CC"
theme[mem_box]="#BCC0CC"
theme[net_box]="#BCC0CC"
theme[proc_box]="#722FBC"
theme[div_line]="#CCD0DA"

# Temperature and CPU load
theme[temp_start]="#25651C"
theme[temp_mid]="#7B4D0D"
theme[temp_end]="#AD1635"
theme[cpu_start]="#2451B5"
theme[cpu_mid]="#722FBC"
theme[cpu_end]="#AD1635"

# Give each memory meter a stable color.
theme[free_start]="#25651C"
theme[free_mid]="#25651C"
theme[free_end]="#25651C"
theme[cached_start]="#106168"
theme[cached_mid]="#106168"
theme[cached_end]="#106168"
theme[available_start]="#2451B5"
theme[available_mid]="#2451B5"
theme[available_end]="#2451B5"
theme[used_start]="#722FBC"
theme[used_mid]="#722FBC"
theme[used_end]="#722FBC"

# Network directions and process load
theme[download_start]="#25651C"
theme[download_mid]="#106168"
theme[download_end]="#2451B5"
theme[upload_start]="#973C0F"
theme[upload_mid]="#91377D"
theme[upload_end]="#722FBC"
theme[process_start]="#4C4F69"
theme[process_mid]="#2451B5"
theme[process_end]="#722FBC"
theme[proc_pause_bg]="#CCD0DA"
