# kanagawa-lotus

# Text and neutral surfaces
theme[main_bg]="#F2ECBC"
theme[main_fg]="#38384D"
theme[title]="#38384D"
theme[hi_fg]="#3E5A87"
theme[selected_bg]="#D5D6CE"
theme[selected_fg]="#38384D"
theme[inactive_fg]="#69675A"
theme[proc_misc]="#3E5A87"
theme[graph_text]="#545464"
theme[meter_bg]="#DCD5AC"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#ACA99A"
theme[mem_box]="#ACA99A"
theme[net_box]="#ACA99A"
theme[proc_box]="#3E5A87"
theme[div_line]="#D5D6CE"

# Temperature and CPU load
theme[temp_start]="#4A6037"
theme[temp_mid]="#655A35"
theme[temp_end]="#A1364B"
theme[cpu_start]="#3E5A87"
theme[cpu_mid]="#624C83"
theme[cpu_end]="#A1364B"

# Give each memory meter a stable color.
theme[free_start]="#4A6037"
theme[free_mid]="#4A6037"
theme[free_end]="#4A6037"
theme[cached_start]="#3F6058"
theme[cached_mid]="#3F6058"
theme[cached_end]="#3F6058"
theme[available_start]="#3E5A87"
theme[available_mid]="#3E5A87"
theme[available_end]="#3E5A87"
theme[used_start]="#624C83"
theme[used_mid]="#624C83"
theme[used_end]="#624C83"

# Network directions and process load
theme[download_start]="#4A6037"
theme[download_mid]="#3F6058"
theme[download_end]="#3E5A87"
theme[upload_start]="#914600"
theme[upload_mid]="#8E3F62"
theme[upload_end]="#624C83"
theme[process_start]="#545464"
theme[process_mid]="#3E5A87"
theme[process_end]="#624C83"
theme[proc_pause_bg]="#D5D6CE"
