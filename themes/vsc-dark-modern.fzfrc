# vsc-dark-modern

--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--scrollbar="┃"
--multi
--color="fg+:#CCCCCC,bg+:#2A2D2E,hl+:#CE9178"
--color="fg:#6E7681,bg:#1F1F1F,hl:#DCDCAA"
--color="gutter:#1F1F1F,pointer:#CE9178,spinner:#0078D4"
--color="info:#9CDCFE,prompt:#B5CEA8,marker:#CE9178,query:#CCCCCC"
--preview='bat --line-range=:500 --style=snip --theme=vsc-dark-modern --number --color=always {} || cat -n {}'
