# vsc-dark-modern

--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--scrollbar="┃"
--multi
--color="fg+:#CCCCCC,bg+:#313131,hl+:#F5A9B8"
--color="fg:#868686,bg:#1F1F1F,hl:#DCDCAA"
--color="gutter:#1F1F1F,pointer:#F5A9B8,spinner:#0078D4"
--color="info:#9CDCFE,prompt:#B5CEA8,marker:#F5A9B8,query:#CCCCCC"
--preview='bat --line-range=:500 --style=snip --theme=vsc-dark-modern --number --color=always {} || cat -n {}'
