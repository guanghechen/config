# catppuccin-frappe

# Text and neutral surfaces
theme[main_bg]="#303446"
theme[main_fg]="#C6D0F5"
theme[title]="#C6D0F5"
theme[hi_fg]="#CA9EE6"
theme[selected_bg]="#51576D"
theme[selected_fg]="#C6D0F5"
theme[inactive_fg]="#737994"
theme[proc_misc]="#8CAAEE"
theme[graph_text]="#B5BFE2"
theme[meter_bg]="#414559"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#626880"
theme[mem_box]="#626880"
theme[net_box]="#626880"
theme[proc_box]="#CA9EE6"
theme[div_line]="#51576D"

# Temperature and CPU load
theme[temp_start]="#A6D189"
theme[temp_mid]="#E5C890"
theme[temp_end]="#E78284"
theme[cpu_start]="#8CAAEE"
theme[cpu_mid]="#CA9EE6"
theme[cpu_end]="#E78284"

# Give each memory meter a stable color.
theme[free_start]="#A6D189"
theme[free_mid]="#A6D189"
theme[free_end]="#A6D189"
theme[cached_start]="#81C8BE"
theme[cached_mid]="#81C8BE"
theme[cached_end]="#81C8BE"
theme[available_start]="#8CAAEE"
theme[available_mid]="#8CAAEE"
theme[available_end]="#8CAAEE"
theme[used_start]="#CA9EE6"
theme[used_mid]="#CA9EE6"
theme[used_end]="#CA9EE6"

# Network directions and process load
theme[download_start]="#A6D189"
theme[download_mid]="#81C8BE"
theme[download_end]="#8CAAEE"
theme[upload_start]="#EF9F76"
theme[upload_mid]="#F4B8E4"
theme[upload_end]="#CA9EE6"
theme[process_start]="#B5BFE2"
theme[process_mid]="#8CAAEE"
theme[process_end]="#CA9EE6"
theme[proc_pause_bg]="#51576D"
