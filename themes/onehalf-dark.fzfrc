# onehalf-dark

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#D7DAE0,bg+:#3E4451,hl+:#DE8C92"
--color="fg:#B6BDCA,bg:#1E222A,hl:#E5C07B"
--color="gutter:#1E222A,pointer:#DE8C92,spinner:#61AFEF"
--color="info:#61AFEF,prompt:#7ECA9C,marker:#DE8C92,query:#D7DAE0"
--preview='bat --line-range=:500 --style=snip --theme=onehalf-dark --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


