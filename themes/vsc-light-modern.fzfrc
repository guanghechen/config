# vsc-light-modern

--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--scrollbar="┃"
--multi
--color="fg+:#3B3B3B,bg+:#E8E8E8,hl+:#E75480"
--color="fg:#767676,bg:#FFFFFF,hl:#795E26"
--color="gutter:#FFFFFF,pointer:#E75480,spinner:#005FB8"
--color="info:#001080,prompt:#098658,marker:#E75480,query:#3B3B3B"
--preview='bat --line-range=:500 --style=snip --theme=vsc-light-modern --number --color=always {} || cat -n {}'
