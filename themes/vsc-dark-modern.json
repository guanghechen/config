{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "vsc-dark-modern",
  "author": "guanghechen",
  "themes": [
    {
      "name": "vsc-dark-modern",
      "appearance": "dark",
      "style": {
        "border": "#2B2B2B",
        "created": "#88C796",
        "deleted": "#B95641",
        "ignored": "#8C8C8C",
        "editor.background": "#1F1F1F",
        "editor.foreground": "#CCCCCC",
        "editor.invisible": "#DEDEDE",
        "editor.gutter.background": "#1F1F1F",
        "error": "#F04C4C",
        "hidden": "#9D9D9D",
        "hint": "#969696",
        "info.background": "#0078D420",
        "modified": "#DDC194",
        "scrollbar.thumb.background": "#FFFFFF10",
        "scrollbar.thumb.hover_background": "#FFFFFF20",
        "tab.active_background": "#1F1F1F",
        "terminal.background": "#1F1F1F",
        "text": "#CCCCCC",
        "text.muted": "#CCCCCC",
        "toolbar.background": "#1F1F1F",
        "warning": "#C7A201",
        "warning.background": "#C7A201aa",
        "players": [
          {
            "cursor": "#FFFFFF"
          }
        ],
        "syntax": {
          "attribute": {
            "color": "#91CBEA"
          },
          "boolean": {
            "color": "#569CD6"
          },
          "comment": {
            "color": "#6A9955"
          },
          "constant": {
            "color": "#569CD6"
          },
          "emphasis": {
            "color": "#9CDCFE",
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "#9CDCFE",
            "font_weight": 700
          },
          "function": {
            "color": "#DCDCAA"
          },
          "link_text": {
            "color": "#DCDCAA"
          },
          "link_uri": {
            "color": "#DCDCAA"
          },
          "keyword": {
            "color": "#C586C0"
          },
          "namespace": {
            "color": "#4EC9B0"
          },
          "number": {
            "color": "#569CD6"
          },
          "property": {
            "color": "#91CBEA"
          },
          "punctuation.list_marker": {
            "color": "#91CBEA"
          },
          "selector": {
            "color": "#9CDCFE"
          },
          "selector.pseudo": {
            "color": "#DCDCAA"
          },
          "string": {
            "color": "#BA846E"
          },
          "string.escape": {
            "color": "#C9AE76"
          },
          "string.special": {
            "color": "#CCCCCC"
          },
          "tag": {
            "color": "#569CD6"
          },
          "title": {
            "color": "#569CD6",
            "font_weight": 700
          },
          "type": {
            "color": "#4EC9B0"
          },
          "variable": {
            "color": "#9CDCFE"
          }
        }
      }
    }
  ]
}
