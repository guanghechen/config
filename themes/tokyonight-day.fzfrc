# tokyonight-day

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:#3054a8,bg+:#c4c8da,hl+:#9854f1"
--color="fg:#233e7c,bg:#e1e2e7,hl:#8c6c3e"
--color="gutter:#e1e2e7,pointer:#9854f1,spinner:#2e7de9"
--color="info:#188092,prompt:#387068,marker:#9854f1,query:#3054a8"
--preview='bat --line-range=:500 --style=snip --theme=tokyonight-day --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+})'
--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'


