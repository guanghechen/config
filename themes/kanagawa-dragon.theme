# kanagawa-dragon

# Text and neutral surfaces
theme[main_bg]="#181616"
theme[main_fg]="#C5C9C5"
theme[title]="#C5C9C5"
theme[hi_fg]="#8BA4B0"
theme[selected_bg]="#303632"
theme[selected_fg]="#C5C9C5"
theme[inactive_fg]="#8F968B"
theme[proc_misc]="#8BA4B0"
theme[graph_text]="#A6A69C"
theme[meter_bg]="#282727"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="#50534E"
theme[mem_box]="#50534E"
theme[net_box]="#50534E"
theme[proc_box]="#8BA4B0"
theme[div_line]="#303632"

# Temperature and CPU load
theme[temp_start]="#87A987"
theme[temp_mid]="#C4B28A"
theme[temp_end]="#D58C84"
theme[cpu_start]="#8BA4B0"
theme[cpu_mid]="#A49AB2"
theme[cpu_end]="#D58C84"

# Give each memory meter a stable color.
theme[free_start]="#87A987"
theme[free_mid]="#87A987"
theme[free_end]="#87A987"
theme[cached_start]="#8EA4A2"
theme[cached_mid]="#8EA4A2"
theme[cached_end]="#8EA4A2"
theme[available_start]="#8BA4B0"
theme[available_mid]="#8BA4B0"
theme[available_end]="#8BA4B0"
theme[used_start]="#A49AB2"
theme[used_mid]="#A49AB2"
theme[used_end]="#A49AB2"

# Network directions and process load
theme[download_start]="#87A987"
theme[download_mid]="#8EA4A2"
theme[download_end]="#8BA4B0"
theme[upload_start]="#BF9D85"
theme[upload_mid]="#AE9AAC"
theme[upload_end]="#A49AB2"
theme[process_start]="#A6A69C"
theme[process_mid]="#8BA4B0"
theme[process_end]="#A49AB2"
theme[proc_pause_bg]="#303632"
