config-file = local/theme.conf
config-file = local/shader.conf
config-file = font-maple.conf
config-file = keymap.conf
config-file = shader.conf

# Background
background-blur = true

# Bell
bell-features = attention
bell-features = title

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = false
cursor-opacity = 0.85

# General
confirm-close-surface = false
clipboard-paste-protection = true
copy-on-select = true
link-url = true
mouse-hide-while-typing = true
scrollback-limit = 10000
shell-integration = detect
shell-integration-features = no-cursor,title,ssh-env,ssh-terminfo,path
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
split-preserve-zoom = navigation
cursor-click-to-move = true

# macOS
macos-option-as-alt = true
macos-titlebar-style = hidden
macos-window-shadow = true
window-save-state = always

# Quick terminal
quick-terminal-position = top
quick-terminal-size = 35%
quick-terminal-autohide = true
quick-terminal-screen = main

# Window
window-height = 1000
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-width = 1600
