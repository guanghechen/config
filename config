config-file = local/theme
config-file = keymap.conf
config-file = font-maple.conf

# Background
background-blur = true

# Bell
bell-features = attention
bell-features = title

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = false
cursor-opacity = 0.85

# General
confirm-close-surface = false
copy-on-select = true
link-url = true
mouse-hide-while-typing = true
scrollback-limit = 10000
shell-integration-features = no-cursor

# macOS
macos-option-as-alt = true
macos-titlebar-style = hidden
macos-window-shadow = true
window-save-state = always

# Window
window-height = 1000
window-padding-balance = false
window-padding-x = 0,0
window-padding-y = 0,0
window-width = 1600

# Shader
custom-shader = shaders/cursor_blaze_no_trail.glsl
custom-shader = shaders/cursor_smear_fade.glsl
