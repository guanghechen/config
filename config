# =============================================================================
# Newsboat Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
auto-reload yes
reload-time 30
reload-threads 4
download-retries 2
download-timeout 10
prepopulate-query-feeds yes
confirm-exit no
cleanup-on-quit no

# -----------------------------------------------------------------------------
# Display Settings
# -----------------------------------------------------------------------------
show-read-feeds no
show-read-articles no
feed-sort-order unreadarticlecount-asc
article-sort-order date-desc
text-width 80
datetime-format "%m/%d"
pager internal

# -----------------------------------------------------------------------------
# Feed & Article List Formats
# -----------------------------------------------------------------------------
feedlist-format     "%4i %n %3U %t"
articlelist-format  "%4i %f %D   %?T?|%-17T|  ?%t"

# -----------------------------------------------------------------------------
# Notifications
# -----------------------------------------------------------------------------
notify-always no
notify-format "Newsboat: %n new articles (%f feeds)"
notify-program ""

# -----------------------------------------------------------------------------
# Unbind Default Keys
# -----------------------------------------------------------------------------
unbind-key R
unbind-key j
unbind-key k
unbind-key J
unbind-key K
unbind-key C
unbind-key ,
unbind-key v

# -----------------------------------------------------------------------------
# Key Bindings (Vim-style)
# -----------------------------------------------------------------------------
bind-key SPACE macro-prefix

# Toggle Display
bind-key U toggle-show-read-feeds

# Navigation
bind-key j down
bind-key k up
bind-key g home
bind-key G end
bind-key j next articlelist
bind-key k prev articlelist
bind-key J next-feed articlelist
bind-key K prev-feed articlelist
bind-key J next article
bind-key K prev article

# Open & Close
bind-key l open
bind-key h quit articlelist
bind-key h quit article

# Reload
bind-key ^R reload-all

# Read/Unread Operations
bind-key m toggle-article-read
bind-key a mark-feed-read
bind-key o open-in-browser-and-mark-read

# -----------------------------------------------------------------------------
# Macros (press SPACE then macro key)
# -----------------------------------------------------------------------------
# Sort feeds by unread count and jump to top
macro g set feed-sort-order unreadarticlecount-asc ; home

# -----------------------------------------------------------------------------
# Filters
# -----------------------------------------------------------------------------
# Ignore sponsored content (example)
# ignore-article "*" "title =~ \"[Ss]ponsored\""
# ignore-article "*" "title =~ \"[Aa]dvertisement\""

# -----------------------------------------------------------------------------
# Podcast Support
# -----------------------------------------------------------------------------
download-path "~/.config/newsboat/download/podcasts/%n"
max-downloads 3

# -----------------------------------------------------------------------------
# Platform-specific Configuration (auto-linked by fish function)
# Available: conf/platform/{osx,nix,wsl,win}
# -----------------------------------------------------------------------------
include "~/.config/newsboat/local/platform"

# -----------------------------------------------------------------------------
# Theme
# -----------------------------------------------------------------------------
include "~/.config/newsboat/local/theme"
