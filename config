config-file = local/theme
config-file = keymap-unbind
config-file = keymap

# Font
font-size = 15
font-family = "Maple Mono NF CN"
font-style = Regular
font-family-bold = "Maple Mono NF CN"
font-style-bold = Bold
font-family-italic = "Maple Mono NF CN"
font-style-italic = Italic
font-family-bold-italic = "Maple Mono NF CN"
font-style-bold-italic = Bold Italic
font-feature = +cv61 +cv62 +cv66 +cv98 +ss03 +ss07 +ss09 +ss10 +calt

# General behavior
copy-on-select = true
link-url = true

# Scrollback
scrollback-limit = 10000

# Window settings
window-decoration = none
window-width = 1600
window-height = 1000
window-padding-x = 0
window-padding-y = 0

# Cursor
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
