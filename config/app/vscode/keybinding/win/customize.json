[
  {
    "key": "alt+ctrl+down",
    "command": "workbench.action.moveEditorToBelowGroup",
    "when": "!panelFocus"
  },
  {
    "key": "alt+ctrl+left",
    "command": "workbench.action.moveEditorToLeftGroup",
    "when": "!panelFocus"
  },
  {
    "key": "alt+ctrl+right",
    "command": "workbench.action.moveEditorToRightGroup",
    "when": "editorFocus"
  },
  {
    "key": "alt+ctrl+up",
    "command": "workbench.action.moveEditorToAboveGroup",
    "when": "!panelFocus"
  },
  {
    "key": "alt+ctrl+/",
    "command": "workbench.action.terminal.new",
    "when": "terminalFocus"
  },
  {
    "key": "alt+ctrl+/",
    "command": "editor.action.blockComment",
    "when": "!terminalFocus && editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+ctrl+f",
    "command": "editor.action.formatSelection",
    "when": "editorHasDocumentFormattingProvider && editorHasSelection && editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+ctrl+f",
    "command": "editor.action.formatDocument",
    "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+ctrl+z",
    "command": "workbench.action.toggleMaximizedPanel",
    "when": "panelFocus"
  },
  {
    "key": "alt+ctrl+z",
    "command": "workbench.action.minimizeOtherEditors",
    "when": "!panelFocus"
  },
  {
    "key": "alt+shift+;",
    "command": "workbench.action.showCommands"
  },
  {
    "key": "alt+shift+h",
    "command": "workbench.action.splitEditorLeft",
    "when": "editorFocus"
  },
  {
    "key": "alt+shift+k",
    "command": "workbench.action.closeEditorsInGroup"
  },
  {
    "key": "alt+shift+l",
    "command": "workbench.action.splitEditorRight",
    "when": "editorFocus"
  },
  {
    "key": "alt+shift+o",
    "command": "workbench.action.closeOtherEditors"
  },
  {
    "key": "alt+enter",
    "command": "editor.action.quickFix",
    "when": "editorHasCodeActionsProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "alt+left",
    "command": "workbench.action.decreaseViewSize"
  },
  {
    "key": "alt+,",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus"
  },
  {
    "key": "alt+.",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus"
  },
  {
    "key": "alt+right",
    "command": "workbench.action.increaseViewSize"
  },
  {
    "key": "alt+0",
    "command": "workbench.action.toggleActivityBarVisibility",
    "title": "view: toggle settings"
  },
  {
    "key": "alt+1",
    "command": "workbench.view.explorer",
    "title": "view: focus explorer"
  },
  {
    "key": "alt+1",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.explorer'",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+2",
    "command": "workbench.view.search",
    "title": "view: focus search"
  },
  {
    "key": "alt+2",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.search'",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+3",
    "command": "workbench.view.scm",
    "title": "view: focus scm"
  },
  {
    "key": "alt+3",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.scm'",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+4",
    "command": "workbench.view.extensions",
    "title": "view: focus extensions"
  },
  {
    "key": "alt+4",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.extensions'",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+5",
    "command": "workbench.view.debug",
    "title": "view: focus debug"
  },
  {
    "key": "alt+5",
    "command": "workbench.action.closeSidebar",
    "when": "sideBarFocus && activeViewlet == 'workbench.view.debug'",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+6",
    "command": "gitlens.views.fileHistory.focus",
    "title": "view: focus gitlens (file history)"
  },
  {
    "key": "alt+6",
    "command": "workbench.action.closeSidebar",
    "when": "focusedView =~ /gitlens/i",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+7",
    "command": "workbench.action.chat.focusInput",
    "title": "view: focus github copilot chat input"
  },
  {
    "key": "alt+7",
    "command": "workbench.panel.chat.view.copilot.focus",
    "when": "!view.workbench.panel.chat.view.copilot.active",
    "title": "view: open github copilot chat"
  },
  {
    "key": "alt+7",
    "command": "workbench.panel.chat",
    "when": "inChat && inChatInput",
    "title": "view: close chat"
  },
  {
    "key": "alt+8",
    "command": "roo-cline.SidebarProvider.focus",
    "title": "view: show roo-code"
  },
  {
    "key": "alt+8",
    "command": "workbench.action.closeSidebar",
    "when": "focusedView =~ /roo[- ](code|cline)/i",
    "title": "view: close sidebar"
  },
  {
    "key": "alt+[",
    "command": "workbench.action.previousEditorInGroup",
    "when": "editorFocus || (!panelFocus && !sideBarFocus)",
    "title": "editor: focus left"
  },
  {
    "key": "alt+[",
    "command": "workbench.action.previousPanelView",
    "when": "panelFocus",
    "title": "pane: focus left"
  },
  {
    "key": "alt+]",
    "command": "workbench.action.nextEditorInGroup",
    "when": "editorFocus || (!panelFocus && !sideBarFocus)",
    "title": "editor: focus right"
  },
  {
    "key": "alt+]",
    "command": "workbench.action.nextPanelView",
    "when": "panelFocus",
    "title": "pane: focus right"
  },
  {
    "key": "alt+`",
    "command": "workbench.action.togglePanel"
  },
  {
    "key": "alt+a",
    "command": "editor.action.selectAll"
  },
  {
    "key": "alt+c",
    "command": "editor.action.clipboardCopyAction"
  },
  {
    "key": "alt+d",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "alt+h",
    "command": "workbench.action.navigateLeft"
  },
  {
    "key": "alt+i",
    "command": "workbench.action.navigateBack",
    "when": "editorTextFocus",
    "title": "editor: history back"
  },
  {
    "key": "alt+j",
    "command": "workbench.action.navigateDown"
  },
  {
    "key": "alt+k",
    "command": "workbench.action.navigateUp"
  },
  {
    "key": "alt+l",
    "command": "workbench.action.navigateRight"
  },
  {
    "key": "alt+m",
    "command": "editor.action.toggleMinimap"
  },
  {
    "key": "alt+o",
    "command": "workbench.action.navigateForward",
    "when": "editorTextFocus",
    "title": "editor: history forward"
  },
  {
    "key": "alt+r",
    "command": "revealInExplorer"
  },
  {
    "key": "alt+s",
    "command": "workbench.action.files.save"
  },
  {
    "key": "alt+t",
    "command": "workbench.action.terminal.toggleTerminal",
    "when": "terminal.active"
  },
  {
    "key": "alt+t",
    "command": "openInTerminal",
    "when": "!terminal.active"
  },
  {
    "key": "alt+v",
    "command": "editor.action.clipboardPasteAction",
    "when": "editorTextFocus"
  },
  {
    "key": "alt+v",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "alt+v",
    "command": "workbench.action.terminal.paste",
    "when": "terminalFocus && terminalHasBeenCreated || terminalFocus && terminalProcessSupported"
  },
  {
    "key": "alt+w",
    "command": "workbench.action.closeActiveEditor",
    "when": "editorFocus || (!panelFocus && !sideBarFocus && !terminalFocus)",
    "title": "editor: close current active"
  },
  {
    "key": "alt+z",
    "command": "workbench.action.evenEditorWidths"
  },
  {
    "key": "ctrl+shift+c",
    "command": "editor.action.commentLine",
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+h",
    "command": "workbench.action.splitEditorLeft",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+i",
    "command": "workbench.action.toggleDevTools"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.splitEditorDown",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.splitEditorUp",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.splitEditorRight",
    "when": "editorFocus"
  },
  {
    "key": "ctrl+p",
    "command": "editor.action.triggerSuggest",
    "when": "editorHasCompletionItemProvider && textInputFocus && !editorReadonly"
  },
  {
    "key": "ctrl+p",
    "command": "toggleSuggestionDetails",
    "when": "suggestWidgetVisible && textInputFocus"
  },
  {
    "key": "ctrl+p",
    "command": "editor.action.triggerParameterHints",
    "when": "editorHasSignatureHelpProvider && editorTextFocus"
  },
  {
    "key": "f2",
    "command": "editor.action.rename",
    "when": "editorHasRenameProvider && editorTextFocus && !editorReadonly"
  },
  {
    "key": "f2",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  }
]
