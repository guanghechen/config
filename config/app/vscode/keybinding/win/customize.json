[
  {
    "key": "alt+0",
    "command": "workbench.action.toggleActivityBarVisibility",
    "title": "view: toggle settings"
  },
  {
    "key": "alt+1",
    "command": "workbench.view.explorer",
    "when": "viewContainer.workbench.view.explorer.enabled",
    "title": "view: show explorer"
  },
  {
    "key": "alt+2",
    "command": "workbench.view.search",
    "when": "workbench.view.search.active",
    "title": "view: show search"
  },
  {
    "key": "alt+3",
    "command": "workbench.view.scm",
    "when": "workbench.scm.active",
    "title": "view: show source control"
  },
  {
    "key": "alt+4",
    "command": "workbench.view.extensions",
    "when": "viewContainer.workbench.view.extensions.enabled",
    "title": "view: show extensions"
  },
  {
    "key": "alt+5",
    "command": "workbench.view.debug",
    "when": "viewContainer.workbench.view.debug.enabled",
    "title": "view: show run and debug"
  },
  {
    "key": "alt+6",
    "command": "workbench.view.extension.gitlens",
    "title": "view: show gitlens"
  },
  {
    "key": "alt+7",
    "command": "workbench.action.chat.open",
    "title": "view: open github copilot"
  },
  {
    "key": "alt+`",
    "command": "workbench.action.togglePanel"
  },
  {
