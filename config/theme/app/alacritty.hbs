# {{variant ? `${theme}-${variant}` : theme}}

# Primary colors
[colors.primary]
background  = "{{unified.bg0}}"
foreground  = "{{unified.fg1}}"

# Cursor colors
[colors.cursor]
cursor      = "{{unified.pink}}"
text        = "{{unified.bg1}}"

# Selection colors
[colors.selection]
background  = "{{unified.orange}}"
text        = "{{unified.bg1}}"

# Normal colors
[colors.normal]
black       = "{{unified.bg0}}"
red         = "{{unified.red}}"
green       = "{{unified.green}}"
yellow      = "{{unified.yellow}}"
blue        = "{{unified.blue}}"
magenta     = "{{unified.purple}}"
cyan        = "{{unified.aqua}}"
white       = "{{unified.fg4}}"

# Bright colors
[colors.bright]
black       = "{{unified.grey}}"
red         = "{{unified.brightRed}}"
green       = "{{unified.brightGreen}}"
yellow      = "{{unified.brightYellow}}"
blue        = "{{unified.brightBlue}}"
magenta     = "{{unified.brightPurple}}"
cyan        = "{{unified.brightAqua}}"
white       = "{{unified.fg1}}"

