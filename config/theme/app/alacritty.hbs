# {{theme}}

# Primary colors
[colors.primary]
background  = "{{bg0}}"
foreground  = "{{fg1}}"

# Cursor colors
[colors.cursor]
cursor      = "{{pink}}"
text        = "{{bg1}}"

# Selection colors
[colors.selection]
background  = "{{orange}}"
text        = "{{bg1}}"

# Normal colors
[colors.normal]
black       = "{{bg0}}"
red         = "{{red}}"
green       = "{{green}}"
yellow      = "{{yellow}}"
blue        = "{{blue}}"
magenta     = "{{purple}}"
cyan        = "{{aqua}}"
white       = "{{fg4}}"

# Bright colors
[colors.bright]
black       = "{{grey}}"
red         = "{{brightRed}}"
green       = "{{brightGreen}}"
yellow      = "{{brightYellow}}"
blue        = "{{brightBlue}}"
magenta     = "{{brightPurple}}"
cyan        = "{{brightAqua}}"
white       = "{{fg1}}"

