# Default colors
[colors.primary]
background = "{{bg0}}"
foreground = "{{fg1}}"

# Normal colors
[colors.normal]
black   = "{{bg0}}"
red     = "{{neutral_red}}"
green   = "{{neutral_green}}"
yellow  = "{{neutral_yellow}}"
blue    = "{{neutral_blue}}"
magenta = "{{neutral_purple}}"
cyan    = "{{neutral_aqua}}"
white   = "{{fg4}}"

# Bright colors
[colors.bright]
black   = "{{fg4}}"
red     = "{{red}}"
green   = "{{green}}"
yellow  = "{{yellow}}"
blue    = "{{blue}}"
magenta = "{{purple}}"
cyan    = "{{aqua}}"
white   = "{{fg1}}"
