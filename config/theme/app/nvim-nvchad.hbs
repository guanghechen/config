---@type std.t.theme.IScheme
local M = {
  theme = "{{theme}}",
  variant = {{variant ? `"${variant}"` : "nil"}},
  opposite = {{opposite ? `"${opposite}"` : "nil"}},
  darken = {{darken ? "true" : "false"}},
  -- stylua: ignore start
  palette = {
    unified = {
      none          = "none",

      bg0           = "{{unified.bg0}}",
      bg1           = "{{unified.bg1}}",
      bg2           = "{{unified.bg2}}",
      bg3           = "{{unified.bg3}}",
      bg4           = "{{unified.bg4}}",

      fg0           = "{{unified.fg0}}",
      fg1           = "{{unified.fg1}}",
      fg2           = "{{unified.fg2}}",
      fg3           = "{{unified.fg3}}",
      fg4           = "{{unified.fg4}}",

      red           = "{{unified.red}}",
      green         = "{{unified.green}}",
      yellow        = "{{unified.yellow}}",
      blue          = "{{unified.blue}}",
      purple        = "{{unified.purple}}",
      aqua          = "{{unified.aqua}}",
      orange        = "{{unified.orange}}",

      brightRed     = "{{unified.brightRed}}",
      brightGreen   = "{{unified.brightGreen}}",
      brightYellow  = "{{unified.brightYellow}}",
      brightBlue    = "{{unified.brightBlue}}",
      brightPurple  = "{{unified.brightPurple}}",
      brightAqua    = "{{unified.brightAqua}}",
      brightOrange  = "{{unified.brightOrange}}",

      grey          = "{{unified.grey}}",
      pink          = "{{unified.pink}}",

      diffDel       = "{{unified.diffDel}}",
      diffDelInline = "{{unified.diffDelInline}}",
      diffAdd       = "{{unified.diffAdd}}",
      diffAddInline = "{{unified.diffAddInline}}",
    },
    {{Object.entries(palette).map(([theme, colors]) => `${theme} = {\n      none          = "none",\n\n` +  Object.entries(colors).map(([k, v]) => `      ${k.padEnd(13, ' ')} = "${v}",`).join('\n') + '\n    },').join('\n')}}
  },
  -- stylua: ignore end
}

return M
