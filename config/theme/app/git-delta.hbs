# https://github.com/dandavison/delta/blob/main/themes.gitconfig
# {{name}}

[delta]
hunk-header-style             = raw
hunk-header-decoration-style  = ul
hyperlinks                    = true
hyperlinks-file-link-format   = file://{path}:{line}
detect-dark-light             = auto
line-numbers                  = true
navigate                      = true    # use n and N to move between diff sections
paging                        = never
side-by-side                  = true

\\\
{{darken ? "dark                          = true" : "light                         = true"}}
syntax-theme                  = {{name}}
plus-style                    = syntax "{{unified.diffAdd}}"
plus-emph-style               = syntax "{{unified.diffAddInline}}" bold
plus-non-emph-style           = syntax "{{unified.diffAdd}}" bold
minus-style                   = syntax "{{unified.diffDel}}"
minus-emph-style              = syntax "{{unified.diffDelInline}}" bold
minus-non-emph-style          = syntax "{{unified.diffDel}}" bold
line-numbers-left-style       = "{{unified.fg1}}"
line-numbers-right-style      = "{{unified.fg1}}"
line-numbers-minus-style      = "{{unified.fg0}}" "{{unified.diffDel}}" bold
line-numbers-plus-style       = "{{unified.fg0}}" "{{unified.diffAdd}}" bold
true-color                    = always

