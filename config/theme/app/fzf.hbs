# {{name}}

--border=rounded
--color="fg:{{unified.brightAqua}},bg:{{unified.bg0}},hl:{{unified.orange}}"
--color="fg+:{{unified.brightAqua}},bg+:{{unified.bg0}},hl+:{{unified.orange}}"
--color="info:{{unified.brightBlue}},prompt:{{unified.brightAqua}},pointer:{{unified.brightAqua}}"
--color="marker:{{unified.brightGreen}},spinner:{{unified.brightGreen}},header:{{unified.brightGreen}}"
--height="40%"
--info=inline-right
--layout=reverse
--multi
--preview='bat --line-range=:500 --style=snip --theme={{name}} --number --color=always {} || cat -n {}'
