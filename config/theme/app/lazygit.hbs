# {{name}}

gui:
  authorColors:
    guanghechen: '{{vsc?.textLink_foreground || unified.blue}}'
    '*': '{{unified.fg2}}'
  branchColorPatterns:
    "^(main|master)$": '{{vsc?.tokenControlFlowSpecialKeywords || unified.purple}}'
    "^(user/[^/]+/)?fix": '{{vsc?.editorGutter_deletedBackground || unified.red}}'
    "^(user/[^/]+/)?feat": '{{vsc?.editorGutter_addedBackground || unified.green}}'
    "^(user/[^/]+/)?feature": '{{vsc?.editorGutter_addedBackground || unified.green}}'
    "^(user/[^/]+/)?release": '{{vsc?.editorGutter_modifiedBackground || unified.blue}}'
  theme:
    activeBorderColor:
      - '{{vsc?.tokenControlFlowSpecialKeywords || unified.purple}}'
      - bold
    cherryPickedCommitBgColor:
      - '{{vsc?.tokenTypesDeclarationAndReferences || unified.aqua}}'
    cherryPickedCommitFgColor:
      - '{{vsc?.editorGutter_modifiedBackground || unified.blue}}'
    defaultFgColor:
      - '{{unified.fg2}}'
    inactiveBorderColor:
      - '{{unified.fg4}}'
    inactiveViewSelectedLineBgColor:
      - '{{vsc?.editor_inactiveSelectionBackground || unified.bg3}}'
      - bold
    markedBaseCommitBgColor:
      - '{{vsc?.tokenControlFlowSpecialKeywords || unified.purple}}'
    markedBaseCommitFgColor:
      - '{{vsc?.editorGutter_addedBackground || unified.green}}'
    optionsTextColor:
      - '{{vsc?.tokenFunctionDeclarations || unified.orange}}'
    searchingActiveBorderColor:
      - '{{vsc?.focusBorder || unified.blue}}'
    selectedLineBgColor:
      - '{{vsc?.subtle || unified.bg2}}'
    unstagedChangesColor:
      - '{{vsc?.editorGutter_deletedBackground || unified.red}}'

git:
  pagers:
    - colorArg: always
      pager: delta --paging=never --{{darken ? 'dark' : 'light'}}

