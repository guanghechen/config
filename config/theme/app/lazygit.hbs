# {{name}}

gui:
  authorColors:
    guanghechen: 'blue'
    '*': '{{unified.fg2}}'
  branchColors:
    main: 'blue'
  theme:
    defaultFgColor:
      - '{{unified.fg2}}'
    activeBorderColor:
      - 'magenta'
      - bold
    inactiveBorderColor:
      - '{{unified.fg4}}'
    optionsTextColor:
      -  '{{unified.orange}}'
    selectedLineBgColor:
      - '{{unified.bg2}}'
    cherryPickedCommitFgColor:
      - 'blue'
    cherryPickedCommitBgColor:
      - 'cyan'
    markedBaseCommitFgColor:
      - 'green'
    markedBaseCommitBgColor:
      - 'magenta'
    searchingActiveBorderColor:
      - 'blue'
    unstagedChangesColor:
      - 'red'

git:
  paging:
    colorArg: always
    useConfig: false
    pager: delta \\\
      --paging=never \\\
      --side-by-side \\\
      --{{darken ? 'dark' : 'light'}}\\\
      {{theme === 'gruvbox' ? ` --syntax-theme='gruvbox-${darken ? 'dark' : 'light'}'` : ''}}\\\
      {{theme === 'nord'    ? ' --syntax-theme=nord' : ''}}\\\
      {{theme == 'onehalf'  ? ` --syntax-theme='${darken ? 'OneHalfDark' : 'OneHalfLight'}'` : ''}}\\\

