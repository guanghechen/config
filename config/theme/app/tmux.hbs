# Basic
set -g @GHC_TMUX_THEME                  "{{theme}}"
set -g @GHC_SL_COLOR_BG                 "default"

## MESSAGE
set -g @GHC_SL_COLOR_BG_MESSAGE         "{{yellow}}"
set -g @GHC_SL_COLOR_FG_MESSAGE         "{{bg1}}"

## BORDER
set -g @GHC_SL_COLOR_BORDER             "{{bg4}}"
set -g @GHC_SL_COLOR_BORDER_CUR         "{{orange}}"

# Component

## APP
set -g @GHC_SL_COLOR_BG_APP_SYM         "{{purple}}"
set -g @GHC_SL_COLOR_FG_APP_SYM         "{{bg1}}"
set -g @GHC_SL_COLOR_BG_APP_TEXT        "{{bg1}}"
set -g @GHC_SL_COLOR_FG_APP_TEXT        "{{fg2}}"

## PID
set -g @GHC_SL_COLOR_BG_PID_SYM         "{{blue}}"
set -g @GHC_SL_COLOR_FG_PID_SYM         "{{bg1}}"
set -g @GHC_SL_COLOR_BG_PID_TEXT        "{{bg1}}"
set -g @GHC_SL_COLOR_FG_PID_TEXT        "{{fg2}}"

## TIME
set -g @GHC_SL_COLOR_BG_TIME_SYM        "{{blue}}"
set -g @GHC_SL_COLOR_FG_TIME_SYM        "{{bg1}}"
set -g @GHC_SL_COLOR_BG_TIME_TEXT       "{{bg1}}"
set -g @GHC_SL_COLOR_FG_TIME_TEXT       "{{fg2}}"

## DATE
set -g @GHC_SL_COLOR_BG_DATE_SYM        "{{blue}}"
set -g @GHC_SL_COLOR_FG_DATE_SYM        "{{bg1}}"
set -g @GHC_SL_COLOR_BG_DATE_TEXT       "{{bg1}}"
set -g @GHC_SL_COLOR_FG_DATE_TEXT       "{{fg2}}"

## SESSION
set -g @GHC_SL_COLOR_BG_SESSION         "{{bg1}}"
set -g @GHC_SL_COLOR_FG_SESSION         "{{pink}}"

## USER
set -g @GHC_SL_COLOR_BG_USER            "{{blue}}"
set -g @GHC_SL_COLOR_FG_USER            "{{bg1}}"

## WINDOW
set -g @GHC_SL_COLOR_BG_WIN_NAME        "{{bg2}}"
set -g @GHC_SL_COLOR_FG_WIN_NAME        "{{fg3}}"
set -g @GHC_SL_COLOR_BG_WIN_NUM         "{{bg4}}"
set -g @GHC_SL_COLOR_FG_WIN_NUM         "{{fg3}}"

## WINDOW_CURRENT
set -g @GHC_SL_COLOR_BG_WIN_CUR_NAME    "{{bg1}}"
set -g @GHC_SL_COLOR_FG_WIN_CUR_NAME    "{{fg1}}"
set -g @GHC_SL_COLOR_BG_WIN_CUR_NUM     "{{purple}}"
set -g @GHC_SL_COLOR_FG_WIN_CUR_NUM     "{{bg1}}"

