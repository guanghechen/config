## WINDOW_CURRENT
set -g @GHC_SL_COLOR_BG_WIN_CUR_NAME    "default"
set -g @GHC_SL_COLOR_FG_WIN_CUR_NAME    "{{fg1}}"
set -g @GHC_SL_COLOR_BG_WIN_CUR_NUM     "{{orange}}"
set -g @GHC_SL_COLOR_FG_WIN_CUR_NUM     "{{bg2}}"

