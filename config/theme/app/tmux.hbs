##  {{theme}}

# Basic
set -g @GHC_SL_COLOR_BG                 "default"

## MESSAGE
set -g @GHC_SL_COLOR_BG_MESSAGE         "{{yellow}}"
set -g @GHC_SL_COLOR_FG_MESSAGE         "{{bg0}}"

## BORDER
set -g @GHC_SL_COLOR_BORDER             "{{bg4}}"
set -g @GHC_SL_COLOR_BORDER_CUR         "{{purple}}"

# Component

## APP
set -g @GHC_SL_COLOR_BG_APP_SYM         "{{brightBlue}}"
set -g @GHC_SL_COLOR_FG_APP_SYM         "{{bg0}}"
set -g @GHC_SL_COLOR_BG_APP_TEXT        "{{bg0}}"
