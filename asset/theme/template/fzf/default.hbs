# {{name}}

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"
--gutter=" "

--color="{{darken ? 'dark' : 'light'}}"
--color="fg:{{unified.fg1}},bg:-1,hl:{{rosepine ? unified.aqua : gruvbox ? unified.brightOrange : unified.orange}}"
--color="fg+:{{unified.fg1}},bg+:{{rosepine?.highlightMed || unified.bg3}},hl+:{{unified.fg1}}:bold:underline"
--color="border:{{rosepine?.highlightHigh || unified.bg4}},header:{{unified.fg2}},label:{{unified.fg2}},gutter:-1"
--color="spinner:{{rosepine ? unified.aqua : unified.purple}},info:{{darken || gruvbox ? unified.brightBlue : unified.blue}}"
--color="pointer:{{kanagawa ? unified.yellow : rosepine ? unified.aqua : unified.purple}},marker:{{kanagawa ? unified.purple : unified.blue}},prompt:{{kanagawa ? unified.blue : rosepine ? unified.aqua : unified.purple}},query:{{unified.fg1}}"
--color="preview-fg:{{unified.fg1}},preview-bg:-1,preview-border:{{rosepine?.highlightHigh || unified.bg4}}"
--preview='bat --line-range=:500 --style=snip --theme={{name}} --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
{{IS_OSX && "--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'" || ""}}
{{IS_WIN && "--bind 'ctrl-y:execute-silent(echo {+} | clip.exe)+bell'" || ""}}
{{IS_WSL && "--bind 'ctrl-y:execute-silent(echo {+} | clip.exe)+bell'" || ""}}
