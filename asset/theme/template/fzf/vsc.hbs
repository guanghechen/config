# {{name}}

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"

--color="fg+:{{vsc.foreground}},bg+:{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}},hl+:{{vsc.accentPink}}"
--color="fg:{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}},bg:{{vsc.editor_background}},hl:{{vsc.accentYellow}}"
--color="gutter:{{vsc.editor_background}},pointer:{{vsc.accentPink}},spinner:{{vsc.accentBlue}}"
--color="info:{{vsc.brightBlue}},prompt:{{vsc.brightGreen}},marker:{{vsc.accentPink}},query:{{vsc.foreground}}"
--preview='bat --line-range=:500 --style=snip --theme={{name}} --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
{{IS_OSX && "--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'" || ""}}
{{IS_WIN && "--bind 'ctrl-y:execute-silent(echo {+} | clip.exe)+bell'" || ""}}
{{IS_WSL && "--bind 'ctrl-y:execute-silent(echo {+} | clip.exe)+bell'" || ""}}
