# {{name}}

--cycle
--highlight-line
--multi
--smart-case
--padding=0
--margin=0
--border=rounded
--layout=reverse
--info=right
--info-command='echo "$FZF_POS/$FZF_MATCH_COUNT/$FZF_TOTAL_COUNT"'
--pointer=""
--marker="▎"
--scrollbar="┃"
--gutter=" "

--color="{{darken ? 'dark' : 'light'}}"
--color="fg:{{vsc.foreground}},bg:-1,hl:{{vsc.accentOrange}}"
--color="fg+:{{vsc.foreground}},bg+:{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}},hl+:{{vsc.foreground}}:bold:underline"
--color="border:{{(darken ? vsc.menu_border : vsc.badge_background)}},header:{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}},label:{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}},gutter:-1"
--color="spinner:{{vsc.accentPurple}},info:{{(darken ? vsc.brightBlue : vsc.accentBlue)}}"
--color="pointer:{{vsc.accentPurple}},marker:{{vsc.accentBlue}},prompt:{{vsc.accentPurple}},query:{{vsc.foreground}}"
--color="preview-fg:{{vsc.foreground}},preview-bg:-1,preview-border:{{(darken ? vsc.menu_border : vsc.badge_background)}}"
--preview='bat --line-range=:500 --style=snip --theme={{name}} --number --color=always {} || cat -n {}'

--bind 'ctrl-a:toggle-all'
--bind 'ctrl-s:toggle-sort'
--bind 'ctrl-p:toggle-preview'
--bind 'ctrl-l:clear-query'
--bind 'ctrl-b:preview-half-page-up'
--bind 'ctrl-f:preview-half-page-down'
--bind 'ctrl-o:execute(nvim {+} < /dev/tty)'
{{IS_OSX && "--bind 'ctrl-y:execute-silent(echo {+} | pbcopy)+bell'" || ""}}
{{IS_WIN && "--bind 'ctrl-y:execute-silent(echo {+} | clip.exe)+bell'" || ""}}
{{IS_WSL && "--bind 'ctrl-y:execute-silent(echo {+} | clip.exe)+bell'" || ""}}
