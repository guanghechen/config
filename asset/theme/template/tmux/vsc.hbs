# {{name}}

set -g @GHC_SL_BG                       "default"
set -g @GHC_PSL_BG                      "default"

## Cmdline
set -g @GHC_SL_BG_CMDLINE               "{{vsc.brightAqua}}"
set -g @GHC_SL_FG_CMDLINE               "{{vsc.overlay}}"
set -g prompt-cursor-colour             "{{vsc.accentOrange}}"

## Message
set -g @GHC_SL_BG_MESSAGE               "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}"
set -g @GHC_SL_FG_MESSAGE               "{{vsc.foreground}}"

## Menu
set -g @GHC_MENU_BG                     "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}"
set -g @GHC_MENU_FG                     "{{vsc.foreground}}"
set -g @GHC_MENU_BG_SELECTED            "{{vsc.accentPink}}"
set -g @GHC_MENU_FG_SELECTED            "{{vsc.editor_background}}"

## Copy Mode
set -g @GHC_SL_BG_COPY_MODE             "{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"
set -g @GHC_SL_FG_COPY_MODE             "{{vsc.foreground}}"
set -g @GHC_SL_BG_COPY_MODE_MATCH       "{{vsc.accentYellow}}"
set -g @GHC_SL_FG_COPY_MODE_MATCH       "{{vsc.editor_background}}"
set -g @GHC_SL_BG_COPY_MODE_CUR_MATCH   "{{vsc.accentOrange}}"
set -g @GHC_SL_FG_COPY_MODE_CUR_MATCH   "{{vsc.editor_background}}"
set -g @GHC_SL_BG_COPY_MODE_MARK        "{{vsc.brightPurple}}"
set -g @GHC_SL_FG_COPY_MODE_MARK        "{{vsc.editor_background}}"
set -g @GHC_SL_BG_COPY_MODE_POS         "{{vsc.accentYellow}}"
set -g @GHC_SL_FG_COPY_MODE_POS         "{{vsc.editor_background}}"
set -g @GHC_SL_BG_COPY_MODE_SEL         "{{vsc.accentAqua}}"
set -g @GHC_SL_FG_COPY_MODE_SEL         "{{vsc.editor_background}}"

## Pane
set -g @GHC_PANE_BG                     "{{vsc.overlay}}"
set -g @GHC_PANE_BG_ACTIVE              "{{vsc.editor_background}}"

set -g @GHC_PSL_FG_BORDER               "{{(darken ? vsc.menu_border : vsc.badge_background)}}"
set -g @GHC_PSL_FG_BORDER_CUR           "{{vsc.accentPink}}"

set -g @GHC_PSL_BG_SYM                  "default"
set -g @GHC_PSL_FG_SYM                  "{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}"
set -g @GHC_PSL_BG_TXT                  "default"
set -g @GHC_PSL_FG_TXT                  "{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}"

set -g @GHC_PSL_BG_SYM_ACTIVE           "default"
set -g @GHC_PSL_FG_SYM_ACTIVE           "{{vsc.accentPink}}"
set -g @GHC_PSL_BG_TXT_ACTIVE           "default"
set -g @GHC_PSL_FG_TXT_ACTIVE           "{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}}"

set -g @GHC_PSL_BG_COPY_MODE            "default"
set -g @GHC_PSL_FG_COPY_MODE            "{{vsc.brightYellow}}"

set -g @GHC_PSL_FG_PANE_ID              "{{vsc.brightAqua}}"
set -g @GHC_PSL_FG_PANE_INDEX           "{{vsc.brightOrange}}"
set -g @GHC_PSL_FG_MARKER               "{{vsc.brightPurple}}"

