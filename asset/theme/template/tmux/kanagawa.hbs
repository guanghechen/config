set -g @GHC_SL_FG_SESSION_ITEM_NAME     "{{unified.fg2}}"
set -g @GHC_SL_BG_SESSION_ITEM_NUM      "{{unified.bg3}}"
set -g @GHC_SL_FG_SESSION_ITEM_NUM      "{{unified.fg1}}"
set -g @GHC_SL_FG_SESSION_ITEM_LAST     "{{unified.yellow}}"
