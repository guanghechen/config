# {{name}}

set -g @GHC_SL_BG                       "{{unified.bg1}}"
set -g @GHC_PSL_BG                      "{{unified.bg0}}"

## Cmdline
# Both vi prompt modes share the cursor color, so keep their backgrounds neutral.
set -g @GHC_SL_BG_CMDLINE               "{{unified.bg3}}"
set -g @GHC_SL_FG_CMDLINE               "{{unified.fg1}}"
set -g prompt-cursor-colour             "{{unified.yellow}}"

## Message
set -g @GHC_SL_BG_MESSAGE               "{{unified.bg1}}"
set -g @GHC_SL_FG_MESSAGE               "{{unified.fg1}}"

## Popup
set -g @GHC_POPUP_BG                    "{{unified.bg0}}"
set -g @GHC_POPUP_FG                    "{{unified.fg1}}"
set -g @GHC_POPUP_FG_BORDER             "{{unified.fg2}}"

## Menu
set -g @GHC_MENU_BG                     "{{unified.bg2}}"
set -g @GHC_MENU_FG                     "{{unified.fg1}}"
set -g @GHC_MENU_BG_SELECTED            "{{unified.bg3}}"
set -g @GHC_MENU_FG_SELECTED            "{{unified.fg1}}"

## Copy Mode
set -g @GHC_SL_BG_COPY_MODE             "{{unified.bg3}}"
set -g @GHC_SL_FG_COPY_MODE             "{{unified.fg1}}"
set -g @GHC_SL_BG_COPY_MODE_MATCH       "{{unified.yellow}}"
set -g @GHC_SL_FG_COPY_MODE_MATCH       "{{unified.bg0}}"
set -g @GHC_SL_BG_COPY_MODE_CUR_MATCH   "{{unified.orange}}"
set -g @GHC_SL_FG_COPY_MODE_CUR_MATCH   "{{unified.bg0}}"
set -g @GHC_SL_BG_COPY_MODE_MARK        "{{unified.purple}}"
set -g @GHC_SL_FG_COPY_MODE_MARK        "{{unified.bg0}}"
set -g @GHC_SL_BG_COPY_MODE_POS         "{{unified.yellow}}"
set -g @GHC_SL_FG_COPY_MODE_POS         "{{unified.bg0}}"
set -g @GHC_SL_BG_COPY_MODE_SEL         "{{unified.bg3}}"
set -g @GHC_SL_FG_COPY_MODE_SEL         "{{unified.fg1}}"

## Pane
set -g @GHC_PANE_BG                     "{{unified.bg1}}"
set -g @GHC_PANE_BG_ACTIVE              "{{unified.bg0}}"

set -g @GHC_PSL_FG_BORDER               "{{unified.bg4}}"
set -g @GHC_PSL_FG_BORDER_CUR           "{{unified.blue}}"

set -g @GHC_PSL_BG_SYM                  "default"
set -g @GHC_PSL_FG_SYM                  "{{unified.fg2}}"
set -g @GHC_PSL_BG_TXT                  "default"
set -g @GHC_PSL_FG_TXT                  "{{unified.fg2}}"

set -g @GHC_PSL_BG_SYM_ACTIVE           "default"
set -g @GHC_PSL_FG_SYM_ACTIVE           "{{unified.blue}}"
set -g @GHC_PSL_BG_TXT_ACTIVE           "default"
set -g @GHC_PSL_FG_TXT_ACTIVE           "{{unified.fg1}}"

set -g @GHC_PSL_BG_COPY_MODE            "default"
set -g @GHC_PSL_FG_COPY_MODE            "{{unified.yellow}}"

set -g @GHC_PSL_FG_PANE_ID              "{{unified.blue}}"
set -g @GHC_PSL_FG_PANE_INDEX           "{{unified.orange}}"
set -g @GHC_PSL_FG_MARKER               "{{unified.purple}}"

## Statusbar

set -g @GHC_SL_FG_BORDER                "{{unified.bg4}}"
set -g @GHC_SL_FG_BORDER_CUR            "{{unified.blue}}"

set -g @GHC_SL_BG_SYM                   "default"
set -g @GHC_SL_FG_SYM                   "{{unified.blue}}"
set -g @GHC_SL_BG_TXT                   "default"
set -g @GHC_SL_FG_TXT                   "{{unified.fg2}}"

set -g @GHC_SL_BG_OS_SYM                "{{unified.bg0}}"
set -g @GHC_SL_FG_OS_SYM                "{{unified.blue}}"

set -g @GHC_SL_BG_PREFIX                "default"
set -g @GHC_SL_FG_PREFIX                "{{unified.blue}}"
set -g @GHC_SL_BG_ALERT                 "{{unified.red}}"
set -g @GHC_SL_FG_ALERT                 "{{unified.bg0}}"

set -g @GHC_SL_FG_PILL_TXT              "{{unified.fg1}}"
set -g @GHC_SL_FG_PILL_HOST_TXT         "{{unified.fg1}}"
set -g @GHC_SL_FG_PILL_ICON             "{{unified.yellow}}"
set -g @GHC_SL_BG_PILL_DURATION         "{{unified.bg2}}"
set -g @GHC_SL_BG_PILL_DATE             "{{unified.bg2}}"
set -g @GHC_SL_BG_PILL_TIME             "{{unified.bg2}}"
set -g @GHC_SL_BG_PILL_SESSION          "{{unified.bg2}}"
