set -g @GHC_SL_BG_WIN_ICON_BELL         "{{unified.bg2}}"
set -g @GHC_SL_FG_WIN_ICON_BELL         "{{unified.red}}"
set -g @GHC_SL_FG_WIN_ICON_ACTIVITY     "{{unified.green}}"
