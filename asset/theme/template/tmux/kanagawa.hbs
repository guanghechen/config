set -g @GHC_SL_BG_PILL_USER             "{{unified.bg2}}"
set -g @GHC_SL_BG_PILL_HOST             "{{unified.bg2}}"
set -g @GHC_SL_BG_PILL_ZOOM             "{{unified.bg2}}"

set -g @GHC_SL_BG_PRIMARY_SEP           "{{unified.bg1}}"
set -g @GHC_SL_FG_PRIMARY_SEP           "{{unified.yellow}}"
set -g @GHC_SL_BG_PRIMARY_SYM           "{{unified.yellow}}"
set -g @GHC_SL_FG_PRIMARY_SYM           "{{unified.bg0}}"
set -g @GHC_SL_BG_PRIMARY_TXT           "{{unified.yellow}}"
set -g @GHC_SL_FG_PRIMARY_TXT           "{{unified.bg0}}"
set -g @GHC_SL_BG_SECONDARY_SEP         "default"
