# {{name}}

# Main bg
theme[main_bg]="{{rosepine.base}}"

# Main text color
theme[main_fg]="{{rosepine.text}}"

# Title color for boxes
theme[title]="{{rosepine.subtle}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{rosepine.text}}"

# Background color of selected item in processes box
theme[selected_bg]="{{rosepine.highlightHigh}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{rosepine.gold}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{rosepine.highlightMed}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{rosepine.iris}}"

# Color of text in graphs
theme[graph_text]="{{rosepine.foam}}"

# Background color of meters
theme[meter_bg]="{{rosepine.foam}}"

# Cpu box outline color
theme[cpu_box]="{{rosepine.rose}}"

# Memory/disks box outline color
theme[mem_box]="{{rosepine.pine}}"

# Net up/down box outline color
theme[net_box]="{{rosepine.iris}}"

# Processes box outline color
theme[proc_box]="{{rosepine.love}}"

# Box divider line and small boxes line color
theme[div_line]="{{rosepine.muted}}"

# Temperature graph colors (green -> yellow -> red)
theme[temp_start]="{{rosepine.rose}}"
theme[temp_mid]="{{rosepine.gold}}"
theme[temp_end]="{{rosepine.love}}"

# CPU graph colors
theme[cpu_start]="{{rosepine.gold}}"
theme[cpu_mid]="{{rosepine.rose}}"
theme[cpu_end]="{{rosepine.love}}"

# Mem/Disk free meter
theme[free_start]="{{rosepine.love}}"
theme[free_mid]="{{rosepine.love}}"
theme[free_end]="{{rosepine.love}}"

# Mem/Disk cached meter
theme[cached_start]="{{rosepine.iris}}"
theme[cached_mid]="{{rosepine.iris}}"
theme[cached_end]="{{rosepine.iris}}"

# Mem/Disk available meter
theme[available_start]="{{rosepine.pine}}"
theme[available_mid]="{{rosepine.pine}}"
theme[available_end]="{{rosepine.pine}}"

# Mem/Disk used meter
theme[used_start]="{{rosepine.rose}}"
theme[used_mid]="{{rosepine.rose}}"
theme[used_end]="{{rosepine.rose}}"

# Download graph colors
theme[download_start]="{{rosepine.pine}}"
theme[download_mid]="{{rosepine.foam}}"
theme[download_end]="{{rosepine.foam}}"

# Upload graph colors
theme[upload_start]="{{rosepine.rose}}"
theme[upload_mid]="{{rosepine.love}}"
theme[upload_end]="{{rosepine.love}}"

# Process box gradient
theme[process_start]="{{rosepine.pine}}"
theme[process_mid]="{{rosepine.foam}}"
theme[process_end]="{{rosepine.foam}}"

# Background color when process is paused (e.g. after pressing 'p')
theme[proc_pause_bg]="{{rosepine.love}}"
