# {{name}}

# Main bg
theme[main_bg]="{{rosepine.base}}"

# Main text color
theme[main_fg]="{{unified.fg1}}"

# Title color for boxes
theme[title]="{{unified.fg1}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{unified.aqua}}"

# Background color of selected item in processes box
theme[selected_bg]="{{rosepine.highlightMed}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{unified.fg1}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{rosepine.muted}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{unified.purple}}"

# Color of text in graphs
theme[graph_text]="{{unified.fg2}}"

# Background color of meters
theme[meter_bg]="{{rosepine.highlightMed}}"

# Cpu box outline color
theme[cpu_box]="{{rosepine.highlightHigh}}"

# Memory/disks box outline color
theme[mem_box]="{{rosepine.highlightHigh}}"

# Net up/down box outline color
theme[net_box]="{{rosepine.highlightHigh}}"

# Processes box outline color
theme[proc_box]="{{unified.aqua}}"

# Box divider line and small boxes line color
theme[div_line]="{{rosepine.highlightMed}}"

# Temperature graph colors (green -> yellow -> red)
theme[temp_start]="{{unified.green}}"
theme[temp_mid]="{{unified.yellow}}"
theme[temp_end]="{{unified.red}}"

# CPU graph colors
theme[cpu_start]="{{unified.green}}"
theme[cpu_mid]="{{unified.blue}}"
theme[cpu_end]="{{unified.purple}}"

# Mem/Disk free meter
theme[free_start]="{{unified.green}}"
theme[free_mid]="{{unified.green}}"
theme[free_end]="{{unified.green}}"

# Mem/Disk cached meter
theme[cached_start]="{{unified.blue}}"
theme[cached_mid]="{{unified.blue}}"
theme[cached_end]="{{unified.blue}}"

# Mem/Disk available meter
theme[available_start]="{{unified.green}}"
theme[available_mid]="{{unified.green}}"
theme[available_end]="{{unified.green}}"

# Mem/Disk used meter
theme[used_start]="{{unified.purple}}"
theme[used_mid]="{{unified.purple}}"
theme[used_end]="{{unified.purple}}"

# Download graph colors
theme[download_start]="{{unified.green}}"
theme[download_mid]="{{unified.blue}}"
theme[download_end]="{{unified.blue}}"

# Upload graph colors
theme[upload_start]="{{unified.aqua}}"
theme[upload_mid]="{{unified.purple}}"
theme[upload_end]="{{unified.purple}}"

# Process box gradient
theme[process_start]="{{unified.fg2}}"
theme[process_mid]="{{unified.blue}}"
theme[process_end]="{{unified.blue}}"

# Background color when process is paused (e.g. after pressing 'p')
theme[proc_pause_bg]="{{rosepine.highlightMed}}"
