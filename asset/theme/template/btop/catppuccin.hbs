# {{name}}

# Text and neutral surfaces
theme[main_bg]="{{catppuccin.base}}"
theme[main_fg]="{{unified.fg1}}"
theme[title]="{{unified.fg1}}"
theme[hi_fg]="{{unified.purple}}"
theme[selected_bg]="{{unified.bg3}}"
theme[selected_fg]="{{unified.fg1}}"
theme[inactive_fg]="{{catppuccin.overlay0}}"
theme[proc_misc]="{{unified.blue}}"
theme[graph_text]="{{unified.fg2}}"
theme[meter_bg]="{{unified.bg2}}"

# Keep the process focus distinct from the surrounding boxes.
theme[cpu_box]="{{unified.bg4}}"
theme[mem_box]="{{unified.bg4}}"
theme[net_box]="{{unified.bg4}}"
theme[proc_box]="{{unified.purple}}"
theme[div_line]="{{unified.bg3}}"

# Temperature and CPU load
theme[temp_start]="{{unified.green}}"
theme[temp_mid]="{{unified.yellow}}"
theme[temp_end]="{{unified.red}}"
theme[cpu_start]="{{unified.blue}}"
theme[cpu_mid]="{{unified.purple}}"
theme[cpu_end]="{{unified.red}}"

# Give each memory meter a stable color.
theme[free_start]="{{unified.green}}"
theme[free_mid]="{{unified.green}}"
theme[free_end]="{{unified.green}}"
theme[cached_start]="{{unified.aqua}}"
theme[cached_mid]="{{unified.aqua}}"
theme[cached_end]="{{unified.aqua}}"
theme[available_start]="{{unified.blue}}"
theme[available_mid]="{{unified.blue}}"
theme[available_end]="{{unified.blue}}"
theme[used_start]="{{unified.purple}}"
theme[used_mid]="{{unified.purple}}"
theme[used_end]="{{unified.purple}}"

# Network directions and process load
theme[download_start]="{{unified.green}}"
theme[download_mid]="{{unified.aqua}}"
theme[download_end]="{{unified.blue}}"
theme[upload_start]="{{unified.orange}}"
theme[upload_mid]="{{unified.pink}}"
theme[upload_end]="{{unified.purple}}"
theme[process_start]="{{unified.fg2}}"
theme[process_mid]="{{unified.blue}}"
theme[process_end]="{{unified.purple}}"
theme[proc_pause_bg]="{{unified.bg3}}"
