# {{name}}

# Main bg
theme[main_bg]="{{vsc.editor_background}}"

# Main text color
theme[main_fg]="{{vsc.foreground}}"

# Title color for boxes
theme[title]="{{vsc.foreground}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{vsc.accentBlue}}"

# Background color of selected item in processes box
theme[selected_bg]="{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{vsc.inputOption_activeForeground}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{vsc.accentBlue}}"

# Color of text in graphs
theme[graph_text]="{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}}"

# Background color of meters
theme[meter_bg]="{{vsc.overlay}}"

# Cpu box outline color
theme[cpu_box]="{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"

# Memory/disks box outline color
theme[mem_box]="{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"

# Net up/down box outline color
theme[net_box]="{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"

# Processes box outline color
theme[proc_box]="{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"

# Box divider line and small boxes line color
theme[div_line]="{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"

# Temperature graph colors (green -> yellow -> red)
theme[temp_start]="{{vsc.accentGreen}}"
theme[temp_mid]="{{vsc.accentYellow}}"
theme[temp_end]="{{vsc.accentRed}}"

# CPU graph colors
theme[cpu_start]="{{vsc.accentGreen}}"
theme[cpu_mid]="{{vsc.accentYellow}}"
theme[cpu_end]="{{vsc.accentRed}}"

# Mem/Disk free meter
theme[free_start]="{{vsc.accentGreen}}"
theme[free_mid]="{{vsc.accentYellow}}"
theme[free_end]="{{vsc.accentRed}}"

# Mem/Disk cached meter
theme[cached_start]="{{vsc.accentAqua}}"
theme[cached_mid]="{{vsc.accentBlue}}"
theme[cached_end]="{{vsc.accentPurple}}"

# Mem/Disk available meter
theme[available_start]="{{vsc.accentGreen}}"
theme[available_mid]="{{vsc.accentYellow}}"
theme[available_end]="{{vsc.accentOrange}}"

# Mem/Disk used meter
theme[used_start]="{{vsc.accentGreen}}"
theme[used_mid]="{{vsc.accentYellow}}"
theme[used_end]="{{vsc.accentRed}}"

# Download graph colors
theme[download_start]="{{vsc.accentGreen}}"
theme[download_mid]="{{vsc.accentAqua}}"
theme[download_end]="{{vsc.accentBlue}}"

# Upload graph colors
theme[upload_start]="{{vsc.accentPurple}}"
theme[upload_mid]="{{vsc.accentPink}}"
theme[upload_end]="{{vsc.accentRed}}"

# Process box gradient
theme[process_start]="{{vsc.accentAqua}}"
theme[process_mid]="{{vsc.accentBlue}}"
theme[process_end]="{{vsc.accentPurple}}"

# Background color when process is paused (e.g. after pressing 'p')
theme[proc_pause_bg]="{{vsc.accentRed}}"
