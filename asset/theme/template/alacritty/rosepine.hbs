# {{name}}

[bell]
color = "{{rosepine.love}}"

[colors]
draw_bold_text_with_bright_colors = false
transparent_background_colors = true

[colors.cursor]
text              = "{{rosepine.text}}"
cursor            = "{{rosepine.highlightHigh}}"

[colors.vi_mode_cursor]
text              = "{{rosepine.text}}"
cursor            = "{{rosepine.highlightHigh}}"

[colors.search.matches]
foreground        = "{{rosepine.subtle}}"
background        = "{{rosepine.overlay}}"

[colors.search.focused_match]
foreground        = "{{rosepine.base}}"
background        = "{{rosepine.rose}}"

[colors.hints.start]
foreground        = "{{rosepine.subtle}}"
background        = "{{rosepine.surface}}"

[colors.hints.end]
foreground        = "{{rosepine.muted}}"
background        = "{{rosepine.surface}}"

[colors.selection]
text              = "{{rosepine.text}}"
background        = "{{rosepine.highlightMed}}"

[colors.footer_bar]
foreground        = "{{rosepine.text}}"
background        = "{{rosepine.surface}}"

[colors.primary]
background        = "{{rosepine.base}}"
foreground        = "{{rosepine.text}}"
dim_foreground    = "{{rosepine.subtle}}"
bright_foreground = "{{rosepine.text}}"

[colors.normal]
black             = "{{rosepine.overlay}}"
red               = "{{rosepine.love}}"
green             = "{{rosepine.pine}}"
yellow            = "{{rosepine.gold}}"
blue              = "{{rosepine.foam}}"
magenta           = "{{rosepine.iris}}"
cyan              = "{{rosepine.rose}}"
white             = "{{rosepine.text}}"

[colors.bright]
black             = "{{rosepine.muted}}"
red               = "{{rosepine.love}}"
green             = "{{rosepine.pine}}"
yellow            = "{{rosepine.gold}}"
blue              = "{{rosepine.foam}}"
magenta           = "{{rosepine.iris}}"
cyan              = "{{rosepine.rose}}"
white             = "{{rosepine.text}}"

[colors.dim]
black             = "{{rosepine.muted}}"
red               = "{{rosepine.love}}"
green             = "{{rosepine.pine}}"
yellow            = "{{rosepine.gold}}"
blue              = "{{rosepine.foam}}"
magenta           = "{{rosepine.iris}}"
cyan              = "{{rosepine.rose}}"
white             = "{{rosepine.text}}"

[[colors.indexed_colors]]
index = 16
color = "{{rosepine.rose}}"

[[colors.indexed_colors]]
index = 17
color = "{{rosepine.love}}"
