yellow            = "{{rosepine.gold}}"
blue              = "{{rosepine.foam}}"
magenta           = "{{rosepine.iris}}"
cyan              = "{{rosepine.rose}}"
white             = "{{rosepine.text}}"

[colors.dim]
black             = "{{rosepine.muted}}"
red               = "{{rosepine.love}}"
green             = "{{rosepine.pine}}"
yellow            = "{{rosepine.gold}}"
blue              = "{{rosepine.foam}}"
magenta           = "{{rosepine.iris}}"
