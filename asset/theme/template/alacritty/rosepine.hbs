# {{name}}

[bell]
color = "{{unified.red}}"

[colors]
draw_bold_text_with_bright_colors = false
transparent_background_colors = true

[colors.cursor]
text              = "{{rosepine.base}}"
cursor            = "{{unified.aqua}}"

[colors.vi_mode_cursor]
text              = "{{rosepine.base}}"
cursor            = "{{unified.purple}}"

[colors.search.matches]
foreground        = "{{unified.fg1}}"
background        = "{{rosepine.overlay}}"

[colors.search.focused_match]
foreground        = "{{rosepine.base}}"
background        = "{{unified.yellow}}"

[colors.hints.start]
foreground        = "{{rosepine.base}}"
background        = "{{unified.blue}}"

[colors.hints.end]
foreground        = "{{unified.fg1}}"
background        = "{{rosepine.overlay}}"

[colors.selection]
text              = "{{unified.fg1}}"
background        = "{{rosepine.highlightMed}}"

[colors.footer_bar]
foreground        = "{{unified.fg1}}"
background        = "{{rosepine.surface}}"

[colors.primary]
background        = "{{rosepine.base}}"
foreground        = "{{unified.fg1}}"
dim_foreground    = "{{unified.fg2}}"
