yellow            = "{{rosepine.gold}}"
blue              = "{{rosepine.foam}}"
magenta           = "{{rosepine.iris}}"
cyan              = "{{rosepine.rose}}"
white             = "{{rosepine.text}}"

[colors.bright]
black             = "{{rosepine.muted}}"
red               = "{{rosepine.love}}"
