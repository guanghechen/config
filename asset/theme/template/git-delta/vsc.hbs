# https://github.com/dandavison/delta/blob/main/themes.gitconfig
# {{name}}

[delta "{{name}}"]
{{darken ? "dark                          = true" : "light                         = true"}}
syntax-theme                  = {{name}}

inline-hint-style             = "{{vsc.accentBlue}}"

####################################################################################################

file-style                    = "{{vsc.foreground}}" bold

hunk-header-line-number-style = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}"

line-numbers-minus-style      = "{{vsc.accentRed}}" normal bold
line-numbers-plus-style       = "{{vsc.accentGreen}}" normal bold

minus-style                   = syntax "{{vsc.diffDel}}"
plus-style                    = syntax "{{vsc.diffAdd}}"
minus-non-emph-style          = syntax "{{vsc.diffDel}}"
plus-non-emph-style           = syntax "{{vsc.diffAdd}}"
minus-emph-style              = syntax "{{vsc.diffDelInline}}" bold
plus-emph-style               = syntax "{{vsc.diffAddInline}}" bold

plus-empty-line-marker-style  = "{{vsc.diffAdd}}" "{{vsc.diffAdd}}"
minus-empty-line-marker-style = "{{vsc.diffDel}}" "{{vsc.diffDel}}"

####################################################################################################

commit-style                  = "{{vsc.accentYellow}}" bold

blame-palette                 = "{{vsc.editor_background}}" "{{vsc.overlay}}" "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}"
blame-separator-style         = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}" dim
