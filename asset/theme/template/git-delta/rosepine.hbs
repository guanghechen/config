# https://github.com/dandavison/delta/blob/main/themes.gitconfig
# {{name}}

[delta "{{name}}"]
{{darken ? "dark                          = true" : "light                         = true"}}
syntax-theme                  = {{name}}

inline-hint-style             = "{{unified.blue}}"

####################################################################################################

file-style                    = "{{unified.fg1}}" bold

hunk-header-line-number-style = "{{unified.fg2}}"

line-numbers-minus-style      = "{{unified.red}}" normal bold
line-numbers-plus-style       = "{{unified.green}}" normal bold

minus-style                   = syntax "{{unified.diffDel}}"
plus-style                    = syntax "{{unified.diffAdd}}"
minus-non-emph-style          = syntax "{{unified.diffDel}}"
plus-non-emph-style           = syntax "{{unified.diffAdd}}"
minus-emph-style              = "{{unified.fg1}}" "{{unified.diffDelInline}}" bold
plus-emph-style               = "{{unified.fg1}}" "{{unified.diffAddInline}}" bold

plus-empty-line-marker-style  = "{{unified.diffAdd}}" "{{unified.diffAdd}}"
minus-empty-line-marker-style = "{{unified.diffDel}}" "{{unified.diffDel}}"

####################################################################################################

commit-style                  = "{{unified.yellow}}" bold

blame-palette                 = "{{rosepine.base}}" "{{rosepine.surface}}" "{{rosepine.overlay}}"
blame-separator-style         = "{{unified.fg2}}" dim
