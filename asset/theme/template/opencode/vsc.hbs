{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "{{vsc.textLink_foreground}}",
    "secondary": "{{vsc.accentPurple}}",
    "accent": "{{vsc.accentPink}}",
    "text": "{{vsc.inputOption_activeForeground}}",
    "textMuted": "{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}",
    "background": "{{vsc.editor_background}}",

    "error": "{{vsc.accentRed}}",
    "warning": "{{vsc.accentYellow}}",
    "success": "{{vsc.accentGreen}}",
    "info": "{{vsc.accentAqua}}",

    "backgroundPanel": "{{vsc.overlay}}",
    "backgroundElement": "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}",
    "border": "{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}",
    "borderActive": "{{vsc.accentPink}}",
    "borderSubtle": "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}",

    "diffAdded": "{{vsc.editorGutter_addedBackground}}",
    "diffRemoved": "{{vsc.editorGutter_deletedBackground}}",
    "diffContext": "{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}",
    "diffHunkHeader": "{{vsc.accentPurple}}",
    "diffHighlightAdded": "{{vsc.brightGreen}}",
    "diffHighlightRemoved": "{{vsc.brightRed}}",
    "diffAddedBg": "{{vsc.diffEditor_insertedTextBackground}}",
    "diffRemovedBg": "{{vsc.diffEditor_removedTextBackground}}",

    "markdownText": "{{vsc.foreground}}",
    "markdownHeading": "{{vsc.accentOrange}}",
    "markdownLink": "{{vsc.textLink_foreground}}",
    "markdownCode": "{{vsc.accentAqua}}",
    "markdownBlockQuote": "{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}",
    "markdownEmph": "{{vsc.accentYellow}}",
    "markdownStrong": "{{vsc.accentOrange}}",

    "syntaxComment": "{{vsc.editorIndentGuide_activeBackground1}}",
    "syntaxKeyword": "{{vsc.accentPurple}}",
    "syntaxFunction": "{{vsc.tokenFunctionDeclarations}}",
    "syntaxVariable": "{{vsc.foreground}}",
    "syntaxString": "{{vsc.accentGreen}}",
    "syntaxNumber": "{{vsc.accentAqua}}",
    "syntaxType": "{{vsc.accentYellow}}",
    "syntaxOperator": "{{vsc.accentPink}}",
    "syntaxPunctuation": "{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}}"
  }
}
