# {{name}}

# ANSI Colors
# Dark themes: palette 0 = surface1, palette 7 = subtext0
# Light theme: palette 0 = subtext1, palette 7 = surface2
palette =  0={{vsc.base}}
palette =  1={{vsc.accentRed}}
palette =  2={{vsc.accentGreen}}
palette =  3={{vsc.accentYellow}}
palette =  4={{vsc.accentBlue}}
palette =  5={{vsc.accentPurple}}
palette =  6={{vsc.accentAqua}}
palette =  7={{vsc.foreground}}

# Bright colors
# Dark themes: palette 8 = surface2, palette 15 = subtext1
# Light theme: palette 8 = subtext0, palette 15 = surface1
palette =  8={{vsc.textMuted}}
palette =  9={{vsc.brightRed}}
palette = 10={{vsc.brightGreen}}
palette = 11={{vsc.brightYellow}}
palette = 12={{vsc.brightBlue}}
palette = 13={{vsc.brightPurple}}
palette = 14={{vsc.brightAqua}}
palette = 15={{vsc.text}}

# Primary colors
background = {{vsc.editor_background}}
foreground = {{vsc.terminal_foreground}}

# Cursor colors
cursor-color = {{vsc.accentPink}}
cursor-text = {{vsc.activityBar_background}}

# Selection colors
selection-background = {{vsc.terminal_inactiveSelectionBackground}}
selection-foreground = {{vsc.terminal_foreground}}

# Split divider color
split-divider-color = {{vsc.panel_border}}

# Unfocused split fill color
unfocused-split-fill = {{vsc.surface}}
