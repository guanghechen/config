# {{name}}

# Official ANSI mapping: https://github.com/folke/tokyonight.nvim/tree/main/extras/ghostty
palette =  0={{tokyonight.black}}
palette =  1={{tokyonight.red}}
palette =  2={{tokyonight.green}}
palette =  3={{tokyonight.yellow}}
palette =  4={{tokyonight.blue}}
palette =  5={{tokyonight.magenta}}
palette =  6={{tokyonight.cyan}}
palette =  7={{tokyonight.fg_dark}}

# Bright colors use the upstream HSLuv-generated swatches.
palette =  8={{tokyonight.terminal_black}}
palette =  9={{variant === 'moon' ? '#ff8d94' : variant === 'day' ? '#ff4774' : '#ff899d'}}
palette = 10={{variant === 'moon' ? '#c7fb6d' : variant === 'day' ? '#5c8524' : '#9fe044'}}
palette = 11={{variant === 'moon' ? '#ffd8ab' : variant === 'day' ? '#a27629' : '#faba4a'}}
palette = 12={{variant === 'moon' ? '#9ab8ff' : variant === 'day' ? '#358aff' : '#8db0ff'}}
palette = 13={{variant === 'moon' ? '#caabff' : variant === 'day' ? '#a463ff' : '#c7a9ff'}}
palette = 14={{variant === 'moon' ? '#b2ebff' : variant === 'day' ? '#007ea8' : '#a4daff'}}
palette = 15={{tokyonight.fg}}

# Primary colors
background = {{unified.bg0}}
foreground = {{unified.fg1}}

# Cursor colors
cursor-color = {{unified.purple}}
cursor-text = {{unified.bg0}}

# Selection colors
selection-background = {{unified.bg3}}
selection-foreground = {{unified.fg1}}

# Split divider color
split-divider-color = {{unified.bg4}}

# Unfocused split fill color
unfocused-split-fill = {{unified.bg1}}
