# {{name}}

# Official ANSI mapping: https://github.com/catppuccin/ghostty/blob/main/ghostty.tera
palette =  0={{darken ? catppuccin.surface1 : catppuccin.subtext1}}
palette =  1={{catppuccin.red}}
palette =  2={{catppuccin.green}}
palette =  3={{catppuccin.yellow}}
palette =  4={{catppuccin.blue}}
palette =  5={{catppuccin.pink}}
palette =  6={{catppuccin.teal}}
palette =  7={{darken ? catppuccin.subtext0 : catppuccin.surface2}}

# Bright colors
palette =  8={{darken ? catppuccin.surface2 : catppuccin.subtext0}}
palette =  9={{catppuccin.red}}
palette = 10={{catppuccin.green}}
palette = 11={{catppuccin.yellow}}
palette = 12={{catppuccin.blue}}
palette = 13={{catppuccin.pink}}
palette = 14={{catppuccin.teal}}
palette = 15={{darken ? catppuccin.subtext1 : catppuccin.surface1}}

# Primary colors
background = {{catppuccin.base}}
foreground = {{unified.fg1}}

# Cursor colors
cursor-color = {{unified.purple}}
cursor-text = {{catppuccin.base}}

# Selection colors
selection-background = {{unified.bg3}}
selection-foreground = {{unified.fg1}}

# Split divider color
split-divider-color = {{unified.bg4}}

# Unfocused split fill color
unfocused-split-fill = {{catppuccin.mantle}}
