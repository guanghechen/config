# {{name}}
# yaml-language-server: $schema=https://raw.githubusercontent.com/jesseduffield/lazygit/v0.66.0/schema/config.json

gui:
  colorScheme: {{darken ? 'dark' : 'light'}}
  theme:
    activeBorderColor:
      - '{{vsc.tokenControlFlowSpecialKeywords}}'
      - bold
    authorColors:
      '*': '{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}'
      guanghechen: '{{vsc.textLink_foreground}}'
    branchColorPatterns:
      "^(main|master)$": '{{vsc.tokenControlFlowSpecialKeywords}}'
      "^(user/[^/]+/)?chore": '{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}'
      "^(user/[^/]+/)?feat": '{{darken ? vsc.editorGutter_addedBackground : vsc.terminal_ansiGreen}}'
      "^(user/[^/]+/)?fix": '{{darken ? vsc.editorGutter_deletedBackground : vsc.terminal_ansiRed}}'
      "^(user/[^/]+/)?refactor": '{{vsc.accentOrange}}'
      "^(user/[^/]+/)?release": '{{vsc.textLink_foreground}}'
    cherryPickedCommitBgColor:
      - '{{vsc.accentAqua}}'
    cherryPickedCommitFgColor:
      - '{{vsc.editor_background}}'
    defaultFgColor:
      - '{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}'
    inactiveBorderColor:
      - '{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}'
    inactiveViewSelectedLineBgColor:
      - '{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}'
    markedBaseCommitBgColor:
      - '{{vsc.accentYellow}}'
    markedBaseCommitFgColor:
      - '{{vsc.editor_background}}'
    optionsTextColor:
      - '{{vsc.tokenFunctionDeclarations}}'
    searchingActiveBorderColor:
      - '{{vsc.focusBorder}}'
      - bold
    selectedLineBgColor:
      - '{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}'
    selectedLineFgColor:
      - '{{vsc.foreground}}'
      - bold
    unstagedChangesColor:
      - '{{darken ? vsc.editorGutter_deletedBackground : vsc.terminal_ansiRed}}'

git:
  diffRenderers:
    # Narrow panels (< 100 columns) use the unified delta layout, matching fzf-git-log.
    - command: >-
        {{IS_WIN ? '' : '[ "${COLUMNS:-0}" -lt 100 ] && export DELTA_FEATURES=+unified; '}}delta --paging=never --{{darken ? 'dark' : 'light'}}
        --line-numbers --hyperlinks
        --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
