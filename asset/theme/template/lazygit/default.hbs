# {{name}}
# yaml-language-server: $schema=https://raw.githubusercontent.com/jesseduffield/lazygit/v0.66.0/schema/config.json

gui:
  colorScheme: {{darken ? 'dark' : 'light'}}
  theme:
    activeBorderColor:
      - '{{vsc?.tokenControlFlowSpecialKeywords || unified.brightPurple}}'
      - bold
    authorColors:
      '*': '{{unified.fg2}}'
      guanghechen: '{{vsc?.textLink_foreground || unified.brightBlue}}'
    branchColorPatterns:
      "^(main|master)$": '{{vsc?.tokenControlFlowSpecialKeywords || unified.brightPurple}}'
      "^(user/[^/]+/)?chore": '{{vsc ? (darken ? vsc.textMuted : vsc.activityBar_inactiveForeground) : unified.fg2}}'
      "^(user/[^/]+/)?feat": '{{vsc ? (darken ? vsc.editorGutter_addedBackground : vsc.terminal_ansiGreen) : unified.brightGreen}}'
      "^(user/[^/]+/)?fix": '{{vsc ? (darken ? vsc.editorGutter_deletedBackground : vsc.terminal_ansiRed) : unified.brightRed}}'
      "^(user/[^/]+/)?refactor": '{{vsc?.accentOrange || unified.brightOrange}}'
      "^(user/[^/]+/)?release": '{{vsc?.textLink_foreground || unified.brightBlue}}'
    cherryPickedCommitBgColor:
      - '{{vsc?.accentAqua || unified.bg2}}'
    cherryPickedCommitFgColor:
      - '{{vsc?.editor_background || unified.fg1}}'
    defaultFgColor:
      - '{{unified.fg2}}'
    inactiveBorderColor:
      - '{{unified.fg4}}'
    inactiveViewSelectedLineBgColor:
      - '{{unified.bg2}}'
    markedBaseCommitBgColor:
      - '{{vsc?.accentYellow || unified.bg3}}'
    markedBaseCommitFgColor:
      - '{{vsc?.editor_background || unified.fg1}}'
    optionsTextColor:
      - '{{vsc?.tokenFunctionDeclarations || unified.brightOrange}}'
    searchingActiveBorderColor:
      - '{{vsc?.focusBorder || unified.brightAqua}}'
      - bold
    selectedLineBgColor:
      - '{{unified.bg3}}'
    selectedLineFgColor:
      - '{{vsc?.foreground || unified.fg1}}'
      - bold
    unstagedChangesColor:
      - '{{vsc ? (darken ? vsc.editorGutter_deletedBackground : vsc.terminal_ansiRed) : unified.brightRed}}'

git:
  diffRenderers:
    - command: >-
        delta --paging=never --{{darken ? 'dark' : 'light'}}
        --line-numbers --hyperlinks
        --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
