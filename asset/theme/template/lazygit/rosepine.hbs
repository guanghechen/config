# {{name}}
# yaml-language-server: $schema=https://raw.githubusercontent.com/jesseduffield/lazygit/v0.66.0/schema/config.json

gui:
  colorScheme: {{darken ? 'dark' : 'light'}}
  theme:
    activeBorderColor:
      - '{{unified.aqua}}'
      - bold
    authorColors:
      '*': '{{unified.fg2}}'
      guanghechen: '{{unified.blue}}'
    branchColorPatterns:
      "^(main|master)$": '{{unified.purple}}'
      "^(user/[^/]+/)?chore": '{{unified.fg2}}'
      "^(user/[^/]+/)?feat": '{{unified.green}}'
      "^(user/[^/]+/)?fix": '{{unified.red}}'
      "^(user/[^/]+/)?refactor": '{{unified.aqua}}'
      "^(user/[^/]+/)?release": '{{unified.blue}}'
    cherryPickedCommitBgColor:
      - '{{rosepine.overlay}}'
    cherryPickedCommitFgColor:
      - '{{unified.aqua}}'
    defaultFgColor:
      - '{{unified.fg1}}'
    inactiveBorderColor:
      - '{{rosepine.highlightHigh}}'
    inactiveViewSelectedLineBgColor:
      - '{{rosepine.surface}}'
    markedBaseCommitBgColor:
      - '{{rosepine.highlightMed}}'
    markedBaseCommitFgColor:
      - '{{unified.fg1}}'
    optionsTextColor:
      - '{{unified.blue}}'
    searchingActiveBorderColor:
      - '{{unified.yellow}}'
      - bold
    selectedLineBgColor:
      - '{{rosepine.highlightMed}}'
    selectedLineFgColor:
      - '{{unified.fg1}}'
      - bold
    unstagedChangesColor:
      - '{{unified.red}}'

git:
  diffRenderers:
    - command: >-
        delta --paging=never --{{darken ? 'dark' : 'light'}}
        --line-numbers --hyperlinks
        --hyperlinks-file-link-format="lazygit-edit://{path}:{line}"
