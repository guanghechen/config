-- {{name}}

---@class theme.{{name.replace(/-/g, '_')}}
local M = {}

---@param config table
function M.setup(config)
  config.colors = {
    background    = "{{unified.bg0}}",
    foreground    = "{{unified.fg1}}",

    cursor_bg     = "{{unified.yellow}}",
    cursor_fg     = "{{unified.bg0}}",
    cursor_border = "{{unified.yellow}}",

    selection_bg  = "{{unified.bg3}}",
    selection_fg  = "{{unified.fg1}}",
    split         = "{{unified.bg4}}",
    scrollbar_thumb = "{{unified.bg4}}",
    visual_bell   = "{{unified.bg2}}",
    compose_cursor = "{{unified.orange}}",

    -- Official Kanagawa ANSI colors, independent from readable app accents.
    ansi = {
      "{{kanagawa[variant === 'wave' ? 'sumiInk0' : variant === 'dragon' ? 'dragonBlack0' : 'sumiInk3']}}",
      "{{kanagawa[variant === 'wave' ? 'autumnRed' : variant === 'dragon' ? 'dragonRed' : 'lotusRed']}}",
      "{{kanagawa[variant === 'wave' ? 'autumnGreen' : variant === 'dragon' ? 'dragonGreen2' : 'lotusGreen']}}",
      "{{kanagawa[variant === 'wave' ? 'boatYellow2' : variant === 'dragon' ? 'dragonYellow' : 'lotusYellow']}}",
      "{{kanagawa[variant === 'wave' ? 'crystalBlue' : variant === 'dragon' ? 'dragonBlue2' : 'lotusBlue4']}}",
      "{{kanagawa[variant === 'wave' ? 'oniViolet' : variant === 'dragon' ? 'dragonPink' : 'lotusPink']}}",
      "{{kanagawa[variant === 'wave' ? 'waveAqua1' : variant === 'dragon' ? 'dragonAqua' : 'lotusAqua']}}",
      "{{kanagawa[variant === 'lotus' ? 'lotusInk1' : 'oldWhite']}}",
    },
    brights = {
      "{{kanagawa[variant === 'wave' ? 'fujiGray' : variant === 'dragon' ? 'dragonGray' : 'lotusGray3']}}",
      "{{kanagawa[variant === 'wave' ? 'samuraiRed' : variant === 'dragon' ? 'waveRed' : 'lotusRed2']}}",
      "{{kanagawa[variant === 'wave' ? 'springGreen' : variant === 'dragon' ? 'dragonGreen' : 'lotusGreen2']}}",
      "{{kanagawa[variant === 'lotus' ? 'lotusYellow2' : 'carpYellow']}}",
      "{{kanagawa[variant === 'lotus' ? 'lotusTeal2' : 'springBlue']}}",
      "{{kanagawa[variant === 'lotus' ? 'lotusViolet4' : 'springViolet1']}}",
      "{{kanagawa[variant === 'lotus' ? 'lotusAqua2' : 'waveAqua2']}}",
      "{{kanagawa[variant === 'wave' ? 'fujiWhite' : variant === 'dragon' ? 'dragonWhite' : 'lotusInk2']}}",
    },
    indexed = {
      [16] = "{{kanagawa[variant === 'wave' ? 'surimiOrange' : variant === 'dragon' ? 'dragonOrange' : 'lotusOrange2']}}",
      [17] = "{{kanagawa[variant === 'wave' ? 'peachRed' : variant === 'dragon' ? 'dragonOrange2' : 'lotusRed3']}}",
    },

    tab_bar = {
      background = "{{unified.bg1}}",
      active_tab = {
        bg_color = "{{unified.yellow}}",
        fg_color = "{{unified.bg0}}",
      },
      inactive_tab = {
        bg_color = "{{unified.bg1}}",
        fg_color = "{{unified.fg2}}",
      },
      inactive_tab_hover = {
        bg_color = "{{unified.bg2}}",
        fg_color = "{{unified.fg1}}",
      },
      new_tab = {
        bg_color = "{{unified.bg1}}",
        fg_color = "{{unified.blue}}",
      },
      new_tab_hover = {
        bg_color = "{{unified.bg3}}",
        fg_color = "{{unified.fg1}}",
      },
      inactive_tab_edge = "{{unified.bg2}}",
    },
  }

  config.window_frame = {
    active_titlebar_bg = "{{unified.bg1}}",
    active_titlebar_fg = "{{unified.fg1}}",
    inactive_titlebar_bg = "{{unified.bg1}}",
    inactive_titlebar_fg = "{{unified.fg2}}",
    button_fg = "{{unified.fg1}}",
    button_bg = "{{unified.bg1}}",
  }

  config.command_palette_bg_color = "{{unified.bg2}}"
  config.command_palette_fg_color = "{{unified.fg1}}"
end

return M
