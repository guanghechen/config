{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "{{name}}",
  "author": "guanghechen",
  "themes": [
    {
      "name": "{{name}}",
      "appearance": "{{darken ? 'dark' : 'light'}}",
      "style": {
        "background": "{{tokyonight.bg}}",
        "surface.background": "{{tokyonight.bg_dark}}",
        "elevated_surface.background": "{{tokyonight.bg_highlight}}",
        "border": "{{tokyonight.border}}",
        "border.variant": "{{unified.bg2}}",
        "border.focused": "{{unified.purple}}",
        "border.selected": "{{unified.purple}}",
        "border.disabled": "{{unified.bg2}}",
        "text": "{{unified.fg1}}",
        "text.muted": "{{unified.fg3}}",
        "text.placeholder": "{{unified.fg4}}",
        "text.disabled": "{{unified.fg4}}",
        "text.accent": "{{unified.purple}}",
        "icon": "{{unified.fg1}}",
        "icon.muted": "{{unified.fg3}}",
        "icon.placeholder": "{{unified.fg4}}",
        "icon.disabled": "{{unified.fg4}}",
        "icon.accent": "{{unified.purple}}",
        "element.background": "{{tokyonight.bg_highlight}}",
        "element.hover": "{{tokyonight.bg_highlight}}",
        "element.active": "{{unified.bg3}}",
        "element.selected": "{{unified.bg3}}",
        "element.disabled": "{{unified.bg1}}",
        "ghost_element.hover": "{{tokyonight.bg_highlight}}",
        "ghost_element.active": "{{unified.bg3}}",
        "ghost_element.selected": "{{unified.bg3}}",
        "ghost_element.disabled": "{{unified.bg1}}",
        "panel.background": "{{tokyonight.bg_dark}}",
        "panel.focused_border": "{{unified.purple}}",
        "panel.indent_guide": "{{unified.bg3}}",
        "panel.indent_guide_active": "{{unified.fg4}}",
        "panel.indent_guide_hover": "{{unified.fg4}}",
        "pane.focused_border": "{{unified.purple}}",
        "pane_group.border": "{{tokyonight.border}}",
        "title_bar.background": "{{tokyonight.bg_dark}}",
        "title_bar.inactive_background": "{{tokyonight.bg_dark}}",
        "status_bar.background": "{{tokyonight.bg_dark}}",
        "toolbar.background": "{{tokyonight.bg}}",
        "tab_bar.background": "{{tokyonight.bg_dark}}",
        "tab.active_background": "{{tokyonight.bg}}",
        "tab.inactive_background": "{{tokyonight.bg_dark}}",
        "editor.background": "{{tokyonight.bg}}",
        "editor.foreground": "{{unified.fg1}}",
        "editor.gutter.background": "{{tokyonight.bg}}",
        "editor.subheader.background": "{{tokyonight.bg_dark}}",
        "editor.active_line.background": "{{tokyonight.bg_highlight}}",
        "editor.highlighted_line.background": "{{unified.bg2}}",
        "editor.line_number": "{{unified.fg4}}",
        "editor.active_line_number": "{{unified.blue}}",
        "editor.invisible": "{{unified.fg4 + '80'}}",
        "editor.wrap_guide": "{{unified.bg2}}",
        "editor.active_wrap_guide": "{{unified.bg3}}",
        "editor.indent_guide": "{{unified.bg2}}",
        "editor.indent_guide_active": "{{(unified.purple) + '80'}}",
        "editor.document_highlight.read_background": "{{tokyonight.bg_highlight}}",
        "editor.document_highlight.write_background": "{{unified.bg3}}",
        "editor.document_highlight.bracket_background": "{{unified.bg3}}",
        "search.match_background": "{{unified.yellow + '40'}}",
        "drop_target.background": "{{unified.blue + '30'}}",
        "link_text.hover": "{{unified.blue}}",
        "scrollbar.thumb.background": "{{unified.fg4 + '40'}}",
        "scrollbar.thumb.hover_background": "{{unified.fg4 + '80'}}",
        "scrollbar.thumb.border": "{{tokyonight.border}}",
        "scrollbar.track.background": "{{tokyonight.bg}}",
        "scrollbar.track.border": "{{unified.bg2}}",
        "terminal.background": "{{tokyonight.bg}}",
        "terminal.foreground": "{{unified.fg1}}",
        "terminal.bright_foreground": "{{unified.fg1}}",
        "terminal.dim_foreground": "{{unified.fg3}}",
        "terminal.ansi.background": "{{tokyonight.bg}}",
        "border.transparent": "#00000000",
        "ghost_element.background": "#00000000",
        "created": "{{unified.green}}",
        "created.border": "{{unified.green}}",
        "created.background": "{{unified.diffAdd}}",
        "deleted": "{{unified.red}}",
        "deleted.border": "{{unified.red}}",
        "deleted.background": "{{unified.diffDel}}",
        "modified": "{{unified.yellow}}",
        "modified.border": "{{unified.yellow}}",
        "modified.background": "{{unified.yellow + '20'}}",
        "renamed": "{{unified.aqua}}",
        "renamed.border": "{{unified.aqua}}",
        "renamed.background": "{{unified.aqua + '20'}}",
        "conflict": "{{unified.orange}}",
        "conflict.border": "{{unified.orange}}",
        "conflict.background": "{{unified.orange + '20'}}",
        "error": "{{unified.red}}",
        "error.border": "{{unified.red}}",
        "error.background": "{{unified.red + '20'}}",
        "warning": "{{unified.yellow}}",
        "warning.border": "{{unified.yellow}}",
        "warning.background": "{{unified.yellow + '20'}}",
        "info": "{{unified.blue}}",
        "info.border": "{{unified.blue}}",
        "info.background": "{{unified.blue + '20'}}",
        "hint": "{{unified.aqua}}",
        "hint.border": "{{unified.aqua}}",
        "hint.background": "{{unified.aqua + '20'}}",
        "success": "{{unified.green}}",
        "success.border": "{{unified.green}}",
        "success.background": "{{unified.green + '20'}}",
        "ignored": "{{unified.fg4}}",
        "ignored.border": "{{unified.fg4}}",
        "ignored.background": "{{unified.fg4 + '20'}}",
        "hidden": "{{unified.fg4}}",
        "hidden.border": "{{unified.fg4}}",
        "hidden.background": "{{unified.fg4 + '20'}}",
        "unreachable": "{{unified.fg4}}",
        "unreachable.border": "{{unified.fg4}}",
        "unreachable.background": "{{unified.fg4 + '20'}}",
        "predictive": "{{unified.fg4}}",
        "predictive.border": "{{unified.fg4}}",
        "predictive.background": "{{unified.fg4 + '20'}}",
        "terminal.ansi.black": "{{tokyonight.black}}",
        "terminal.ansi.red": "{{tokyonight.red}}",
        "terminal.ansi.green": "{{tokyonight.green}}",
        "terminal.ansi.yellow": "{{tokyonight.yellow}}",
        "terminal.ansi.blue": "{{tokyonight.blue}}",
        "terminal.ansi.magenta": "{{tokyonight.magenta}}",
        "terminal.ansi.cyan": "{{tokyonight.cyan}}",
        "terminal.ansi.white": "{{tokyonight.fg_dark}}",
        "terminal.ansi.bright_black": "{{tokyonight.terminal_black}}",
        "terminal.ansi.bright_red": "{{variant === 'moon' ? '#ff8d94' : variant === 'day' ? '#ff4774' : '#ff899d'}}",
        "terminal.ansi.bright_green": "{{variant === 'moon' ? '#c7fb6d' : variant === 'day' ? '#5c8524' : '#9fe044'}}",
        "terminal.ansi.bright_yellow": "{{variant === 'moon' ? '#ffd8ab' : variant === 'day' ? '#a27629' : '#faba4a'}}",
        "terminal.ansi.bright_blue": "{{variant === 'moon' ? '#9ab8ff' : variant === 'day' ? '#358aff' : '#8db0ff'}}",
        "terminal.ansi.bright_magenta": "{{variant === 'moon' ? '#caabff' : variant === 'day' ? '#a463ff' : '#c7a9ff'}}",
        "terminal.ansi.bright_cyan": "{{variant === 'moon' ? '#b2ebff' : variant === 'day' ? '#007ea8' : '#a4daff'}}",
        "terminal.ansi.bright_white": "{{tokyonight.fg}}",
        "accents": [
          "{{unified.purple}}",
          "{{unified.green}}",
          "{{unified.yellow}}",
          "{{unified.aqua}}",
          "{{unified.pink}}",
          "{{unified.orange}}"
        ],
        "players": [
          {
            "cursor": "{{unified.purple}}",
            "background": "{{tokyonight.bg}}",
            "selection": "{{unified.bg3}}"
          }
        ],
        "syntax": {
          "attribute": {
            "color": "{{unified.tokenAttribute}}"
          },
          "boolean": {
            "color": "{{unified.tokenConstant}}"
          },
          "comment": {
            "color": "{{unified.tokenComment}}",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "{{unified.tokenComment}}",
            "font_style": "italic"
          },
          "constant": {
            "color": "{{unified.tokenConstant}}"
          },
          "constructor": {
            "color": "{{unified.tokenType}}"
          },
          "embedded": {
            "color": "{{unified.tokenVariable}}"
          },
          "emphasis": {
            "color": "{{unified.tokenVariable}}",
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "{{unified.tokenVariable}}",
            "font_weight": 700
          },
          "enum": {
            "color": "{{unified.tokenType}}"
          },
          "function": {
            "color": "{{unified.tokenFunction}}"
          },
          "function.method": {
            "color": "{{unified.tokenFunction}}"
          },
          "function.special": {
            "color": "{{unified.tokenFunction}}"
          },
          "keyword": {
            "color": "{{unified.tokenKeyword}}"
          },
          "label": {
            "color": "{{unified.tokenProperty}}"
          },
          "link_text": {
            "color": "{{unified.blue}}"
          },
          "link_uri": {
            "color": "{{unified.tokenString}}"
          },
          "namespace": {
            "color": "{{unified.tokenType}}"
          },
          "number": {
            "color": "{{unified.tokenNumber}}"
          },
          "operator": {
            "color": "{{unified.tokenOperator}}"
          },
          "predictive": {
            "color": "{{unified.fg4}}"
          },
          "preproc": {
            "color": "{{unified.tokenDecorator}}"
          },
          "primary": {
            "color": "{{unified.fg1}}"
          },
          "property": {
            "color": "{{unified.tokenProperty}}"
          },
          "punctuation": {
            "color": "{{unified.tokenPunctuation}}"
          },
          "punctuation.bracket": {
            "color": "{{unified.tokenPunctuation}}"
          },
          "punctuation.delimiter": {
            "color": "{{unified.tokenPunctuation}}"
          },
          "punctuation.list_marker": {
            "color": "{{unified.tokenOperator}}"
          },
          "punctuation.special": {
            "color": "{{unified.tokenOperator}}"
          },
          "selector": {
            "color": "{{unified.tokenTag}}"
          },
          "selector.pseudo": {
            "color": "{{unified.tokenDecorator}}"
          },
          "string": {
            "color": "{{unified.tokenString}}"
          },
          "string.escape": {
            "color": "{{unified.purple}}"
          },
          "string.regex": {
            "color": "{{unified.orange}}"
          },
          "string.special": {
            "color": "{{unified.tokenDecorator}}"
          },
          "string.special.symbol": {
            "color": "{{unified.tokenConstant}}"
          },
          "tag": {
            "color": "{{unified.tokenTag}}"
          },
          "text.literal": {
            "color": "{{unified.tokenString}}"
          },
          "title": {
            "color": "{{unified.tokenType}}",
            "font_weight": 700
          },
          "type": {
            "color": "{{unified.tokenType}}"
          },
          "variable": {
            "color": "{{unified.tokenVariable}}"
          },
          "variable.special": {
            "color": "{{unified.tokenParameter}}"
          },
          "variant": {
            "color": "{{unified.tokenConstant}}"
          }
        }
      }
    }
  ]
}
