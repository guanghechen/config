        <dict>
          <key>foreground</key>
          <string>{{vsc.tokenTypesDeclarationAndReferences}}</string>
        </dict>
      </dict>
      <!-- BEGIN Codex extensions: diff lines and isolated section headings. -->
      <dict>
        <key>name</key>
        <string>Codex diff inserted</string>
        <key>scope</key>
        <string>markup.inserted, markup.inserted.diff, diff.inserted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{vsc.tokenMarkupInserted}}</string>
          <key>background</key>
          <string>{{compositeHex(vsc.diffEditor_insertedTextBackground, vsc.editor_background)}}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Codex diff deleted</string>
        <key>scope</key>
        <string>markup.deleted, markup.deleted.diff, diff.deleted</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{vsc.tokenMarkupDeleted}}</string>
          <key>background</key>
          <string>{{compositeHex(vsc.diffEditor_removedTextBackground, vsc.editor_background)}}</string>
        </dict>
      </dict>
      <dict>
        <key>name</key>
        <string>Codex UI section</string>
        <key>scope</key>
        <string>entity.name.section</string>
        <key>settings</key>
        <dict>
          <key>foreground</key>
          <string>{{vsc.tokenMarkupHeading}}</string>
          <key>fontStyle</key>
          <string>bold</string>
        </dict>
      </dict>
      <!-- END Codex extensions. -->
    </array>
  </dict>
</plist>
