#:schema https://yazi-rs.github.io/schemas/theme.json

# {{name}}

[cmp]
border                  = { fg = "{{vsc.accentBlue}}" }
active                  = { reversed = true }
inactive                = {}

# Icons
icon_file               = ""
icon_folder             = ""
icon_command            = ""

[confirm]
border                  = { fg = "{{vsc.accentBlue}}" }
title                   = { fg = "{{vsc.accentBlue}}" }
body                    = {}
list                    = {}
btn_yes                 = { reversed = true }
btn_no                  = {}
btn_labels              = [ "  [Y]es  ", "  (N)o  " ]

[help]
border                  = { fg = "{{vsc.accentBlue}}" }
chord                   = { fg = "{{vsc.accentAqua}}" }
action                  = {}
hovered                 = { reversed = true,    bold = true }

[input]
border                  = { fg = "{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}}" }
title                   = {}
value                   = {}
selected                = { reversed = true }

[mgr]
cwd                     = { fg = "{{vsc.accentAqua}}" }
border_symbol           = "│"
border_style            = { fg = "{{(darken ? vsc.menu_border : vsc.badge_background)}}" }
count_copied            = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentGreen}}" }
count_cut               = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentRed}}" }
count_selected          = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentPink}}" }
find_keyword            = { fg = "{{vsc.accentYellow}}",  bold = true, italic = true }
find_position           = { fg = "{{vsc.accentPurple}}",  bg = "reset", bold = true, italic = true }
marker_copied           = { fg = "{{vsc.accentGreen}}",   bg = "{{vsc.accentGreen}}" }
marker_cut              = { fg = "{{vsc.accentRed}}",     bg = "{{vsc.accentRed}}" }
marker_marked           = { fg = "{{vsc.accentAqua}}",    bg = "{{vsc.accentAqua}}" }
marker_selected         = { fg = "{{vsc.accentPink}}",    bg = "{{vsc.accentPink}}", dim = true, blink = true }
syntect_theme           = ""

[indicator]
current                 = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentPink}}", bold = true }
preview                 = { fg = "{{vsc.accentPink}}",    underline = true }

[mode]
normal_main             = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentAqua}}",    bold = true }
normal_alt              = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}",     bg = "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}" }
select_main             = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentPink}}",    bold = true }
select_alt              = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}",     bg = "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}" }
unset_main              = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentGreen}}",  bold = true }
unset_alt               = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}",     bg = "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}",  bold = true }

[notify]
title_info              = { fg = "{{vsc.accentGreen}}" }
title_warn              = { fg = "{{vsc.accentYellow}}" }
title_error             = { fg = "{{vsc.accentRed}}" }
icon_info               = ""
icon_warn               = ""
icon_error              = ""

[pick]
border                  = { fg = "{{vsc.accentBlue}}" }
active                  = { fg = "{{vsc.accentPurple}}",  bold = true }
inactive                = {}

[spot]
border                  = { fg = "{{vsc.accentBlue}}" }
title                   = { fg = "{{vsc.accentBlue}}" }

[status]
overall                 = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}" }
perm_exec               = { fg = "{{vsc.accentRed}}",     bold = true }
perm_read               = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}",     bold = true }
perm_sep                = { fg = "{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}}",     bold = true }
perm_write              = { fg = "{{vsc.accentYellow}}",  bold = true }
perm_type               = { fg = "{{vsc.accentBlue}}",    bold = true }
progress_error          = { fg = "{{vsc.accentRed}}",     bg = "{{vsc.overlay}}" }
progress_label          = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}",     bold = true }
progress_normal         = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}",     bg = "{{vsc.overlay}}" }
sep_left                = { open = "",         close = "" }
sep_right               = { open = "",         close = "" }

[tabs]
active                  = { fg = "{{vsc.overlay}}",     bg = "{{vsc.accentPink}}", bold = true }
inactive                = { fg = "{{vsc.accentPink}}",    bg = "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}" }
sep_inner               = { open = "",         close = "" }
sep_outer               = { open = "",         close = "" }

[tasks]
border                  = { fg = "{{vsc.accentBlue}}" }
title                   = {}
hovered                 = { fg = "{{vsc.accentPurple}}",  underline = true }

[which]
cols                    = 3
mask                    = { bg = "{{vsc.overlay}}" }
cand                    = { fg = "{{vsc.accentAqua}}" }
rest                    = { fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}" }
desc                    = { fg = "{{vsc.accentPurple}}" }
separator               = "  "
separator_style         = { fg = "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}" }

[filetype]
rules = [
  # Images
  { mime = "**/image/*", fg = "{{vsc.accentYellow}}" },

  # Media
  { mime = "**/{audio,video}/*", fg = "{{vsc.accentPurple}}" },

  # Archives
  { mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{vsc.accentRed}}" },

  # Documents
  { mime = "**/application/{pdf,doc,rtf}", fg = "{{vsc.accentAqua}}" },

  # Empty files
  # { mime = "inode/empty", fg = "{{vsc.accentRed}}" },

  # Special files
  { url = "*", is = "orphan", bg = "{{vsc.accentRed}}" },
  { url = "*", is = "exec"  , fg = "{{vsc.accentGreen}}" },

  # Dummy files
  { url = "*", is = "dummy", bg = "{{vsc.accentRed}}" },
  { url = "*/", is = "dummy", bg = "{{vsc.accentRed}}" },

  # Fallback
  # { url = "*", fg = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}" },
  { url = "*/", fg = "{{vsc.accentBlue}}" }
]

