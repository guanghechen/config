#:schema https://yazi-rs.github.io/schemas/theme.json

# {{name}}

[app]
overall                 = { fg = "{{unified.fg1}}", bg = "reset" }

[cmp]
border                  = { fg = "{{unified.purple}}" }
active                  = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}", bold = true }
inactive                = { fg = "{{unified.fg2}}" }

# Icons
icon_file               = ""
icon_folder             = ""
icon_command            = ""

[confirm]
border                  = { fg = "{{unified.bg4}}" }
title                   = { fg = "{{unified.red}}", bold = true }
body                    = { fg = "{{unified.fg1}}" }
list                    = { fg = "{{unified.fg1}}" }
btn_yes                 = { fg = "{{catppuccin.base}}", bg = "{{unified.green}}", bold = true }
btn_no                  = { fg = "{{unified.fg1}}", bg = "{{unified.bg2}}", bold = true }
btn_labels              = [ "  [Y]es  ", "  (N)o  " ]

[help]
border                  = { fg = "{{unified.bg4}}" }
chord                   = { fg = "{{unified.blue}}" }
action                  = { fg = "{{unified.fg1}}" }
hovered                 = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}", bold = true }

[input]
border                  = { fg = "{{unified.purple}}" }
title                   = { bold = true }
value                   = { fg = "{{unified.fg1}}" }
selected                = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}" }

[mgr]
cwd                     = { fg = "{{unified.blue}}" }
border_symbol           = "│"
border_style            = { fg = "{{unified.bg4}}" }
count_copied            = { fg = "{{catppuccin.base}}", bg = "{{unified.green}}" }
count_cut               = { fg = "{{catppuccin.base}}", bg = "{{unified.red}}" }
count_selected          = { fg = "{{catppuccin.base}}", bg = "{{unified.purple}}" }
find_keyword            = { fg = "{{unified.yellow}}",  bold = true, italic = true }
find_position           = { fg = "{{unified.purple}}",  bg = "reset", bold = true, italic = true }
marker_copied           = { fg = "{{unified.green}}",   bg = "{{unified.green}}" }
marker_cut              = { fg = "{{unified.red}}",     bg = "{{unified.red}}" }
marker_marked           = { fg = "{{unified.blue}}", bg = "{{unified.blue}}" }
marker_selected         = { fg = "{{unified.purple}}", bg = "{{unified.purple}}" }
symlink_target          = { italic = true }
syntect_theme           = "~/.config/bat/themes/{{name}}.tmTheme"

[indicator]
parent                  = { fg = "{{unified.fg2}}", bg = "{{catppuccin.mantle}}" }
current                 = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}", bold = true }
preview                 = { fg = "{{unified.blue}}", underline = true }

[mode]
normal_main             = { fg = "{{catppuccin.base}}", bg = "{{unified.blue}}", bold = true }
normal_alt              = { fg = "{{unified.fg1}}", bg = "{{unified.bg2}}", bold = true }
select_main             = { fg = "{{catppuccin.base}}", bg = "{{unified.purple}}", bold = true }
select_alt              = { fg = "{{unified.fg1}}", bg = "{{unified.bg2}}", bold = true }
unset_main              = { fg = "{{catppuccin.base}}", bg = "{{unified.orange}}", bold = true }
unset_alt               = { fg = "{{unified.fg1}}", bg = "{{unified.bg2}}", bold = true }

[notify]
title_info              = { fg = "{{unified.green}}" }
title_warn              = { fg = "{{unified.yellow}}" }
title_error             = { fg = "{{unified.red}}" }
icon_info               = ""
icon_warn               = ""
icon_error              = ""

[pick]
border                  = { fg = "{{unified.purple}}" }
active                  = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}", bold = true }
inactive                = { fg = "{{unified.fg2}}" }

[spot]
border                  = { fg = "{{unified.bg4}}" }
title                   = { fg = "{{unified.blue}}", bold = true }
tbl_col                 = { fg = "{{unified.blue}}" }
tbl_cell                = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}", bold = true }

[status]
overall                 = { fg = "{{unified.fg2}}", bg = "reset" }
perm_exec               = { fg = "{{unified.green}}", bold = true }
perm_read               = { fg = "{{unified.blue}}", bold = true }
perm_sep                = { fg = "{{unified.fg2}}", bold = true }
perm_write              = { fg = "{{unified.yellow}}", bold = true }
perm_type               = { fg = "{{unified.purple}}", bold = true }
progress_error          = { fg = "{{unified.red}}", bg = "{{catppuccin.mantle}}" }
progress_label          = { fg = "{{unified.fg1}}", bold = true }
progress_normal         = { fg = "{{unified.green}}", bg = "{{catppuccin.mantle}}" }
sep_left                = { open = "",         close = "" }
sep_right               = { open = "",         close = "" }

[tabs]
active                  = { fg = "{{catppuccin.base}}", bg = "{{unified.purple}}", bold = true }
inactive                = { fg = "{{unified.fg2}}", bg = "{{catppuccin.mantle}}" }
sep_inner               = { open = "",         close = "" }
sep_outer               = { open = "",         close = "" }

[tasks]
border                  = { fg = "{{unified.purple}}" }
title                   = { bold = true }
hovered                 = { fg = "{{unified.fg1}}", bg = "{{unified.bg3}}", bold = true }

[which]
border                  = { fg = "{{unified.bg4}}" }
cols                    = 3
mask                    = { bg = "{{catppuccin.mantle}}" }
cand                    = { fg = "{{unified.blue}}" }
rest                    = { fg = "{{unified.fg2}}" }
desc                    = { fg = "{{unified.fg1}}" }
separator               = "  "
separator_style         = { fg = "{{unified.fg2}}" }

[filetype]
rules = [
  # Images
  { mime = "**/image/*", fg = "{{unified.pink}}" },

  # Media
  { mime = "**/{audio,video}/*", fg = "{{unified.orange}}" },

  # Archives
  { mime = "**/application/{zip,rar,7z*,tar,gzip,xz,zstd,bzip*,lzma,compress,archive,cpio,arj,xar,ms-cab*}", fg = "{{unified.red}}" },

  # Documents
  { mime = "**/application/{pdf,doc,rtf}", fg = "{{unified.aqua}}" },

  # Empty files
  # { mime = "inode/empty", fg = "{{unified.red}}" },

  # Special files
  { url = "*", is = "orphan", fg = "{{catppuccin.base}}", bg = "{{unified.red}}" },
  { url = "*", is = "exec"  , fg = "{{unified.green}}" },

  # Dummy files
  { url = "*", is = "dummy", fg = "{{catppuccin.base}}", bg = "{{unified.red}}" },
  { url = "*/", is = "dummy", fg = "{{catppuccin.base}}", bg = "{{unified.red}}" },

  # Fallback
  { url = "*/", fg = "{{unified.blue}}" },
  { url = "*", fg = "{{unified.fg1}}" }
]

[icon]

prepend_globs = [
  { url = "*.{spec,test}.{js,cjs,mjs}",      text = "󰙨", fg = "{{catppuccin.yellow}}" },
  { url = "*.{spec,test}.{ts,cts,mts,tsx}",  text = "󰙨", fg = "{{catppuccin.blue}}" },
