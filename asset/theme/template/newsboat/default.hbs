# {{name}}

# =============================================================================
# Newsboat Color Theme (Catppuccin Style)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color{{c256(unified.fg1)}}        default
color listnormal_unread   color{{c256(unified.brightGreen)}}      default
color listfocus           color{{c256(unified.fg0)}}        color{{c256(darken ? unified.bg2 : unified.bg4)}}
color listfocus_unread    color{{c256(unified.brightGreen)}}      color{{c256(darken ? unified.bg2 : unified.bg4)}}

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color{{c256(unified.brightGreen)}}       default
color info                color{{c256(unified.brightBlue)}}       default
color hint-key            color{{c256(unified.pink)}}       default          bold
color hint-keys-delimiter color{{c256(unified.fg3)}}        default
color hint-separator      default                           default
color hint-description    default                           default

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color{{c256(unified.fg4)}}        default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color{{c256(unified.brightBlue)}}       default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color{{c256(unified.aqua)}}       default bold

# URLs
highlight article "https?://[^ ]+"                     color{{c256(unified.brightBlue)}}       default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color{{c256(unified.aqua)}}       default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color{{c256(unified.fg4)}}        default
