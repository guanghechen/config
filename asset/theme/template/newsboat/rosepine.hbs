# {{name}}

# =============================================================================
# Newsboat Color Theme (Rosé Pine)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color{{c256(unified.fg2)}}      default
color listnormal_unread   color{{c256(unified.fg1)}}        default                           bold
color listfocus           color{{c256(unified.fg1)}}        color{{c256(rosepine.highlightMed)}}
color listfocus_unread    color{{c256(unified.fg1)}}         color{{c256(rosepine.highlightMed)}} bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color{{c256(unified.aqua)}}        color{{c256(rosepine.surface)}}     bold
color info                color{{c256(unified.blue)}}        color{{c256(rosepine.surface)}}
color hint-key            color{{c256(unified.purple)}}        color{{c256(rosepine.surface)}}     bold
color hint-keys-delimiter color{{c256(unified.fg2)}}       color{{c256(rosepine.surface)}}
color hint-separator      default                             color{{c256(rosepine.surface)}}
color hint-description    default                             color{{c256(rosepine.surface)}}

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color{{c256(unified.fg2)}}       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color{{c256(unified.blue)}}        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color{{c256(unified.aqua)}}        default bold

# URLs
highlight article "https?://[^ ]+"                     color{{c256(unified.blue)}}        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color{{c256(unified.aqua)}}        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color{{c256(unified.fg2)}}       default
