# {{name}}

# =============================================================================
# Newsboat Color Theme (Catppuccin)
# =============================================================================

# -----------------------------------------------------------------------------
# Main Interface Elements
# -----------------------------------------------------------------------------
color background          default        default
color article             default        default

# -----------------------------------------------------------------------------
# List Colors
# -----------------------------------------------------------------------------
color listnormal          color{{c256(unified.fg2)}}      default
# Preserve Latte's ink foreground; dark flavors need bright text after ANSI 256 quantization.
color listnormal_unread   {{darken ? 'color' + c256(unified.fg1) : 'default'}} default bold
color listfocus           {{darken ? 'color' + c256(unified.fg1) : 'default'}} color{{c256(unified.bg3)}}
color listfocus_unread    {{darken ? 'color' + c256(unified.fg1) : 'default'}} color{{c256(unified.bg3)}} bold

# -----------------------------------------------------------------------------
# Title & Info Bar
# -----------------------------------------------------------------------------
color title               color{{c256(unified.purple)}}        color{{c256(catppuccin.mantle)}}     bold
color info                color{{c256(unified.blue)}}        color{{c256(catppuccin.mantle)}}
color hint-key            color{{c256(unified.purple)}}        color{{c256(catppuccin.mantle)}}     bold
color hint-keys-delimiter color{{c256(unified.fg2)}}       color{{c256(catppuccin.mantle)}}
color hint-separator      default                             color{{c256(catppuccin.mantle)}}
color hint-description    default                             color{{c256(catppuccin.mantle)}}

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
color end-of-text-marker  color{{c256(unified.fg2)}}       default

# -----------------------------------------------------------------------------
# Article Content Highlights
# -----------------------------------------------------------------------------
# Metadata lines (Feed, Title, Author, Link, Date)
highlight article "^(Feed|Title|Author|Link|Date): .+" color{{c256(unified.blue)}}        default bold
highlight article "^(Feed|Title|Author|Link|Date):"    color{{c256(unified.purple)}}        default bold

# URLs
highlight article "https?://[^ ]+"                     color{{c256(unified.blue)}}        default

# Reference numbers [1], [2], etc.
highlight article "\\[[0-9]+\\]"                       color{{c256(unified.purple)}}        default bold

# Media indicators
highlight article "\\((link|image|video)\\)"           color{{c256(unified.fg2)}}       default
