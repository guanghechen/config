schema_version = "1"
name = "{{name}}"
mode = "{{darken ? 'dark' : 'light'}}"

[palette]
bg0 = "{{vsc.editor_background}}"
bg1 = "{{vsc.overlay}}"
bg2 = "{{(darken ? vsc.subtle : vsc.list_activeSelectionBackground)}}"
bg3 = "{{(darken ? vsc.checkbox_border : vsc.editorIndentGuide_background1)}}"
bg4 = "{{(darken ? vsc.menu_border : vsc.badge_background)}}"

fg0 = "{{vsc.inputOption_activeForeground}}"
fg1 = "{{vsc.foreground}}"
fg2 = "{{(darken ? vsc.textMuted : vsc.activityBar_inactiveForeground)}}"
fg3 = "{{(darken ? vsc.activityBar_inactiveForeground : vsc.input_placeholderForeground)}}"
fg4 = "{{(darken ? vsc.editorLineNumber_foreground : vsc.pickerGroup_foreground)}}"

red = "{{vsc.accentRed}}"
green = "{{vsc.accentGreen}}"
yellow = "{{vsc.accentYellow}}"
blue = "{{vsc.accentBlue}}"
purple = "{{vsc.accentPurple}}"
aqua = "{{vsc.accentAqua}}"
orange = "{{vsc.accentOrange}}"

brightRed = "{{vsc.brightRed}}"
brightGreen = "{{vsc.brightGreen}}"
brightYellow = "{{vsc.brightYellow}}"
brightBlue = "{{vsc.brightBlue}}"
brightPurple = "{{vsc.brightPurple}}"
brightAqua = "{{vsc.brightAqua}}"
brightOrange = "{{vsc.brightOrange}}"

black = "{{vsc.borderStrong}}"
white = "{{vsc.editor_background}}"
grey = "{{vsc.editorIndentGuide_activeBackground1}}"
pink = "{{vsc.accentPink}}"

diffDel = "{{vsc.diffDel}}"
diffDelInline = "{{vsc.diffDelInline}}"
diffAdd = "{{vsc.diffAdd}}"
diffAddInline = "{{vsc.diffAddInline}}"

[tokens]
"text.primary" = "fg1"
"text.muted" = "fg2"
"text.dim" = "fg4"
accent = "blue"
"status.success" = "green"
"status.warning" = "yellow"
"status.error" = "red"
divider = "bg3"
"role.user" = "blue"
"role.agent" = "green"
"role.system" = "fg2"
"role.error" = "red"
