schema_version = "1"
name = "{{name}}"
mode = "{{darken ? 'dark' : 'light'}}"

[palette]
bg0 = "{{rosepine.base}}"
bg1 = "{{rosepine.surface}}"
bg2 = "{{rosepine.overlay}}"
bg3 = "{{rosepine.highlightMed}}"
bg4 = "{{rosepine.highlightHigh}}"

fg0 = "{{rosepine.text}}"
fg1 = "{{rosepine.text}}"
fg2 = "{{rosepine.subtle}}"
fg3 = "{{rosepine.muted}}"
fg4 = "{{rosepine.muted}}"

red = "{{rosepine.love}}"
green = "{{rosepine.pine}}"
yellow = "{{rosepine.gold}}"
blue = "{{rosepine.foam}}"
purple = "{{rosepine.iris}}"
aqua = "{{rosepine.rose}}"
orange = "{{rosepine.rose}}"

brightRed = "{{rosepine.love}}"
brightGreen = "{{rosepine.pine}}"
brightYellow = "{{rosepine.gold}}"
brightBlue = "{{rosepine.foam}}"
brightPurple = "{{rosepine.iris}}"
brightAqua = "{{rosepine.rose}}"
brightOrange = "{{rosepine.rose}}"

black = "{{rosepine.overlay}}"
white = "{{rosepine.text}}"
grey = "{{rosepine.muted}}"
pink = "{{rosepine.love}}"

diffDel = "{{unified.diffDel}}"
diffDelInline = "{{unified.diffDelInline}}"
diffAdd = "{{unified.diffAdd}}"
diffAddInline = "{{unified.diffAddInline}}"

[tokens]
"text.primary" = "fg1"
"text.muted" = "fg2"
"text.dim" = "fg4"
accent = "aqua"
"status.success" = "green"
"status.warning" = "yellow"
"status.error" = "red"
divider = "bg2"
"role.user" = "blue"
"role.agent" = "aqua"
"role.system" = "fg2"
"role.error" = "red"
