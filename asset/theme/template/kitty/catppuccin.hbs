# {{name}}

# Primary colors
background              {{catppuccin.base}}
foreground              {{unified.fg1}}
selection_background    {{unified.bg3}}
selection_foreground    {{unified.fg1}}

# Cursor colors
cursor                  {{unified.purple}}
cursor_text_color       {{catppuccin.base}}

# URL underline color when hovering with mouse
url_color               {{unified.blue}}

# Border colors
active_border_color     {{unified.purple}}
inactive_border_color   {{unified.bg4}}
bell_border_color       {{unified.yellow}}

# Tab bar colors
active_tab_foreground   {{catppuccin.base}}
active_tab_background   {{unified.purple}}
inactive_tab_foreground {{unified.fg2}}
inactive_tab_background {{catppuccin.mantle}}
tab_bar_background      {{catppuccin.crust}}

# Colors for marks (marked text in the terminal)
mark1_foreground        {{catppuccin.base}}
mark1_background        {{unified.blue}}
mark2_foreground        {{catppuccin.base}}
mark2_background        {{unified.yellow}}
mark3_foreground        {{catppuccin.base}}
mark3_background        {{unified.purple}}

# Official ANSI colors
color0                  {{darken ? catppuccin.surface1 : catppuccin.subtext1}}
color1                  {{catppuccin.red}}
color2                  {{catppuccin.green}}
color3                  {{catppuccin.yellow}}
color4                  {{catppuccin.blue}}
color5                  {{catppuccin.pink}}
color6                  {{catppuccin.teal}}
color7                  {{darken ? catppuccin.subtext0 : catppuccin.surface2}}

# Bright colors
color8                  {{darken ? catppuccin.surface2 : catppuccin.subtext0}}
color9                  {{catppuccin.red}}
color10                 {{catppuccin.green}}
color11                 {{catppuccin.yellow}}
color12                 {{catppuccin.blue}}
color13                 {{catppuccin.pink}}
color14                 {{catppuccin.teal}}
color15                 {{darken ? catppuccin.subtext1 : catppuccin.surface1}}
