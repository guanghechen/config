# {{name}}

# Main bg
theme[main_bg]="{{unified.bg0}}"

# Main text color
theme[main_fg]="{{catppuccin?.text || unified.fg1}}"

# Title color for boxes
theme[title]="{{catppuccin?.text || unified.fg1}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{unified.blue}}"

# Background color of selected item in processes box
theme[selected_bg]="{{catppuccin?.surface0 || unified.bg2}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{catppuccin?.text || unified.fg0}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{catppuccin?.overlay0 || unified.fg4}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{unified.blue}}"

# Color of text in graphs
theme[graph_text]="{{catppuccin?.subtext0 || unified.fg3}}"

# Background color of meters
theme[meter_bg]="{{catppuccin?.surface0 || unified.bg1}}"

# Cpu box outline color
theme[cpu_box]="{{catppuccin?.surface1 || unified.bg3}}"

# Memory/disks box outline color
theme[mem_box]="{{catppuccin?.surface1 || unified.bg3}}"

# Net up/down box outline color
theme[net_box]="{{catppuccin?.surface1 || unified.bg3}}"

# Processes box outline color
theme[proc_box]="{{catppuccin?.surface1 || unified.bg3}}"

# Box divider line and small boxes line color
theme[div_line]="{{catppuccin?.surface1 || unified.bg3}}"

# Temperature graph colors (green -> yellow -> red)
theme[temp_start]="{{unified.green}}"
theme[temp_mid]="{{unified.yellow}}"
theme[temp_end]="{{unified.red}}"

# CPU graph colors
theme[cpu_start]="{{unified.green}}"
theme[cpu_mid]="{{unified.yellow}}"
theme[cpu_end]="{{unified.red}}"

# Mem/Disk free meter
theme[free_start]="{{unified.green}}"
theme[free_mid]="{{unified.yellow}}"
theme[free_end]="{{unified.red}}"

# Mem/Disk cached meter
theme[cached_start]="{{unified.aqua}}"
theme[cached_mid]="{{unified.blue}}"
theme[cached_end]="{{unified.purple}}"

# Mem/Disk available meter
theme[available_start]="{{unified.green}}"
theme[available_mid]="{{unified.yellow}}"
theme[available_end]="{{unified.orange}}"

# Mem/Disk used meter
theme[used_start]="{{unified.green}}"
theme[used_mid]="{{unified.yellow}}"
theme[used_end]="{{unified.red}}"

# Download graph colors
theme[download_start]="{{unified.green}}"
theme[download_mid]="{{unified.aqua}}"
theme[download_end]="{{unified.blue}}"

# Upload graph colors
theme[upload_start]="{{unified.purple}}"
theme[upload_mid]="{{catppuccin?.pink || unified.pink}}"
theme[upload_end]="{{unified.red}}"

# Process box gradient
theme[process_start]="{{unified.aqua}}"
theme[process_mid]="{{catppuccin?.lavender || unified.blue}}"
theme[process_end]="{{catppuccin?.mauve || unified.purple}}"

# Background color when process is paused (e.g. after pressing 'p')
theme[proc_pause_bg]="{{unified.red}}"
