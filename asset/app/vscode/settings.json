{
  "[cpp]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[dart]": {
    "editor.defaultFormatter": "dart-code.dart-code",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [
      {
        "column": 100,
        "color": "#49454c"
      },
      {
        "column": 120,
        "color": "#ad6c40"
      }
    ],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[latex]": {
    "editor.formatOnPaste": false,
    "editor.suggestSelection": "recentlyUsedByPrefix"
  },
  "[markdown]": {
    "editor.wordWrap": "off",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    },
    "diffEditor.ignoreTrimWhitespace": false
  },
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnType": true,
    "editor.defaultFormatter": "ms-python.autopep8"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[plaintext]": {
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 100,
    "editor.wrappingIndent": "same"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[yaml]": {
    "diffEditor.ignoreTrimWhitespace": true
  },
  "accessibility.signals.terminalBell": {
    "sound": "on"
  },
  "chat.agent.sandbox.enabled": "on",
  "chat.agent.sandbox.enabledWindows": "on",
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.terminal.terminalProfile.linux": {
    "path": "/home/linuxbrew/.linuxbrew/bin/fish"
  },
  "chat.tools.terminal.terminalProfile.osx": {
    "path": "/opt/homebrew/bin/fish"
  },
  "claudeCode.preferredLocation": "panel",
  "cmake.configureOnOpen": true,
  "cSpell.userWords": ["guanghechen", "kyokuya", "sora", "yozora"],
  "dart.hotReloadOnSave": "allIfDirty",
  "debug.console.fontFamily": "Maple Mono NF CN, Consolas, monospace, sans-serif",
  "debug.console.fontSize": 18,
  "debug.javascript.terminalOptions": {
    "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
  },
  "diffEditor.diffAlgorithm": "advanced",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.accessibilitySupport": "off",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.detectIndentation": true,
  "editor.fontFamily": "Maple Mono NF CN, Consolas, monospace, sans-serif",
  "editor.fontSize": 18,
  "editor.formatOnSave": false,
  "editor.guides.bracketPairs": "active",
  "editor.hideCursorInOverviewRuler": true,
  "editor.inlineSuggest.edits.allowCodeShifting": "horizontal",
  "editor.inlineSuggest.edits.showCollapsed": true,
  "editor.inlineSuggest.enabled": true,
  "editor.inlineSuggest.minShowDelay": 100,
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "editor.padding.top": 10,
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "all",
  "editor.rulers": [
    {
      "column": 100,
      "color": "#49454c"
    },
    {
      "column": 120,
      "color": "#ad6c40"
    }
  ],
  "editor.showFoldingControls": "always",
  "editor.smoothScrolling": true,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "on",
  "editor.tabSize": 2,
  "editor.wordSeparators": "/\\()\"':,.;<>~!@#$%^&*|+=[]{}`?-",
  "editor.wordWrap": "off",
  "eslint.format.enable": true,
  "eslint.run": "onSave",
  "eslint.validate": [
    "html",
    "javascript",
    "javascriptreact",
    "markdown",
    "pug",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "explorer.autoReveal": false,
  "explorer.confirmDragAndDrop": true,
  "explorer.confirmPasteNative": true,
  "explorer.copyRelativePathSeparator": "/",
  "explorer.fileNesting.expand": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.js, ${capture}.js.map, ${capture}.d.ts",
    ".eslintrc": ".eslintignore",
    ".npmrc": ".nvmrc, .yarnrc, .yarnrc.yml",
    ".prettierrc": ".prettierignore",
    "rollup.config.mjs": "rollup.config.*.mjs",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "bun.lock, bun.lockb, npm-shrinkwrap.json, package-lock.json, pnpm-lock.yaml, yarn.lock",
    "pubspec.yaml": "pubspec.lock, .metadata"
  },
  "explorer.incrementalNaming": "smart",
  "explorer.openEditors.sortOrder": "fullPath",
  "explorer.openEditors.visible": 0,
  "extensions.autoUpdate": "on",
  "extensions.autoUpdateDelay": 24,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "files.associations": {
    "*.rs": "rust",
    "*.txt": "plaintext",
    ".prettierrc": "yaml"
  },
  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  "files.exclude": {
    "**/.idea": true,
    "**/*.tsbuildinfo": true
  },
  "files.readonlyFromPermissions": true,
  "files.watcherExclude": {
    "**/.idea": true
  },
  "git.autoRepositoryDetection": false,
  "git.branchProtection": ["main", "master"],
  "git.mergeEditor": false,
  "git.openRepositoryInParentFolders": "never",
  "git.showPushSuccessNotification": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "gitlens.ai.model": "vscode",
  "gitlens.defaultDateFormat": "YYYY-MM-DD HH:mm:ss",
  "gitlens.defaultDateShortFormat": "YYYY-MM-DD",
  "gitlens.defaultDateStyle": "absolute",
  "gitlens.gitCommands.skipConfirmations": [
    "fetch:command",
    "stash-push:command"
  ],
  "gitlens.keymap": "none",
  "html.format.indentInnerHtml": true,
  "js/ts.implementationsCodeLens.enabled": true,
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.tsc.autoDetect": "off",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "jupyter.askForKernelRestart": true,
  "latex-workshop.latex.autoBuild.run": "never",
  "markdown.preview.fontFamily": "Maple Mono NF CN, Comic Sans MS, Microsoft YaHei, WenQuanYi Micro Hei, sans-serif",
  "markdown.preview.fontSize": 18,
  "markdown.preview.scrollEditorWithPreview": false,
  "markdown.preview.scrollPreviewWithEditor": false,
  "notebook.lineNumbers": "on",
  "npm.packageManager": "auto",
  "nxConsole.showNodeVersionOnStartup": false,
  "prettier.requireConfig": true,
  "remote.defaultExtensionsIfInstalledLocally": [
    "github.copilot",
    "github.copilot-chat",
    "github.vscode-pull-request-github"
  ],
  "remote.localPortHost": "localhost",
  "remote.restoreForwardedPorts": true,
  "scm.alwaysShowActions": true,
  "scm.alwaysShowRepositories": true,
  "scm.defaultViewMode": "tree",
  "scm.graph.badges": "all",
  "scm.repositories.selectionMode": "single",
  "scm.repositories.sortOrder": "path",
  "search.quickOpen.includeSymbols": true,
  "search.seedOnFocus": true,
  "search.showLineNumbers": true,
  "security.workspace.trust.untrustedFiles": "prompt",
  "settingsSync.ignoredExtensions": ["github.copilot", "github.copilot-chat"],
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.explorerKind": "integrated",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.env.linux": {
    "TERM": "xterm-256color"
  },
  "terminal.integrated.env.osx": {
    "TERM": "xterm-256color"
  },
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.enableImages": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.enableVisualBell": true,
  "terminal.integrated.fontFamily": "Maple Mono NF CN, Consolas, monospace, sans-serif",
  "terminal.integrated.fontSize": 18,
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.rightClickBehavior": "default",
  "terminal.integrated.suggest.quickSuggestions": {
    "commands": "on",
    "arguments": "on",
    "unknown": "off"
  },
  "terminal.integrated.tabs.location": "left",
  "terminal.external.windowsExec": "pwsh.exe",
  "vim.easymotion": true,
  "vim.foldfix": true,
  "vim.history": 500,
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["u"],
      "commands": [
        {
          "command": "undo",
          "args": []
        }
      ]
    },
    {
      "before": ["<C-r>"],
      "commands": [
        {
          "command": "redo",
          "args": []
        }
      ]
    }
  ],
  "vim.sneak": true,
  "vim.surround": true,
  "vim.textwidth": 100,
  "vscode-edge-devtools.webhint": false,
  "vscode-neovim.useWSL": false,
  "vscode-neovim.neovimExecutablePaths.linux": "/home/linuxbrew/.linuxbrew/bin/nvim",
  "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
  "vsicons.dontShowNewVersionMessage": true,
  "vsicons.presets.jsOfficial": true,
  "vsicons.presets.jsonOfficial": true,
  "vsicons.presets.tsOfficial": true,
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "windowed",
  "window.enableMenuBarMnemonics": false,
  "window.restoreWindows": "none",
  "window.title": "${dirty}${activeEditorShort}${separator}${rootPath}${separator}",
  "window.titleBarStyle": "custom",
  "workbench.activityBar.location": "top",
  "workbench.browser.newTabPlacement": "sideGroup",
  "workbench.commandPalette.history": 1024,
  "workbench.enableExperiments": false,
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.excludeDirty": true,
  "workbench.editor.limit.perEditorGroup": true,
  "workbench.editor.limit.value": 20,
  "workbench.editor.navigationScope": "editorGroup",
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.editor.revealIfOpen": true,
  "workbench.editor.splitInGroupLayout": "vertical",
  "workbench.editor.splitSizing": "split",
  "workbench.editor.tabActionCloseVisibility": false,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "workbench.iconTheme": "vscode-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.localHistory.exclude": {
    "**/.env*": true,
    "**/local/env.*": true,
    "**/.ssh/**": true,
    "**/.git-credentials": true,
    "**/*.pem": true,
    "**/*.key": true,
    "**/*.http_request": true,
    "**/*.http_response": true
  },
  "workbench.panel.defaultLocation": "bottom",
  "workbench.settings.openDefaultKeybindings": true,
  "workbench.settings.openDefaultSettings": true,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "workbench.tree.indent": 12,
  "zenMode.hideLineNumbers": false
}
