# ~/.inputrc - Readline configuration for vim users

# Enable vi mode (vim-style editing)
set editing-mode vi

# Show mode indicator in prompt (+ for insert mode, : for command mode)
set show-mode-in-prompt on
set vi-ins-mode-string "\1\e[6 q\2"
set vi-cmd-mode-string "\1\e[2 q\2"

# Completion settings
set completion-ignore-case on
set completion-map-case on
set show-all-if-ambiguous on
set show-all-if-unmodified on
set menu-complete-display-prefix on
set colored-stats on
set visible-stats on
set mark-symlinked-directories on
set colored-completion-prefix on

# History settings
set history-preserve-point on
set revert-all-at-newline on

# Bell settings
set bell-style none

# Key timeout (in milliseconds)
set keyseq-timeout 500

# Expand tilde to full path
set expand-tilde on

# Key bindings for vi insert mode
$if mode=vi

set keymap vi-insert
# Use Ctrl-l to clear screen
Control-l: clear-screen

# Use Ctrl-p and Ctrl-n for history navigation
Control-p: previous-history
Control-n: next-history

# Use Ctrl-a and Ctrl-e for beginning/end of line (common muscle memory)
Control-a: beginning-of-line
Control-e: end-of-line

# Use Ctrl-w to delete word backward
Control-w: backward-kill-word

# Use Ctrl-u to delete to beginning of line
Control-u: backward-kill-line

# Arrow keys for history search
"\e[A": history-search-backward
"\e[B": history-search-forward

set keymap vi-command
# Use v to edit command in $EDITOR
"v": edit-and-execute-command

# Use / and ? for history search
"/": history-search-forward
"?": history-search-backward

# Tab completion in command mode
Tab: menu-complete
"\e[Z": menu-complete-backward

$endif

# Application-specific settings
$if Bash
  Space: magic-space
$endif
